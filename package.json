{
  "name": "greywrought",
  "version": "0.12.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "bun scripts/dev-server.ts",
    "play": "bun run dev",
    "typecheck": "bun ./node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test ./src/game && bun scripts/character-profile-check.ts && bun scripts/input-preferences-check.ts",
    "build": "bun scripts/build-host.ts && bun scripts/build-static.ts && bun scripts/release-budget.ts",
    "preview": "bun scripts/static-server.ts",
    "test:browser-playability": "bun acceptance/browser/playability.ts",
    "test:browser-encounter": "bun acceptance/browser/realtime-combat.ts",
    "test:browser-barter": "bun acceptance/browser/npc-barter.ts",
    "test:browser-characters": "bun acceptance/browser/character-deletion.ts && bun acceptance/browser/class-models.ts",
    "test:production": "bun scripts/production-smoke.ts",
    "build:world": "bun build --compile --target=bun-linux-x64-baseline scripts/world-server.ts --outfile build/server/greywrought-world",
    "test:multiplayer": "bun test src/server/world-service.test.ts && bun acceptance/browser/shared-world.ts"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/three": "^0.185.4",
    "typescript": "^5.9.2"
  }
}
