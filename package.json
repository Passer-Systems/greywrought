{
  "name": "greywrought",
  "version": "0.21.30",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "bun scripts/dev-server.ts",
    "play": "bun run dev",
    "typecheck": "bun ./node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test ./src/game && bun scripts/character-profile-check.ts && bun scripts/input-preferences-check.ts",
    "build": "bun scripts/build-host.ts && bun scripts/build-static.ts && bun scripts/release-budget.ts",
    "preview": "bun scripts/static-server.ts",
    "demo": "GREYWROUGHT_LOCAL_WORLD=1 bun scripts/static-server.ts",
    "test:offline-demo": "bun acceptance/browser/offline-demo.ts",
    "test:aggro-ranges": "bun test src/game/encounter-pressure.test.ts && bun acceptance/browser/aggro-ranges.ts",
    "test:browser-playability": "bun acceptance/browser/playability.ts",
    "test:browser-encounter": "bun acceptance/browser/combat-loop.ts",
    "test:private-encounter": "bun test src/host/network-adventure.test.ts src/game/private-encounter.test.ts src/server/world-service.test.ts && bun acceptance/browser/private-encounter.ts && bun acceptance/browser/rejoin-movement.ts",
    "test:return-to-world": "bun acceptance/browser/return-to-world.ts && bun acceptance/browser/rejoin-movement.ts",
    "test:foreman-recovery": "bun test src/game/private-encounter.test.ts && bun acceptance/browser/foreman-recovery.ts",
    "test:sit": "bun acceptance/browser/sit.ts",
    "test:hearthstone": "bun test src/game/hearthstone.test.ts && bun acceptance/browser/hearthstone.ts",
    "test:emotes": "bun test src/game/emotes.test.ts && bun acceptance/browser/emotes.ts",
    "test:pause-menu": "bun acceptance/browser/pause-menu.ts",
    "test:pwa": "bun acceptance/browser/pwa.ts",
    "test:performance": "bun acceptance/browser/performance.ts",
    "test:day-night": "bun test src/game/world-time.test.ts && bun acceptance/browser/day-night.ts",
    "test:camera": "bun test src/host/terrain-camera.test.ts && bun acceptance/browser/camera-orbit.ts",
    "test:vertical-planner": "bun acceptance/browser/vertical-planner.ts",
    "test:ability-range": "bun test src/host/combat-range.test.ts && bun acceptance/browser/ability-range.ts",
    "test:browser-barter": "bun acceptance/browser/npc-barter.ts",
    "test:browser-characters": "bun acceptance/browser/character-deletion.ts && bun acceptance/browser/class-models.ts",
    "test:production": "bun scripts/production-smoke.ts",
    "build:world": "bun build --compile --target=bun-linux-x64-baseline scripts/world-server.ts --outfile build/server/greywrought-world",
    "test:multiplayer": "bun test src/server/world-service.test.ts && bun acceptance/browser/shared-world.ts",
    "art:warden": "bun scripts/art/author-warden.ts",
    "art:warden:open": "bun scripts/art/open-warden.ts",
    "test:warden": "bun test ./src/host/relic-warden.test.ts && bun acceptance/browser/relic-warden.ts",
    "test:rattagane": "bun test ./src/host/rattagane.test.ts ./src/game/cave.test.ts && bun acceptance/browser/rattagane.ts"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/three": "^0.185.4",
    "typescript": "^5.9.2"
  }
}
