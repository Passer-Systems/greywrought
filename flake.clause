using Nix

greywrought
  shape: Flake
  description: "Greywrought native development environment"
  inputs
    nixpkgs
      from: "github:NixOS/nixpkgs/nixos-unstable"
    rust-overlay
      from: "github:oxalica/rust-overlay"
      follows: nixpkgs
  development shell
    native-shell
      system: x86_64-linux
      imports: nixpkgs
      overlays
        rust-overlay
      includes
        rust
          from: "./vendor/clause/rust-toolchain.toml"
        bun
        pkg-config
        libx11
        libxcursor
        libxi
        libxrandr
        libxkbcommon
        vulkan-loader
