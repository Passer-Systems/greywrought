F64
Bool
Meter

reading:
  ?meter shape Meter
  ?value shape F64
  ?meter:
    reading: ?value

mode reading given meter yields value: one
positive:
  ?meter shape Meter
  ?value shape Bool
  ?meter:
    positive: ?value

mode positive given meter yields value: one

meter
  member of: Meter
meter
  reading: 25.0
  positive: false

on measure ?meter
  when
    ?meter:
      reading: ?value
      positive: ?prior
  withdraw
    ?meter positive ?prior
  include
    ?meter positive (?value > 0.0)
