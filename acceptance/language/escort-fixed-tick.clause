F64
Actor
Encounter
Scenario

Vec3:
  x: F64
  y: F64
  z: F64

actor-position:
  ?actor shape Actor
  ?value shape Vec3
  ?actor:
    actor position: ?value

mode actor-position given actor yields value: one

journey-destination:
  ?actor shape Actor
  ?value shape Vec3
  ?actor:
    journey destination: ?value

mode journey-destination given actor yields value: one

journey-speed:
  ?actor shape Actor
  ?value shape F64
  ?actor:
    journey speed: ?value

mode journey-speed given actor yields value: one

encounter-scenario:
  ?encounter shape Encounter
  ?value shape Scenario
  ?encounter:
    encounter scenario: ?value

mode encounter-scenario given encounter yields value: one

encounter
  member of: Encounter
dawnroad-crossing
  member of: Scenario
ilyra
  member of: Actor

encounter encounter scenario dawnroad-crossing
ilyra actor position Vec3 { x: 0.0, y: 0.0, z: -5.0 }
ilyra journey destination Vec3 { x: 0.0, y: 0.0, z: 27.0 }
ilyra journey speed 1.75

on tick ?actor ?dt
  when
    encounter encounter scenario dawnroad-crossing
    ?actor = ilyra
    ?actor actor position Vec3 { x: ?x, y: ?y, z: ?z }
    ?actor journey destination Vec3 { x: ?destination-x, y: ?destination-y, z: ?destination-z }
    ?actor journey speed ?speed
    ?z < ?destination-z
  withdraw
    ?actor actor position Vec3 { x: ?x, y: ?y, z: ?z }
  include
    ?actor actor position Vec3 { x: ?destination-x, y: ?destination-y, z: ?z + ?speed * ?dt }
