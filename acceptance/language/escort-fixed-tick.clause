F64
Actor
Encounter
Scenario

shape Vec3
  x: F64
  y: F64
  z: F64

relation actor-position
  reads {actor: Actor} actor position {value: Vec3}
  subject actor
  mode given actor yields value: one
relation journey-destination
  reads {actor: Actor} journey destination {value: Vec3}
  subject actor
  mode given actor yields value: one
relation journey-speed
  reads {actor: Actor} journey speed {value: F64}
  subject actor
  mode given actor yields value: one
relation encounter-scenario
  reads {encounter: Encounter} encounter scenario {value: Scenario}
  subject encounter
  mode given encounter yields value: one

encounter
  member of: Encounter
dawnroad-crossing
  member of: Scenario
ilyra
  member of: Actor

encounter encounter scenario dawnroad-crossing
ilyra actor position Vec3 { x: 0.0, y: 0.0, z: -5.0 }
ilyra journey destination Vec3 { x: 0.0, y: 0.0, z: 27.0 }
ilyra journey speed 1.75

on tick ?actor ?dt
  when
    encounter encounter scenario dawnroad-crossing
    ?actor = ilyra
    ?actor actor position Vec3 { x: ?x, y: ?y, z: ?z }
    ?actor journey destination Vec3 { x: ?destination-x, y: ?destination-y, z: ?destination-z }
    ?actor journey speed ?speed
    ?z < ?destination-z
  withdraw
    ?actor actor position Vec3 { x: ?x, y: ?y, z: ?z }
  include
    ?actor actor position Vec3 { x: ?destination-x, y: ?destination-y, z: ?z + ?speed * ?dt }
