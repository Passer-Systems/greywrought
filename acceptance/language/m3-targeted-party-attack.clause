F64
Bool
Controller
Unit
Target
Encounter
EncounterState

Vec3:
  x: F64
  y: F64
  z: F64

selected:
  ?unit shape Unit
  ?value shape Bool
  ?unit:
    selected: ?value

mode selected given unit yields value: one

combat-position:
  ?target shape Target
  ?value shape Vec3
  ?target:
    combat position: ?value

mode combat-position given target yields value: one

vitality:
  ?target shape Target
  ?value shape F64
  ?target:
    vitality: ?value

mode vitality given target yields value: one

hostile:
  ?target shape Target
  ?value shape Bool
  ?target:
    hostile: ?value

mode hostile given target yields value: one

chosen-target:
  ?controller shape Controller
  ?value shape Target
  ?controller:
    chosen target: ?value

mode chosen-target given controller yields value: one

attack-damage:
  ?unit shape Unit
  ?value shape F64
  ?unit:
    attack damage: ?value

mode attack-damage given unit yields value: one

attack-range:
  ?unit shape Unit
  ?value shape F64
  ?unit:
    attack range: ?value

mode attack-range given unit yields value: one

action-cooldown:
  ?unit shape Unit
  ?value shape F64
  ?unit:
    action cooldown: ?value

mode action-cooldown given unit yields value: one

encounter-state:
  ?encounter shape Encounter
  ?value shape EncounterState
  ?encounter:
    encounter state: ?value

mode encounter-state given encounter yields value: one

player
  member of: Controller
first
  member of: Unit
  member of: Target
second
  member of: Unit
  member of: Target
cinder
  member of: Target
encounter
  member of: Encounter

active
  member of: EncounterState

player
  chosen target: first
encounter
  encounter state: active

first
  selected: true
  combat position:
    x: -1.0
    y: 0.0
    z: 0.0
  vitality: 100.0
  hostile: false
  attack damage: 10.0
  attack range: 5.0
  action cooldown: 0.0

second
  selected: true
  combat position:
    x: 1.0
    y: 0.0
    z: 0.0
  vitality: 100.0
  hostile: false
  attack damage: 10.0
  attack range: 5.0
  action cooldown: 0.0

cinder
  combat position:
    x: 0.0
    y: 0.0
    z: 2.0
  vitality: 100.0
  hostile: true

bind referent-input Target as Target to choose-target
bind keyboard Attack down to attack

on choose-target ?controller ?picked
  when
    ?controller chosen target ?prior
    ?picked hostile ?hostile
  withdraw
    ?controller chosen target ?prior
  include
    ?controller chosen target ?picked

on attack ?unit
  when
    encounter encounter state active
    ?unit:
      selected: true
      combat position:
        x: ?unit-x
        y: ?unit-y
        z: ?unit-z
      attack damage: ?damage
      attack range: ?range
      action cooldown: ?cooldown
    player chosen target ?target
    ?target:
      combat position:
        x: ?target-x
        y: ?target-y
        z: ?target-z
      vitality: ?health
      hostile: true
    ?cooldown <= 0.0
    (?target-x - ?unit-x) * (?target-x - ?unit-x) + (?target-z - ?unit-z) * (?target-z - ?unit-z) <= ?range * ?range
  withdraw
    ?unit action cooldown ?cooldown
    ?target vitality ?health
  include
    ?unit action cooldown 1.0
    ?target vitality ?health - ?damage
