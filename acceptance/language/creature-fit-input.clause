F64
Controller
Item

selected
  domain: Controller
  range: Item
  cardinality: one
charge
  domain: Item
  range: F64
  cardinality: one

controller
  selected: first
first
  charge: 0.0

bind referent-input Pick as Item to fit-component

on fit-component ?controller ?target
  when
    ?controller selected ?prior
    ?target charge ?charge
  withdraw
    ?controller selected ?prior
  include
    ?controller selected ?target

on fit-component ?controller ?target
  when
    ?controller selected ?prior
    ?target charge ?charge
  withdraw
    ?target charge ?charge
  include
    ?target charge ?charge + 1.0
