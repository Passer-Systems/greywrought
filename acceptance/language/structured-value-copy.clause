F64
Bool
Item

Point:
  x: F64
  y: F64

position:
  ?item shape Item
  ?value shape Point
  ?item:
    position: ?value

mode position given item yields value: one
destination:
  ?item shape Item
  ?value shape Point
  ?item:
    destination: ?value

mode destination given item yields value: one
moving:
  ?item shape Item
  ?value shape Bool
  ?item:
    moving: ?value

mode moving given item yields value: one

item
  member of: Item
item
  position:
    x: 2.0
    y: 3.0
  destination:
    x: 8.0
    y: 9.0
  moving: true

on stop ?item
  when
    ?item:
      position: ?position
      destination: ?destination
      moving: ?prior
  withdraw
    ?item:
      destination: ?destination
      moving: ?prior
  include
    ?item:
      destination: ?position
      moving: false
