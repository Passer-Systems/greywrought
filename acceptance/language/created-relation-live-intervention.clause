Actor
BurnEffect

relation vitality
  reads {actor: Actor} vitality {value: F64}
  subject actor
  mode given actor yields value: one
relation selected
  reads {actor: Actor} selected {value: Bool}
  subject actor
  mode given actor yields value: one
relation burn-target
  reads {effect: BurnEffect} burn target {value: Actor}
  subject effect
  mode given effect yields value: one
relation effect-remaining
  reads {effect: BurnEffect} effect remaining {value: F64}
  subject effect
  mode given effect yields value: one

unit-a
  shape: Actor
unit-b
  shape: Actor

unit-a vitality 100.0
unit-a selected true
unit-b vitality 100.0
unit-b selected true

bind keyboard Attack down to attack
bind scalar-input IgniteDuration to ignite

on attack ?actor
  when
    ?actor selected true
    ?actor vitality ?health
  accumulate
    ?actor vitality 0.0 - 10.0

on ignite ?actor ?duration
  when
    ?actor selected true
  create
    ?effect
      shape: BurnEffect
  include
    ?effect burn target ?actor
    ?effect effect remaining ?duration
