Actor
BurnEffect

vitality:
  ?actor shape Actor
  ?value shape F64
  ?actor:
    vitality: ?value

mode vitality given actor yields value: one
selected:
  ?actor shape Actor
  ?value shape Bool
  ?actor:
    selected: ?value

mode selected given actor yields value: one
burn-target:
  ?effect shape BurnEffect
  ?value shape Actor
  ?effect:
    burn target: ?value

mode burn-target given effect yields value: one
effect-remaining:
  ?effect shape BurnEffect
  ?value shape F64
  ?effect:
    effect remaining: ?value

mode effect-remaining given effect yields value: one

unit-a
  member of: Actor
unit-b
  member of: Actor

unit-a
  vitality: 100.0
  selected: true
unit-b
  vitality: 100.0
  selected: true

bind keyboard Attack down to attack
bind scalar-input IgniteDuration to ignite

on attack ?actor
  when
    ?actor:
      selected: true
      vitality: ?health
  accumulate
    ?actor vitality 0.0 - 10.0

on ignite ?actor ?duration
  when
    ?actor selected true
  create
    ?effect
      member of: BurnEffect
  include
    ?effect:
      burn target: ?actor
      effect remaining: ?duration
