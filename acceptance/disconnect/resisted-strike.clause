F64
Wayfarer
Enemy
Attack
AttackState
CombatStatus
Loot
Custodian
WorldObjective
RandomSource

Vec3:
  x: F64
  y: F64
  z: F64

pressure:
  ?objective shape WorldObjective
  ?amount shape F64
  ?objective:
    pressure: ?amount

mode pressure given objective yields amount: one

attack-state:
  ?attack shape Attack
  ?state shape AttackState
  ?attack:
    attack state: ?state

mode attack-state given attack yields state: one

attacker:
  ?attack shape Attack
  ?wayfarer shape Wayfarer
  ?attack:
    attacker: ?wayfarer

mode attacker given attack yields wayfarer: one

target:
  ?attack shape Attack
  ?enemy shape Enemy
  ?attack:
    target: ?enemy

mode target given attack yields enemy: one

random-sample:
  ?source shape RandomSource
  ?sample shape Vec3
  ?source:
    random sample: ?sample

mode random-sample given source yields sample: one

vitality:
  ?enemy shape Enemy
  ?amount shape F64
  ?enemy:
    vitality: ?amount

mode vitality given enemy yields amount: one

combat-status:
  ?enemy shape Enemy
  ?status shape CombatStatus
  ?enemy:
    combat status: ?status

mode combat-status given enemy yields status: one

custody:
  ?loot shape Loot
  ?custodian shape Custodian
  ?loot:
    custody: ?custodian

mode custody given loot yields custodian: one

ashen-wayfarer
  member of: Wayfarer
ashen-wayfarer
  member of: Custodian
cinder-wraith
  member of: Enemy
cinder-wraith
  member of: Custodian
ember-strike
  member of: Attack
ashen-key
  member of: Loot
moonwell-restoration
  member of: WorldObjective
combat-random
  member of: RandomSource

moonwell-restoration
  pressure: 0.0
ember-strike
  attack state: eligible
  attacker: ashen-wayfarer
  target: cinder-wraith
combat-random
  random sample:
    x: 0.0
    y: 0.0
    z: 0.0
cinder-wraith
  vitality: 4.0
  combat status: alive
ashen-key
  custody: cinder-wraith

on world-shift ?objective
  when
    ?objective pressure ?prior
  withdraw
    ?objective pressure ?prior
  include
    ?objective pressure ?prior + 1.0

on begin-attack ?attack
  when
    ?attack attack state ?state
    ?state = eligible
  withdraw
    ?attack attack state ?state
  include
    ?attack attack state resolved

on input ?source Vec3 { x: ?roll, y: 0.0, z: ?attack-signal }
  when
    ?source random sample ?prior
  withdraw
    ?source random sample ?prior
  include
    ?source random sample Vec3 { x: ?roll, y: 0.0, z: ?attack-signal }

on apply-damage ?enemy
  when
    ?enemy vitality ?prior
    combat-random:
      random sample:
        x: ?roll
        y: ?unused-y
        z: ?attack-signal
    ?roll = 0.90
    ?attack-signal = 1.0
  withdraw
    ?enemy vitality ?prior
  include
    ?enemy vitality ?prior - 4.0

on resolve-death ?enemy
  when
    ?enemy combat status ?status
    combat-random:
      random sample:
        x: ?roll
        y: ?unused-y
        z: ?attack-signal
    ?status = alive
    ?roll = 0.90
    ?attack-signal = 1.0
  withdraw
    ?enemy combat status ?status
  include
    ?enemy combat status dead

on transfer-loot ?loot
  when
    ?loot custody ?custodian
    combat-random:
      random sample:
        x: ?roll
        y: ?unused-y
        z: ?attack-signal
    ?custodian = cinder-wraith
    ?roll = 0.90
    ?attack-signal = 1.0
  withdraw
    ?loot custody ?custodian
  include
    ?loot custody ashen-wayfarer
