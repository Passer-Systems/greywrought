F64
Wayfarer
Enemy
Attack
AttackState
CombatStatus
Loot
Custodian
WorldObjective
RandomSource

shape Vec3
  x: F64
  y: F64
  z: F64

relation pressure
  reads {objective: WorldObjective} pressure {amount: F64}
  subject objective
  mode given objective yields amount: one

relation attack-state
  reads {attack: Attack} attack state {state: AttackState}
  subject attack
  mode given attack yields state: one

relation attacker
  reads {attack: Attack} attacker {wayfarer: Wayfarer}
  subject attack
  mode given attack yields wayfarer: one

relation target
  reads {attack: Attack} target {enemy: Enemy}
  subject attack
  mode given attack yields enemy: one

relation random-sample
  reads {source: RandomSource} random sample {sample: Vec3}
  subject source
  mode given source yields sample: one

relation vitality
  reads {enemy: Enemy} vitality {amount: F64}
  subject enemy
  mode given enemy yields amount: one

relation combat-status
  reads {enemy: Enemy} combat status {status: CombatStatus}
  subject enemy
  mode given enemy yields status: one

relation custody
  reads {loot: Loot} custody {custodian: Custodian}
  subject loot
  mode given loot yields custodian: one

ashen-wayfarer ∈ Wayfarer
ashen-wayfarer ∈ Custodian
cinder-wraith ∈ Enemy
cinder-wraith ∈ Custodian
ember-strike ∈ Attack
ashen-key ∈ Loot
moonwell-restoration ∈ WorldObjective
combat-random ∈ RandomSource

moonwell-restoration pressure 0.0
ember-strike attack state eligible
ember-strike attacker ashen-wayfarer
ember-strike target cinder-wraith
combat-random random sample Vec3 { x: 0.0, y: 0.0, z: 0.0 }
cinder-wraith vitality 4.0
cinder-wraith combat status alive
ashen-key custody cinder-wraith

on world-shift ?objective
  when
    ?objective pressure ?prior
  withdraw
    ?objective pressure ?prior
  include
    ?objective pressure ?prior + 1.0

on begin-attack ?attack
  when
    ?attack attack state ?state
    ?state = eligible
  withdraw
    ?attack attack state ?state
  include
    ?attack attack state resolved

on input ?source Vec3 { x: ?roll, y: 0.0, z: ?attack-signal }
  when
    ?source random sample ?prior
  withdraw
    ?source random sample ?prior
  include
    ?source random sample Vec3 { x: ?roll, y: 0.0, z: ?attack-signal }

on apply-damage ?enemy
  when
    ?enemy vitality ?prior
    combat-random random sample Vec3 { x: ?roll, y: ?unused-y, z: ?attack-signal }
    ?roll = 0.90
    ?attack-signal = 1.0
  withdraw
    ?enemy vitality ?prior
  include
    ?enemy vitality ?prior - 4.0

on resolve-death ?enemy
  when
    ?enemy combat status ?status
    combat-random random sample Vec3 { x: ?roll, y: ?unused-y, z: ?attack-signal }
    ?status = alive
    ?roll = 0.90
    ?attack-signal = 1.0
  withdraw
    ?enemy combat status ?status
  include
    ?enemy combat status dead

on transfer-loot ?loot
  when
    ?loot custody ?custodian
    combat-random random sample Vec3 { x: ?roll, y: ?unused-y, z: ?attack-signal }
    ?custodian = cinder-wraith
    ?roll = 0.90
    ?attack-signal = 1.0
  withdraw
    ?loot custody ?custodian
  include
    ?loot custody ashen-wayfarer
