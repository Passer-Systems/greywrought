#lang beagle/js

(ns greywrought-clause.wasm-ongoing-effect
  (:require [jump-arena-shell.wasm-cartridge-port :as wasm]
            [jump-arena-shell.workbench :as workbench]))

(require
 '["#clause-runtime-wasm"
   :refer [clause_session_v1_command
           clause_session_v1_event_byte
           clause_session_v1_event_len
           clause_session_v1_io_reset
           clause_session_v1_open
           clause_session_v1_request_push
           initSync
           InitOutput
           SyncInitInput]])

(declare-extern [Bun console] Any)

(defn policy [] workbench/WorkbenchPolicy
  (let [maximum Int (.-MAX_SAFE_INTEGER Number)]
    (workbench/->WorkbenchPolicy
     8 8 32 128 512
     (workbench/->WorkbenchSequenceLimits
      maximum maximum maximum maximum maximum))))

(defn initialize-real-session-module [module ArrayBuffer] Any
  (let [input SyncInitInput module
        _initialized InitOutput (initSync input)]
    (.freeze
     Object
     {:clause_session_v1_io_reset
      (fn [] Nil (clause_session_v1_io_reset))
      :clause_session_v1_request_push
      (fn [byte Int] Float (clause_session_v1_request_push byte))
      :clause_session_v1_open
      (fn [] Float (clause_session_v1_open))
      :clause_session_v1_command
      (fn [] Float (clause_session_v1_command))
      :clause_session_v1_event_len
      (fn [] Float (clause_session_v1_event_len))
      :clause_session_v1_event_byte
      (fn [index Int] Float (clause_session_v1_event_byte index))})))

(defn identity-string [value Any] String
  (.stringify JSON value))

(defn require-effect!
  [condition Bool
   message String] Any
  (when-not condition
    (throw (new Error message))))

(.then
 (.all Promise [(.arrayBuffer
                 (.file Bun "./build/host/wasm/clause_runtime_bg.wasm"))
                (.text
                 (.file Bun
                        "./build/ongoing-effect/ongoing-effect-v1.cwr1.hex"))])
 (fn [assets Any] Any
   (let [module Any (initialize-real-session-module (nth assets 0))
         port workbench/CartridgePort (wasm/create-wasm-cartridge-port
                                      module
                                      (policy))
         request wasm/ExactProcessRequest (wasm/->ExactProcessRequest
          (wasm/decode-cwr1-hex (nth assets 1)))
         accepted Any (atom nil)
         started Any (atom nil)]
     ((.-acceptPackage port) request
      (fn [result Any] Any (reset! accepted result)))
     ((.-startSession port) (.-acceptedPackage @accepted) 1
      (fn [result Any] Any (reset! started result)))
     (let [session Any (.-session @started)
           first Any (wasm/advance-session-occurrence! module session 0)
           suspension Any (wasm/suspend-session! module session)
           resumption Any (wasm/resume-session! module session)
           second Any (wasm/advance-session-occurrence! module session 1)
           intent Any (wasm/emit-effect-intent! module session)
           issued Any (wasm/issue-effect-authorization!
                       module session (.-intentId intent))
           attempt Any (wasm/begin-effect-attempt!
                        module session (.-authorizationId issued))
           target String "./build/ongoing-effect/wasm-receipt.bin"
           payload Any (new Uint8Array (.-payloadBytes attempt))
           state-count String (str (.-stateRevisionCount intent))]
       (require-effect! (= (str (.-kind first)) "input")
                        "first moonwell advance did not reach Wasm")
       (require-effect! (= (str (.-kind second)) "input")
                        "second moonwell advance did not reach Wasm")
       (require-effect! (= (identity-string (.-activation suspension))
                           (identity-string (.-activation resumption)))
                        "suspension and resumption changed Activation")
       (require-effect! (= (identity-string (.-activation intent))
                           (identity-string (.-activation suspension)))
                        "effect intent escaped its ongoing Activation")
       (require-effect! (= (identity-string (.-continuation suspension))
                           (identity-string (.-continuation resumption)))
                        "resumption took up a different Continuation")
       (require-effect! (not= (identity-string (.-step suspension))
                              (identity-string (.-step resumption)))
                        "physical polling collapsed semantic Steps")
       (require-effect! (= (identity-string (.-intentId attempt))
                           (identity-string (.-intentId intent)))
                        "attempt changed the exact effect intent")
       (require-effect! (= (identity-string (.-authorizationId attempt))
                           (identity-string (.-authorizationId issued)))
                        "attempt lost its scoped authorization")
       (require-effect! (= (identity-string (.-actionBytes attempt))
                           (identity-string (.-actionBytes intent)))
                        "attempt changed the Clause-owned action")
       (require-effect! (= (identity-string (.-resourceBytes attempt))
                           (identity-string (.-resourceBytes intent)))
                        "attempt changed the Clause-owned resource")
       (require-effect! (= (identity-string (.-payloadBytes attempt))
                           (identity-string (.-payloadBytes intent)))
                        "attempt changed the Clause-owned payload")
       (.then
        (.write Bun target payload)
        (fn [written Any] Any
          (do
            (require-effect! (= written (.-length payload))
                             "Bun did not materialize every exact payload byte")
            (.then
             (.arrayBuffer (.file Bun target))
             (fn [receipt-buffer Any] Any
               (let [receipt Any (.from Array (new Uint8Array receipt-buffer))
                     settled Any (wasm/settle-effect-attempt!
                                  module session (.-attemptId attempt) 0 receipt)]
                 (require-effect! (= (identity-string receipt)
                                     (identity-string (.-payloadBytes attempt)))
                                  "durable host receipt changed the exact payload")
                 (require-effect! (= (str (.-disposition settled))
                                     "receipt-observed")
                                  "effect receipt was not judged as observed")
                 (require-effect! (not (nil? (.-receiptId settled)))
                                  "effect settlement retained no receipt")
                 (require-effect! (not (nil? (.-observationId settled)))
                                  "effect settlement retained no Observation")
                 (require-effect! (not (nil? (.-judgmentId settled)))
                                  "effect settlement retained no Judgment")
                 (require-effect! (= (str (.-stateRevisionCount settled))
                                     state-count)
                                  "effect evidence created an authoritative StateRevision")
                 ((.-disposeSession port) session)
                 (.log console
                       (str "wasm moonwell effect intent="
                            (identity-string (.-intentId intent))
                            " receipt="
                            (identity-string (.-receiptId settled))
                            " state-revisions=" state-count))
                 nil))))))))))
