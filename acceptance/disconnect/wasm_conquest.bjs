#lang beagle/js

(ns greywrought-clause.wasm-conquest
  (:require [greywrought-clause.presentation :as presentation]
            [jump-arena-shell.branch-wasm-port :as branch]
            [jump-arena-shell.wasm-cartridge-port :as wire]))

(require
 '["#clause-runtime-wasm"
   :refer [clause_branch_v1_command
           clause_branch_v1_event_byte
           clause_branch_v1_event_len
           clause_branch_v1_io_reset
           clause_branch_v1_open
           clause_branch_v1_request_push
           initSync
           InitOutput
           SyncInitInput]])

(declare-extern [Bun console] Any)

(defn initialize-real-branch-module [module ArrayBuffer] Any
  (let [input SyncInitInput module
        _initialized InitOutput (initSync input)]
    (.freeze
     Object
     {:clause_branch_v1_io_reset
      (fn [] Nil (clause_branch_v1_io_reset))
      :clause_branch_v1_request_push
      (fn [byte Int] Float (clause_branch_v1_request_push byte))
      :clause_branch_v1_open
      (fn [] Float (clause_branch_v1_open))
      :clause_branch_v1_command
      (fn [] Float (clause_branch_v1_command))
      :clause_branch_v1_event_len
      (fn [] Float (clause_branch_v1_event_len))
      :clause_branch_v1_event_byte
      (fn [index Int] Float (clause_branch_v1_event_byte index))})))

(defn identity-string [value Any] String
  (.stringify JSON value))

(defn require-conquest!
  [condition Bool
   message String] Any
  (when-not condition
    (throw (new Error message))))

(.then
 (.all Promise [(.arrayBuffer
                 (.file Bun "./build/host/wasm/clause_runtime_bg.wasm"))
                (.text (.file Bun "./build/conquest/conquest-v1.cwr1.hex"))
                (.text (.file Bun "./build/conquest/world-shift.coi1.hex"))
                (.text (.file Bun "./build/conquest/reconcile.coi1.hex"))])
 (fn [assets Any] Any
   (let [module Any (initialize-real-branch-module (nth assets 0))
         request wire/ExactProcessRequest (wire/->ExactProcessRequest (wire/decode-cwr1-hex (nth assets 1)))
         world-shift Any (wire/decode-cwr1-hex (nth assets 2))
         reconcile Any (wire/decode-cwr1-hex (nth assets 3))
         process-branch branch/WasmProcessBranch (branch/open-process-branch! module request 41 world-shift 8)
         opened Any (.-opened process-branch)
         pins Any (.-pins opened)
         parent Any (.-parentState pins)
         branch-run Any (.-run (.-ancestry opened))
         authoritative Any (branch/admit-authoritative-occurrences!
          module process-branch [world-shift])
         r1 Any (.-successor authoritative)
         proposal Any (branch/propose-branch-reconnect! module process-branch [reconcile])
         evidence Any (.-evidence proposal)
         admitted Any (branch/adjudicate-branch-reconnect!
          module process-branch proposal r1 [reconcile])
         explanation Any (.-explanation admitted)
         queried Any (.-explanation (branch/explain-process-branch! module process-branch))
         rendered String (presentation/render-branch-explanation
          (presentation/->BranchExplanationView
           (identity-string parent)
           (identity-string (.-programRevision pins))
           (identity-string (.-rootPolicy pins))
           (identity-string (.-activation (.-ancestry opened)))
           (identity-string (.-candidate evidence))
           "admitted"
           (identity-string (.-successor admitted))))]
     (require-conquest! (= (.-disconnectTick pins) 41)
                        "Wasm branch lost its disconnect tick")
     (require-conquest! (= (identity-string (.-predecessor authoritative))
                           (identity-string parent))
                        "authoritative advance did not start at R0")
     (require-conquest! (not= (identity-string r1) (identity-string parent))
                        "authoritative Admission did not establish R1")
     (require-conquest! (not= (identity-string (.-run authoritative))
                              (identity-string branch-run))
                        "serialized host order manufactured one shared Run")
     (require-conquest! (= (identity-string (.-parentState (.-pins evidence)))
                           (identity-string parent))
                        "reconnect evidence lost its exact parent")
     (require-conquest! (= (identity-string (.-run (.-ancestry evidence)))
                           (identity-string branch-run))
                        "reconnect evidence lost branch ancestry")
     (require-conquest! (> (.-length (.-observations evidence)) 0)
                        "branch proposal retained no Observation")
     (require-conquest! (= (identity-string (.-predecessor admitted))
                           (identity-string r1))
                        "reconnect Admission did not replay against R1")
     (require-conquest! (not= (identity-string (.-successor admitted))
                              (identity-string r1))
                        "Admission did not establish the successor")
     (require-conquest! (= (identity-string (.-branchCandidate admitted))
                           (identity-string (.-candidate evidence)))
                        "Admission lost the retained branch CandidateDelta")
     (require-conquest! (= (identity-string queried)
                           (identity-string explanation))
                        "retained causal explanation changed when queried")
     (require-conquest! (> (.-length (.-causalRecords explanation)) 0)
                        "causal explanation is empty")
     (require-conquest! (not (nil? (.-projection admitted)))
                        "Wasm exposed no admitted world projection")
     (require-conquest! (> (.-length rendered) 0)
                        "passive Beagle presentation rendered nothing")
     (require-conquest!
      (branch/dispose-process-branch! module process-branch)
      "Wasm branch did not dispose")
     (.log console rendered)
     nil)))
