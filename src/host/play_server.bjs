#lang beagle/js

(ns greywrought-clause.play-server
  (:require-global ["@types/bun" :refer [Bun Request Response]]))

(declare-extern [console JSON Reflect TextDecoder URL] Any)

(def resident-source String "src/world/embodied-encounter.clause")

(defrecord ResidentStreamReader [read (Fn [] (Promise Any))])

(defrecord ResidentGenerationProcess
  [process Any
   reader ResidentStreamReader
   decoder Any
   buffered (Atom String)
   source (Atom Any)
   latest (Atom Any)])

(defn json-stringify [value Any] String
  (.stringify JSON value))

(defn configured-port [] Int
  (let [source Any (.get Reflect (.-env Bun) "GREYWROUGHT_PORT")]
    (if (nil? source)
      4173
      (.parseInt Number source 10))))

(defn spawn-resident-generation! [] ResidentGenerationProcess
  (let [process Any (.spawn Bun {:cmd ["build/cargo-target/debug/resident_generation"
                                      resident-source]
                                 :stdin "pipe"
                                 :stdout "pipe"
                                 :stderr "inherit"})]
    (->ResidentGenerationProcess
     process
     (.getReader (.-stdout process))
     (new TextDecoder)
     (atom "")
     (atom nil)
     (atom nil))))

(defn ^:async read-resident-line! [resident ResidentGenerationProcess] (Promise String)
  (loop []
    (let [buffer String @(.-buffered resident)
          newline Int (.indexOf buffer "\n")]
      (if (>= newline 0)
        (let [line String (.slice buffer 0 newline)]
          (reset! (.-buffered resident) (.slice buffer (inc newline)))
          line)
        (let [chunk-promise (Promise Any) (.read (.-reader resident))
              chunk Any (await chunk-promise)]
          (if (.-done chunk)
            (throw (new Error "resident generation process ended"))
            (do
              (reset! (.-buffered resident)
                      (str buffer (.decode (.-decoder resident)
                                           (.-value chunk)
                                           {:stream true})))
              (recur))))))))

(defn generation-response
  [line String
   modified Any
   hot Bool] Response
  (let [fields Any (.split line "\t")
        kind Any (nth fields 0)]
    (cond
      (= kind "generation")
      (new Response
           (json-stringify
            {:generation (.parseInt Number (nth fields 1) 10)
             :compilerMicros (.parseInt Number (nth fields 2) 10)
             :cwr1 (nth fields 3)
             :sourceModifiedMillis modified
             :hot hot}))

      (= kind "error")
      (new Response
           (json-stringify {:errorHex (nth fields 1)
                            :sourceModifiedMillis modified})
           {:status 422})

      :else
      (new Response "resident generation protocol failed" {:status 500}))))

(defn ^:async resident-generation-response!
  [resident ResidentGenerationProcess
   after Int] (Promise Response)
  (let [file Any (.file Bun resident-source)
        source-promise (Promise String) (.text file)
        source String (await source-promise)
        modified Any (.-lastModified file)
        prior Any @(.-source resident)]
    (cond
      (nil? prior)
      (let [line String (await (read-resident-line! resident))]
        (reset! (.-source resident) source)
        (reset! (.-latest resident) line)
        (generation-response line modified false))

      (= prior source)
      (let [line Any @(.-latest resident)
            fields Any (if (nil? line) [] (.split line "\t"))
            generation Int (if (= (count fields) 4)
                             (.parseInt Number (nth fields 1) 10)
                             -1)]
        (if (= after generation)
          (new Response nil {:status 204})
          (generation-response line modified false)))

      :else
      (do
        (reset! (.-source resident) source)
        (.write (.-stdin (.-process resident)) "reload\n")
        (.flush (.-stdin (.-process resident)))
        (let [line String (await (read-resident-line! resident))]
          (reset! (.-latest resident) line)
          (generation-response line modified true))))))

(defn served-file [pathname String] (U String Nil)
  (cond
    (= pathname "/") "src/host/play.html"
    (= pathname "/index.html") "src/host/play.html"
    (= pathname "/app/greywrought-clause/play.js")
    "build/host/greywrought-clause/play.js"
    (= pathname "/app/greywrought-clause/presentation.js")
    "build/host/greywrought-clause/presentation.js"
    (= pathname "/app/jump-arena-shell/branch-wasm-port.js")
    "build/host/jump-arena-shell/branch-wasm-port.js"
    (= pathname "/app/jump-arena-shell/wasm-cartridge-port.js")
    "build/host/jump-arena-shell/wasm-cartridge-port.js"
    (= pathname "/app/jump-arena-shell/workbench.js")
    "build/host/jump-arena-shell/workbench.js"
    (= pathname "/app/node_modules/beagle/core.js")
    "build/host/node_modules/beagle/core.js"
    (= pathname "/app/node_modules/beagle/exception-dispatch.js")
    "build/host/node_modules/beagle/exception-dispatch.js"
    (= pathname "/vendor/three.module.js")
    "node_modules/three/build/three.module.js"
    (= pathname "/vendor/three.core.js")
    "node_modules/three/build/three.core.js"
    (= pathname "/wasm/clause_runtime.js")
    "build/host/wasm/clause_runtime.js"
    (= pathname "/wasm/clause_runtime_bg.wasm")
    "build/host/wasm/clause_runtime_bg.wasm"
    (= pathname "/assets/conquest-v1.cwr1.hex")
    "build/conquest/conquest-v1.cwr1.hex"
    (= pathname "/assets/ongoing-effect-v1.cwr1.hex")
    "build/ongoing-effect/ongoing-effect-v1.cwr1.hex"
    :else nil))

(defn handle-request!
  [resident ResidentGenerationProcess
   request Request] (U Response (Promise Response))
  (let [url Any (new URL (.-url request))
        pathname String (.-pathname url)
        after-source Any (.get (.-searchParams url) "after")
        after Int (if (nil? after-source)
                    -1
                    (.parseInt Number after-source 10))
        path (U String Nil) (served-file pathname)]
    (cond
      (= pathname "/resident-generation")
      (resident-generation-response! resident after)

      (nil? path)
      (new Response "Not found" {:status 404})

      :else
      (new Response (.file Bun path)))))

(def resident ResidentGenerationProcess (spawn-resident-generation!))
(def server Any (.serve Bun {:hostname "127.0.0.1"
                             :port (configured-port)
                              :fetch (fn [request Request] (U Response (Promise Response))
                                       (handle-request! resident request))}))

(.log console (str "Greywrought Clause is playable at " (.-url server)))
