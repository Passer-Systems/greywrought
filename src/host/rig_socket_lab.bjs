#lang beagle/js

(ns greywrought-clause.rig-socket-lab
  (:require-global ["typescript:lib.dom"
                    :refer [Event HTMLElement document requestAnimationFrame window]]))

(require
 '["three"
   :refer [AmbientLight
           AnimationAction
           AnimationClip
           AnimationMixer
           Box3
           BoxGeometry
           Color
           ConeGeometry
           CylinderGeometry
           DirectionalLight
           Group
           LoopOnce
           LoopRepeat
           Mesh
           MeshStandardMaterial
           Object3D
           Object3DEventMap
           PerspectiveCamera
           PlaneGeometry
           Scene
           Vector3
           WebGLRenderer]]
 '["three/addons/loaders/GLTFLoader.js" :refer [GLTF GLTFLoader]]
 '["three/addons/utils/SkeletonUtils.js" :refer [clone]])

(defalias SceneGraph (Scene Object3DEventMap))
(defalias SceneGroup (Group Object3DEventMap))
(defalias SceneObject (Object3D Object3DEventMap))

(def base-model-url
  String
  "/assets/quaternius/rig/base/Superhero_Female_FullBody.gltf")

(def animation-url
  String
  "/assets/quaternius/rig/animations/UAL1_Standard.glb")

(defrecord RigSockets
  [back SceneGroup
   leftBooster SceneGroup
   rightBooster SceneGroup
   leftForearm SceneGroup
   rightHand SceneGroup
   holster SceneGroup])

(defrecord EquipmentRig
  [backpack SceneGroup
   leftBooster SceneGroup
   rightBooster SceneGroup
   forearmBlade SceneGroup
   activeWeapon SceneGroup
   holsteredWeapon SceneGroup])

(defrecord LabResources
  [boxes (Vec BoxGeometry)
   cones (Vec ConeGeometry)
   cylinders (Vec CylinderGeometry)
   planes (Vec PlaneGeometry)
   materials (Vec MeshStandardMaterial)])

(defrecord ClipLibrary
  [idle AnimationClip
   locomotion AnimationClip
   jump AnimationClip
   attack AnimationClip
   hit AnimationClip
   death AnimationClip])

(defrecord RigInstance
  [root SceneObject
   mixer AnimationMixer
   sockets RigSockets
   equipment EquipmentRig
   current (Atom (U AnimationAction Nil))])

(defrecord RigSocketLab
  [scene SceneGraph
   camera PerspectiveCamera
   renderer WebGLRenderer
   host HTMLElement
   status HTMLElement
   left RigInstance
   right RigInstance
   clips ClipLibrary
   resources LabResources
   width (Atom Int)
   height (Atom Int)
   startedAt (Atom Float)
   lastTime (Atom Float)
   demoStage (Atom Int)
   disposed (Atom Bool)])

(defn require-element [id String] HTMLElement
  (let [element (U HTMLElement Nil) (.getElementById document id)]
    (if (nil? element)
      (throw (new Error (str "Missing rig lab element #" id)))
      element)))

(defn own-box!
  [resources LabResources
   geometry BoxGeometry] BoxGeometry
  (.push (.-boxes resources) geometry)
  geometry)

(defn own-cone!
  [resources LabResources
   geometry ConeGeometry] ConeGeometry
  (.push (.-cones resources) geometry)
  geometry)

(defn own-cylinder!
  [resources LabResources
   geometry CylinderGeometry] CylinderGeometry
  (.push (.-cylinders resources) geometry)
  geometry)

(defn own-plane!
  [resources LabResources
   geometry PlaneGeometry] PlaneGeometry
  (.push (.-planes resources) geometry)
  geometry)

(defn material!
  [resources LabResources
   color Int
   emissive Int
   metalness Float
   roughness Float
   transparent Bool
   opacity Float] MeshStandardMaterial
  (let [material MeshStandardMaterial (new MeshStandardMaterial
             {:color color
              :emissive emissive
              :metalness metalness
              :roughness roughness
              :transparent transparent
              :opacity opacity})]
    (.push (.-materials resources) material)
    material))

(defn box-mesh!
  [geometry BoxGeometry
   material MeshStandardMaterial] SceneObject
  (let [mesh (new Mesh)]
    (set! (.-geometry mesh) geometry)
    (set! (.-material mesh) material)
    mesh))

(defn cone-mesh!
  [geometry ConeGeometry
   material MeshStandardMaterial] SceneObject
  (let [mesh (new Mesh)]
    (set! (.-geometry mesh) geometry)
    (set! (.-material mesh) material)
    mesh))

(defn cylinder-mesh!
  [geometry CylinderGeometry
   material MeshStandardMaterial] SceneObject
  (let [mesh (new Mesh)]
    (set! (.-geometry mesh) geometry)
    (set! (.-material mesh) material)
    mesh))

(defn plane-mesh!
  [geometry PlaneGeometry
   material MeshStandardMaterial] SceneObject
  (let [mesh (new Mesh)]
    (set! (.-geometry mesh) geometry)
    (set! (.-material mesh) material)
    mesh))

(defn require-bone
  [root SceneObject
   boneName String] SceneObject
  (let [bone (U SceneObject Nil) (.getObjectByName root boneName)]
    (if (nil? bone)
      (throw (new Error (str "Quaternius rig is missing bone " boneName)))
      bone)))

(defn socket!
  [root SceneObject
   boneName String
   roleName String] SceneGroup
  (let [bone SceneObject (require-bone root boneName)
        socket SceneGroup (new Group)]
    (set! (.-name socket) roleName)
    (.add bone socket)
    socket))

(defn normalize-sockets! [root SceneObject] RigSockets
  (let [back SceneGroup (socket! root "spine_03" "greywrought.socket.upper-back")
        leftBooster SceneGroup (socket! root "calf_l" "greywrought.socket.left-lower-leg")
        rightBooster SceneGroup (socket! root "calf_r" "greywrought.socket.right-lower-leg")
        leftForearm SceneGroup (socket! root "lowerarm_l" "greywrought.socket.left-forearm")
        rightHand SceneGroup (socket! root "hand_r" "greywrought.socket.right-hand")
        holster SceneGroup (socket! root "pelvis" "greywrought.socket.hip-holster")]
    (.set (.-position back) 0.0 0.08 -0.14)
    (.set (.-position leftBooster) 0.0 0.19 -0.075)
    (.set (.-position rightBooster) 0.0 0.19 -0.075)
    (.set (.-position leftForearm) 0.0 0.12 -0.055)
    (.set (.-position rightHand) 0.0 0.08 0.025)
    (.set (.-position holster) 0.19 0.02 -0.08)
    (->RigSockets back leftBooster rightBooster leftForearm rightHand holster)))

(defn nozzle!
  [resources LabResources
   parent SceneGroup
   shellMaterial MeshStandardMaterial
   plumeMaterial MeshStandardMaterial
   x Float
   y Float
   z Float
   name String] Nil
  (let [shellGeometry CylinderGeometry (own-cylinder! resources (new CylinderGeometry 0.045 0.065 0.15 10))
        shell SceneObject (cylinder-mesh! shellGeometry shellMaterial)
        plumeGeometry ConeGeometry (own-cone! resources (new ConeGeometry 0.045 0.20 10))
        plume SceneObject (cone-mesh! plumeGeometry plumeMaterial)]
    (set! (.-name shell) (str name ".shell"))
    (set! (.-name plume) (str name ".plume"))
    (set! (.-x (.-rotation shell)) 1.5707963)
    (set! (.-x (.-rotation plume)) -1.5707963)
    (.set (.-position shell) x y z)
    (.set (.-position plume) x y (+ z 0.16))
    (.add parent shell plume))
  nil)

(defn build-equipment!
  [sockets RigSockets
   resources LabResources] EquipmentRig
  (let [armor MeshStandardMaterial (material! resources 1712436 263429 0.88 0.28 false 1.0)
        darkMetal MeshStandardMaterial (material! resources 3158322 65793 0.94 0.20 false 1.0)
        edge MeshStandardMaterial (material! resources 7535554 5423296 0.70 0.22 false 1.0)
        plume MeshStandardMaterial (material! resources 6749951 3394815 0.0 0.18 true 0.82)
        blade MeshStandardMaterial (material! resources 14739199 8621567 0.54 0.12 true 0.92)
        backpack SceneGroup (new Group)
        backpackCore SceneObject (box-mesh! (own-box! resources (new BoxGeometry 0.36 0.44 0.15)) armor)
        leftBooster SceneGroup (new Group)
        rightBooster SceneGroup (new Group)
        forearmBlade SceneGroup (new Group)
        bladeCore SceneObject (box-mesh! (own-box! resources (new BoxGeometry 0.075 0.46 0.035)) blade)
        activeWeapon SceneGroup (new Group)
        weaponCore SceneObject (box-mesh! (own-box! resources (new BoxGeometry 0.12 0.54 0.15)) edge)
        weaponGuard SceneObject (box-mesh! (own-box! resources (new BoxGeometry 0.31 0.055 0.17)) darkMetal)
        holsteredWeapon SceneGroup (new Group)
        holsterCore SceneObject (box-mesh! (own-box! resources (new BoxGeometry 0.14 0.62 0.17)) darkMetal)]
    (set! (.-name backpack) "greywrought.equipment.backpack")
    (set! (.-name leftBooster) "greywrought.equipment.left-booster")
    (set! (.-name rightBooster) "greywrought.equipment.right-booster")
    (set! (.-name forearmBlade) "greywrought.equipment.forearm-blade")
    (set! (.-name activeWeapon) "greywrought.equipment.active-weapon")
    (set! (.-name holsteredWeapon) "greywrought.equipment.holstered-weapon")
    (set! (.-name backpackCore) "greywrought.equipment.backpack.core")
    (set! (.-name bladeCore) "greywrought.equipment.forearm-blade.edge")
    (set! (.-name weaponCore) "greywrought.equipment.active-weapon.core")
    (set! (.-name weaponGuard) "greywrought.equipment.active-weapon.guard")
    (set! (.-name holsterCore) "greywrought.equipment.holstered-weapon.core")
    (.add backpack backpackCore)
    (nozzle! resources backpack darkMetal plume -0.105 -0.10 -0.04
             "greywrought.nozzle.back-left")
    (nozzle! resources backpack darkMetal plume 0.105 -0.10 -0.04
             "greywrought.nozzle.back-right")
    (nozzle! resources leftBooster darkMetal plume 0.0 0.0 0.0
             "greywrought.nozzle.left-foot")
    (nozzle! resources rightBooster darkMetal plume 0.0 0.0 0.0
             "greywrought.nozzle.right-foot")
    (.set (.-position bladeCore) -0.08 0.20 -0.01)
    (set! (.-z (.-rotation bladeCore)) -0.10)
    (.add forearmBlade bladeCore)
    (.set (.-position weaponCore) 0.0 0.24 0.0)
    (.set (.-position weaponGuard) 0.0 0.03 0.0)
    (.add activeWeapon weaponCore weaponGuard)
    (.set (.-position holsterCore) 0.0 -0.20 0.0)
    (set! (.-z (.-rotation holsterCore)) 0.18)
    (.add holsteredWeapon holsterCore)
    (.add (.-back sockets) backpack)
    (.add (.-leftBooster sockets) leftBooster)
    (.add (.-rightBooster sockets) rightBooster)
    (.add (.-leftForearm sockets) forearmBlade)
    (.add (.-rightHand sockets) activeWeapon)
    (.add (.-holster sockets) holsteredWeapon)
    (->EquipmentRig
     backpack leftBooster rightBooster forearmBlade activeWeapon holsteredWeapon)))

(defn exact-clip
  [clips (Vec AnimationClip)
   name String] AnimationClip
  (let [clip (U AnimationClip Nil) (.findByName AnimationClip clips name)]
    (if (nil? clip)
      (throw (new Error (str "UAL1 Standard is missing clip " name)))
      clip)))

(defn select-clips [clips (Vec AnimationClip)] ClipLibrary
  (->ClipLibrary
   (exact-clip clips "Idle_Loop")
   (exact-clip clips "Sprint_Loop")
   (exact-clip clips "Jump_Loop")
   (exact-clip clips "Sword_Attack")
   (exact-clip clips "Hit_Chest")
   (exact-clip clips "Death01")))

(defn normalize-root!
  [root SceneObject
   x Float] Nil
  (let [bounds Box3 (new Box3)
        size Vector3 (new Vector3)]
    (.setFromObject bounds root)
    (.getSize bounds size)
    (when (<= (.-y size) 0.0)
      (throw (new Error "Quaternius rig has an empty model bound")))
    (.setScalar (.-scale root) (/ 2.45 (.-y size)))
    (.setFromObject bounds root)
    (.set (.-position root) x (- (.-y (.-min bounds))) 0.0))
  nil)

(defn rig-instance!
  [source SceneGroup
   x Float
   resources LabResources
   name String] RigInstance
  (let [root SceneObject (clone source)
        sockets RigSockets (normalize-sockets! root)
        equipment EquipmentRig (build-equipment! sockets resources)
        mixer AnimationMixer (new AnimationMixer root)]
    (set! (.-name root) name)
    (normalize-root! root x)
    (->RigInstance root mixer sockets equipment (atom nil))))

(defn play-clip!
  [instance RigInstance
   clip AnimationClip
   looping Bool] Nil
  (let [prior (U AnimationAction Nil) @(.-current instance)
        action AnimationAction (.clipAction (.-mixer instance) clip)]
    (when-not (nil? prior)
      (.fadeOut prior 0.14))
    (.reset action)
    (.setEffectiveTimeScale action 1.0)
    (.setEffectiveWeight action 1.0)
    (if looping
      (do
        (.setLoop action LoopRepeat 1000000)
        (set! (.-clampWhenFinished action) false))
      (do
        (.setLoop action LoopOnce 1)
        (set! (.-clampWhenFinished action) true)))
    (.fadeIn action 0.14)
    (.play action)
    (reset! (.-current instance) action))
  nil)

(defn mark-stage!
  [lab RigSocketLab
   stage Int
   label String] Nil
  (reset! (.-demoStage lab) stage)
  (set! (.-textContent (.-status lab)) label)
  (.setAttribute (.-body document) "data-demo-stage" (str stage))
  nil)

(defn play-stage!
  [lab RigSocketLab
   stage Int] Nil
  (let [clips ClipLibrary (.-clips lab)]
    (cond
      (= stage 0)
      (do
        (play-clip! (.-left lab) (.-idle clips) true)
        (play-clip! (.-right lab) (.-locomotion clips) true)
        (mark-stage! lab 0 "Idle + root-disabled sprint"))

      (= stage 1)
      (do
        (play-clip! (.-left lab) (.-jump clips) true)
        (play-clip! (.-right lab) (.-attack clips) false)
        (mark-stage! lab 1 "Aerial posture + committed sword action"))

      (= stage 2)
      (do
        (play-clip! (.-left lab) (.-hit clips) false)
        (play-clip! (.-right lab) (.-jump clips) true)
        (mark-stage! lab 2 "Hit reaction + aerial posture"))

      (= stage 3)
      (do
        (play-clip! (.-left lab) (.-attack clips) false)
        (play-clip! (.-right lab) (.-hit clips) false)
        (mark-stage! lab 3 "Shared clips, independent mixer state"))

      :else
      (do
        (play-clip! (.-left lab) (.-idle clips) true)
        (play-clip! (.-right lab) (.-death clips) false)
        (mark-stage! lab 4 "Idle + death; all six equipment roots remain socketed"))))
  nil)

(defn advance-demo!
  [lab RigSocketLab
   elapsed Float] Nil
  (let [stage Int @(.-demoStage lab)]
    (cond
      (and (< stage 4) (>= elapsed 8.0)) (play-stage! lab 4)
      (and (< stage 3) (>= elapsed 6.0)) (play-stage! lab 3)
      (and (< stage 2) (>= elapsed 4.0)) (play-stage! lab 2)
      (and (< stage 1) (>= elapsed 2.0)) (play-stage! lab 1)
      :else nil))
  nil)

(defn bind-control!
  [lab RigSocketLab
   id String
   clip AnimationClip
   looping Bool
   label String] Nil
  (.addEventListener
   (require-element id)
   "click"
   (fn [event Event] Nil
     (play-clip! (.-left lab) clip looping)
     (play-clip! (.-right lab) clip looping)
     (set! (.-textContent (.-status lab)) label)
     nil))
  nil)

(defn bind-controls! [lab RigSocketLab] Nil
  (let [clips ClipLibrary (.-clips lab)]
    (bind-control! lab "clip-idle" (.-idle clips) true "Both rigs: idle")
    (bind-control! lab "clip-sprint" (.-locomotion clips) true
                   "Both rigs: root-disabled sprint")
    (bind-control! lab "clip-jump" (.-jump clips) true
                   "Both rigs: aerial posture")
    (bind-control! lab "clip-attack" (.-attack clips) false
                   "Both rigs: committed sword action")
    (bind-control! lab "clip-hit" (.-hit clips) false "Both rigs: hit reaction")
    (bind-control! lab "clip-death" (.-death clips) false "Both rigs: death"))
  nil)

(defn update-viewport! [lab RigSocketLab] Nil
  (let [width Int (max 1 (.-clientWidth (.-host lab)))
        height Int (max 1 (.-clientHeight (.-host lab)))]
    (when (or (not= width @(.-width lab))
              (not= height @(.-height lab)))
      (reset! (.-width lab) width)
      (reset! (.-height lab) height)
      (set! (.-aspect (.-camera lab)) (/ width height))
      (.updateProjectionMatrix (.-camera lab))
      (.setSize (.-renderer lab) width height false)))
  nil)

(defn render-frame!
  [lab RigSocketLab
   timestamp Float] Nil
  (when-not @(.-disposed lab)
    (let [started Float @(.-startedAt lab)
          prior Float @(.-lastTime lab)
          firstFrame Bool (< started 0.0)
          delta Float (if (or firstFrame (< prior 0.0))
                        0.0
                        (min 0.05 (max 0.0 (/ (- timestamp prior) 1000.0))))
          elapsed Float (if firstFrame 0.0 (/ (- timestamp started) 1000.0))]
      (when firstFrame
        (reset! (.-startedAt lab) timestamp))
      (reset! (.-lastTime lab) timestamp)
      (update-viewport! lab)
      (.update (.-mixer (.-left lab)) delta)
      (.update (.-mixer (.-right lab)) delta)
      (advance-demo! lab elapsed)
      (.render (.-renderer lab) (.-scene lab) (.-camera lab))
      (requestAnimationFrame (fn [nextTimestamp Float] Nil
                               (render-frame! lab nextTimestamp)))))
  nil)

(defn dispose-lab! [lab RigSocketLab] Nil
  (when-not @(.-disposed lab)
    (reset! (.-disposed lab) true)
    (.stopAllAction (.-mixer (.-left lab)))
    (.stopAllAction (.-mixer (.-right lab)))
    (.uncacheRoot (.-mixer (.-left lab)) (.-root (.-left lab)))
    (.uncacheRoot (.-mixer (.-right lab)) (.-root (.-right lab)))
    (doseq [geometry BoxGeometry (.-boxes (.-resources lab))]
      (.dispose geometry))
    (doseq [geometry ConeGeometry (.-cones (.-resources lab))]
      (.dispose geometry))
    (doseq [geometry CylinderGeometry (.-cylinders (.-resources lab))]
      (.dispose geometry))
    (doseq [geometry PlaneGeometry (.-planes (.-resources lab))]
      (.dispose geometry))
    (doseq [material MeshStandardMaterial (.-materials (.-resources lab))]
      (.dispose material))
    (.dispose (.-renderer lab)))
  nil)

(defn ^:async start-lab! [] (Promise Nil)
  (let [loader GLTFLoader (new GLTFLoader)
        base-promise (Promise GLTF) (.loadAsync loader base-model-url)
        animation-promise (Promise GLTF) (.loadAsync loader animation-url)
        base GLTF (await base-promise)
        animations GLTF (await animation-promise)
        resources LabResources (->LabResources [] [] [] [] [])
        scene SceneGraph (new Scene)
        camera PerspectiveCamera (new PerspectiveCamera 42.0 1.0 0.1 50.0)
        renderer WebGLRenderer (new WebGLRenderer {:antialias true :alpha false})
        host HTMLElement (require-element "rig-stage")
        status HTMLElement (require-element "animation-status")
        clips ClipLibrary (select-clips (.-animations animations))
        left RigInstance (rig-instance! (.-scene base) -1.55 resources "greywrought.rig.left")
        right RigInstance (rig-instance! (.-scene base) 1.55 resources "greywrought.rig.right")
        floorMaterial MeshStandardMaterial (material! resources 789774 0 0.16 0.82 false 1.0)
        floor SceneObject (plane-mesh! (own-plane! resources (new PlaneGeometry 11.0 8.0))
                     floorMaterial)
        ambient AmbientLight (new AmbientLight 6319220 1.9)
        keyLight DirectionalLight (new DirectionalLight 16765022 4.2)
        lab RigSocketLab (->RigSocketLab
         scene camera renderer host status left right clips resources
         (atom 0) (atom 0) (atom -1.0) (atom -1.0) (atom 0) (atom false))]
    (set! (.-background scene) (new Color 131339))
    (set! (.-x (.-rotation floor)) -1.5707963)
    (set! (.-y (.-position floor)) -0.015)
    (.set (.-position camera) 0.0 3.4 7.4)
    (.lookAt camera 0.0 1.15 0.0)
    (.set (.-position keyLight) -4.0 7.0 5.0)
    (.add scene floor ambient keyLight (.-root left) (.-root right))
    (.setPixelRatio renderer (max 1.0 (min 2.0 (.-devicePixelRatio window))))
    (set! (.-outputColorSpace renderer) "srgb")
    (.appendChild host (.-domElement renderer))
    (play-stage! lab 0)
    (bind-controls! lab)
    (.setAttribute (.-body document) "data-lab-state" "ready")
    (.setAttribute (.-body document) "data-socket-count" "6")
    (.setAttribute (.-body document) "data-equipment-count" "6")
    (.setAttribute (.-body document) "data-mixer-count" "2")
    (.setAttribute (.-body document) "data-clips-shared" "true")
    (.setAttribute (.-body document) "data-root-motion" "disabled")
    (.addEventListener window "beforeunload" (fn [event Event] Nil
                                                (dispose-lab! lab)))
    (requestAnimationFrame (fn [timestamp Float] Nil (render-frame! lab timestamp)))
    nil))

(start-lab!)
