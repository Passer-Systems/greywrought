#lang beagle/js

(ns greywrought-clause.play
  (:require [greywrought-clause.cinderwake-presentation :as cinder]
            [jump-arena-shell.branch-wasm-port :as branch]
            [jump-arena-shell.wasm-cartridge-port :as wasm]
            [jump-arena-shell.workbench :as workbench])
  (:require-global ["typescript:lib.dom" :refer [Response fetch]]))

(require
 '["#clause-runtime-wasm"
   :refer [clause_branch_v1_command
           clause_branch_v1_event_byte
           clause_branch_v1_event_len
           clause_branch_v1_io_reset
           clause_branch_v1_open
           clause_branch_v1_request_push
           clause_session_v1_command_bulk
           clause_session_v1_event_bulk
           clause_session_v1_open_bulk
           clause_session_v1_reclaim_retired
           initSync
           InitOutput
           SyncInitInput]])

(declare-extern
  [cancelAnimationFrame document
   clearInterval Date
   localStorage Reflect
   requestAnimationFrame setInterval
   URLSearchParams window] Any)

(defrecord Dormant [loaded Bool])
(defrecord Ready [entered Bool])
(defrecord Disconnected [processBranch branch/WasmProcessBranch])
(defrecord BranchAdvanced
  [processBranch branch/WasmProcessBranch
   authoritative Any
   proposal Any])
(defrecord CandidateSubmitted
  [processBranch branch/WasmProcessBranch
   authoritative Any
   proposal Any])
(defrecord SuccessorAdmitted
  [processBranch branch/WasmProcessBranch
   admitted Any
   explanation Any
   projection Any])

(defunion JourneyStage
  Dormant
  Ready
  Disconnected
  BranchAdvanced
  CandidateSubmitted
  SuccessorAdmitted)

(defrecord StageView
  [label String
   summary String
   canEnter Bool
   canDisconnect Bool
   canAdvance Bool
   canSubmit Bool
   canAdmit Bool
   branchVisible Bool
   candidateText (U String Nil)
   projectionText String
   explanationText String])

(defrecord SceneShell
  [presentation cinder/CinderwakePresentation
   canvas Any
   frameHandle (Atom Int)
   alive (Atom Bool)
   pointerHandler Any])

(defrecord EffectSession
  [port workbench/CartridgePort
   session Any])

(defrecord ResidentLawSession
  [port workbench/CartridgePort
   controller (Atom Any)
   generation (Atom Int)
   polling (Atom Bool)
   interval (Atom Int)
   pendingHot (Atom Any)
   lastProjection (Atom Any)
   admittedOrdinal (Atom Int)
   candidateSeen (Atom Bool)])

(defrecord PlayApp
  [module Any
   branchRequest wasm/ExactProcessRequest
   occurrences (Vec Any)
   effect EffectSession
   residentLaw ResidentLawSession
   stage (Atom JourneyStage)
   effectSettled (Atom Bool)
   scene SceneShell
   listeners (Vec Any)])

(defn element [id String] Any
  (let [value Any (.getElementById document id)]
    (if (nil? value)
      (throw (new Error (str "missing browser element #" id)))
      value)))

(defn identity-string [value Any] String
  (.stringify JSON value))

(defn browser-int [value Any] Int
  (let [converted Int (wasm/process-status value)]
    (if (< converted 0) 0 converted)))

(defn policy [] workbench/WorkbenchPolicy
  (let [maximum Int (.-MAX_SAFE_INTEGER Number)]
    (workbench/->WorkbenchPolicy
     8 8 32 128 512
     (workbench/->WorkbenchSequenceLimits
      maximum maximum maximum maximum maximum))))

(defn resident-policy [] workbench/WorkbenchPolicy
  (let [maximum Int (.-MAX_SAFE_INTEGER Number)]
    (workbench/->WorkbenchPolicy
     8 8 32 wasm/cse1-projected-term-max-properties
     wasm/cse1-projected-term-json-max-source-units
     (workbench/->WorkbenchSequenceLimits
      maximum maximum maximum maximum maximum))))

(defn initialize-runtime [module ArrayBuffer] Any
  (let [input SyncInitInput module
        _initialized InitOutput (initSync {:module input})]
    (.freeze
     Object
     {:clause_branch_v1_io_reset
      (fn [] Nil (clause_branch_v1_io_reset))
      :clause_branch_v1_request_push
      (fn [byte Int] Float (clause_branch_v1_request_push byte))
      :clause_branch_v1_open
      (fn [] Float (clause_branch_v1_open))
      :clause_branch_v1_command
      (fn [] Float (clause_branch_v1_command))
      :clause_branch_v1_event_len
      (fn [] Float (clause_branch_v1_event_len))
      :clause_branch_v1_event_byte
      (fn [index Int] Float (clause_branch_v1_event_byte index))
      :clause_session_v1_open_bulk
      (fn [request (Vec Int)] Float
        (clause_session_v1_open_bulk (new Uint8Array request)))
      :clause_session_v1_command_bulk
      (fn [request (Vec Int)] Float
        (clause_session_v1_command_bulk (new Uint8Array request)))
      :clause_session_v1_event_bulk
      (fn [] Any (clause_session_v1_event_bulk))
      :clause_session_v1_reclaim_retired
      (fn [] Bool (clause_session_v1_reclaim_retired))})))

(defn open-effect-session!
  [module Any
   request wasm/ExactProcessRequest] EffectSession
  (let [port workbench/CartridgePort (wasm/create-wasm-cartridge-port
                                      module
                                      (policy))
        accepted (Atom Any) (atom nil)
        started (Atom Any) (atom nil)]
    ((.-acceptPackage port) request
     (fn [result Any] Any (reset! accepted result)))
    ((.-startSession port) (.-acceptedPackage @accepted) 1
     (fn [result Any] Any (reset! started result)))
    (->EffectSession port (.-session @started))))

(defn open-resident-law-session! [module Any] ResidentLawSession
  (->ResidentLawSession
   (wasm/create-wasm-cartridge-port module (resident-policy))
   (atom nil)
   (atom -1)
   (atom false)
   (atom 0)
   (atom nil)
   (atom nil)
   (atom 0)
   (atom false)))

(defn resident-law-failure! [message Any] Nil
  (set! (.-textContent (element "resident-law"))
        (str "Source generation rejected\n" (str message)))
  (set! (.-residentPhase (.-dataset (.-body document))) "rejected")
  nil)

(defn projected-property
  [value Any
   key String] Any
  (if (or (nil? value)
          (not= (js/typeof value) "object"))
    (throw (new Error (str "projected parent is absent for field " key)))
    (.get Reflect value key)))

(defn projected-object-property
  [value Any
   key String] Any
  (let [result Any (projected-property value key)]
    (if (or (nil? result)
            (not= (js/typeof result) "object"))
      (throw (new Error (str "projected object field is absent: " key)))
      result)))

(defn objective-label [state Any] String
  (let [status Float (projected-property state "x")]
    (cond
      (= status 1.0) "completed"
      (= status -1.0) "failed"
      :else "playing")))

(defn presentation-position [position Any] cinder/ProjectedPosition
  (let [x Float (projected-property position "x")
        y Float (projected-property position "y")
        z Float (projected-property position "z")]
    (cinder/->ProjectedPosition x y z)))

(defn vitality-bar!
  [bar-id String
   value-id String
   vitality Float
   maximum Float] Nil
  (let [ratio Float (max 0.0 (min 1.0 (/ vitality (max 0.001 maximum))))]
    (set! (.-transform (.-style (element bar-id)))
          (str "scaleX(" (str ratio) ")"))
    (set! (.-textContent (element value-id))
          (str (str vitality) " / " (str maximum))))
  nil)

(defn bounded-game-event! [event Any] Nil
  (let [events Any (.-__GREYWROUGHT_GAME_EVENTS__ window)]
    (.push events event)
    (when (> (.-length events) 512)
      (.shift events)))
  nil)

(defn render-game-projection!
  [app PlayApp
   projection Any] Nil
  (let [resident ResidentLawSession (.-residentLaw app)
        prior Any @(.-lastProjection resident)
        ordinal Int (inc @(.-admittedOrdinal resident))
        presentation cinder/CinderwakePresentation (.-presentation (.-scene app))
        player Any (projected-property projection "player-1")
        enemy Any (projected-property projection "cinder-wraith")
        bolt Any (projected-property projection "cinder-bolt")
        loot Any (projected-property projection "ashen-key")
        objective Any (projected-property projection "game-objective")
        player-position Any (projected-object-property player "position")
        enemy-position Any (projected-object-property enemy "enemy-position")
        bolt-position Any (projected-object-property bolt "projectile-position")
        loot-position Any (projected-object-property loot "loot-position")
        exit-position Any (projected-object-property objective "exit-position")
        player-vitals Any (projected-object-property player "player-vitals")
        enemy-vitals Any (projected-object-property enemy "enemy-vitals")
        grounded Bool (projected-property player "grounded")
        booster-energy Float (projected-property player "booster-energy")
        booster-capacity Float (projected-property player "booster-capacity")
        booster-threshold Float (projected-property player "booster-ignition-threshold")
        booster-delay Float (projected-property player "booster-regeneration-delay")
        status-effect String (projected-property player "status-effect")
        status-clock Float (projected-property player "status-clock")
        pressure-state String (projected-property enemy "enemy-pressure-state")
        pressure-clock Float (projected-property enemy "enemy-pressure-clock")
        random-sample Float (projected-property enemy "enemy-random-sample")
        bolt-visible Bool (projected-property bolt "projectile-visible")
        objective-state Any (projected-object-property objective "objective-state")
        player-x Float (projected-property player-position "x")
        player-z Float (projected-property player-position "z")
        player-vitality Float (projected-property player-vitals "x")
        player-maximum Float (projected-property player-vitals "y")
        enemy-vitality Float (projected-property enemy-vitals "x")
        enemy-maximum Float (projected-property enemy-vitals "y")
        player-status String (projected-property player "combat-status")
        enemy-status String (projected-property enemy "enemy-combat-status")
        loot-state String (projected-property loot "loot-state")
        custody String (projected-property loot "custody")
        objective-status String (objective-label objective-state)]
    (reset! (.-admittedOrdinal resident) ordinal)
    (cinder/apply-admitted-frame!
     presentation
     (cinder/->AdmittedPresentationFrame
      ordinal
      [(cinder/->AdmittedSubjectFrame
        "ashen-wayfarer"
        (presentation-position player-position)
        true
        (/ player-vitality (max 0.001 player-maximum)))
       (cinder/->AdmittedSubjectFrame
        "cinder-wraith"
        (presentation-position enemy-position)
        true
        (/ enemy-vitality (max 0.001 enemy-maximum)))
       (cinder/->AdmittedSubjectFrame
        "cinder-bolt"
        (presentation-position bolt-position)
        bolt-visible
        1.0)
       (cinder/->AdmittedSubjectFrame
        "ashen-key"
        (presentation-position loot-position)
        (not (= loot-state "hidden"))
        1.0)
       (cinder/->AdmittedSubjectFrame
        "moonwell"
        (presentation-position exit-position)
        true
        1.0)]
      (presentation-position player-position)))
    (cinder/set-activity-cue!
     presentation
     "cinder-wraith"
     (if (= pressure-state "telegraph") 1.0 0.0)
     (if (= pressure-state "lunge") 1.0 0.0)
     (if (= pressure-state "recovery") 1.0 0.0))
    (cinder/set-activity-cue!
     presentation
     "ashen-key"
     (if (= loot-state "available") 1.0 0.0)
     (if (= loot-state "available") 0.7 0.0)
     0.0)
    (vitality-bar! "player-vitality-bar" "player-vitality"
                   player-vitality player-maximum)
    (vitality-bar! "enemy-vitality-bar" "enemy-vitality"
                   enemy-vitality enemy-maximum)
    (vitality-bar! "booster-energy-bar" "booster-energy"
                   booster-energy booster-capacity)
    (set! (.-textContent (element "objective"))
          (cond
            (= objective-status "completed")
            "MOONWELL RESTORED · the ashen key is admitted"

            (= objective-status "failed")
            "WAYFARER FALLEN · press R to restore the revision"

            (= loot-state "available")
            "ASHEN KEY REVEALED · walk over the glowing key"

            (and (= loot-state "acquired") (= custody "player-1"))
            "KEY CLAIMED · carry it west to the moonwell"

            :else
            "Read the telegraph · meet the bolt aloft · fell the wraith"))
    (set! (.-textContent (element "stage"))
          (str "world · " objective-status))
    (set! (.-textContent (element "summary"))
          (str "wayfarer " player-status
               " · wraith " enemy-status
               " / " pressure-state " " (str pressure-clock)
               " · key " loot-state " / " custody
               " · booster " (str booster-energy) " / " (str booster-capacity)
               " · ignition " (str booster-threshold)
               " · regeneration delay " (str booster-delay)
               " · status " status-effect " " (str status-clock)
               " · fixed sample " (str random-sample)))
    (set! (.-textContent (element "combat-state"))
          (str "BOOST " (str booster-energy) " / " (str booster-capacity)
               " · IGNITE " (str booster-threshold)
               " · REGEN " (str booster-delay)
               "   STATUS " status-effect " · " (str status-clock)))
    (set! (.-gamePhase (.-dataset (.-body document))) objective-status)
    (set! (.-gamePlayerVitality (.-dataset (.-body document)))
          (str player-vitality))
    (set! (.-gameEnemyVitality (.-dataset (.-body document)))
          (str enemy-vitality))
    (set! (.-gameCustody (.-dataset (.-body document))) custody)
    (set! (.-gamePlayerX (.-dataset (.-body document))) (str player-x))
    (set! (.-gamePlayerZ (.-dataset (.-body document))) (str player-z))
    (set! (.-gameBoosterEnergy (.-dataset (.-body document)))
          (str booster-energy))
    (set! (.-gameBoosterCapacity (.-dataset (.-body document)))
          (str booster-capacity))
    (set! (.-gameBoosterIgnitionThreshold (.-dataset (.-body document)))
          (str booster-threshold))
    (set! (.-gameBoosterRegenerationDelay (.-dataset (.-body document)))
          (str booster-delay))
    (set! (.-gameStatusEffect (.-dataset (.-body document))) status-effect)
    (set! (.-gameStatusClock (.-dataset (.-body document))) (str status-clock))
    (set! (.-gameProjectileVisible (.-dataset (.-body document)))
          (str bolt-visible))
    (set! (.-gameEnemyPressure (.-dataset (.-body document))) pressure-state)
    (set! (.-gamePressureClock (.-dataset (.-body document)))
          (str pressure-clock))
    (when-not (nil? prior)
      (let [prior-player Any (projected-property prior "player-1")
            prior-enemy Any (projected-property prior "cinder-wraith")
            prior-player-vitals Any (projected-property prior-player "player-vitals")
            prior-enemy-vitals Any (projected-property prior-enemy "enemy-vitals")
            prior-player-vitality Float (projected-property prior-player-vitals "x")
            prior-enemy-vitality Float (projected-property prior-enemy-vitals "x")
            prior-grounded Bool (projected-property prior-player "grounded")
            prior-player-status String (projected-property prior-player "combat-status")
            prior-enemy-status String (projected-property prior-enemy "enemy-combat-status")]
        (set! (.-textContent (element "combat-feedback")) "")
        (when (< enemy-vitality prior-enemy-vitality)
          (set! (.-textContent (element "combat-feedback"))
                (str "EMBER IMPACT · -"
                     (str (- prior-enemy-vitality enemy-vitality))))
          (cinder/signal-impact!
           presentation "cinder-wraith" ordinal
           (/ (- prior-enemy-vitality enemy-vitality)
              (max 0.001 enemy-maximum))))
        (when (< player-vitality prior-player-vitality)
          (set! (.-textContent (element "combat-feedback"))
                (str "WRAITH IMPACT · -"
                     (str (- prior-player-vitality player-vitality))))
          (cinder/signal-impact!
           presentation "ashen-wayfarer" ordinal
           (/ (- prior-player-vitality player-vitality)
              (max 0.001 player-maximum))))
        (when (and prior-grounded (not grounded))
          (cinder/signal-propulsion!
           presentation "ashen-wayfarer" ordinal 1.0))
        (when (and (= player-status "dead")
                   (not= prior-player-status "dead"))
          (cinder/signal-death!
           presentation "ashen-wayfarer" ordinal))
        (when (and (= enemy-status "dead")
                   (not= prior-enemy-status "dead"))
          (cinder/signal-death!
           presentation "cinder-wraith" ordinal))))
    (reset! (.-lastProjection resident) projection)
    (bounded-game-event!
     {:phase "frame-admitted"
      :generation @(.-generation resident)
      :objective objective-status
      :playerX player-x
      :playerZ player-z
      :boosterEnergy booster-energy
      :boosterCapacity booster-capacity
      :boosterIgnitionThreshold booster-threshold
      :boosterRegenerationDelay booster-delay
      :statusEffect status-effect
      :statusClock status-clock
      :projectileVisible bolt-visible
      :enemyPressure pressure-state
      :pressureClock pressure-clock
      :playerVitality player-vitality
      :enemyVitality enemy-vitality
      :lootState loot-state
      :custody custody})
    nil))

(defn game-lifecycle-receipt!
  [app PlayApp
   receipt workbench/LifecycleReceipt] Nil
  (let [resident ResidentLawSession (.-residentLaw app)
        event String (.-event receipt)
        generation Int (.-activeGeneration receipt)]
    (bounded-game-event!
     {:phase event
      :generation generation
      :operation (.-operationId receipt)
      :detail (.-detail receipt)})
    (cond
      (= event "candidate-produced")
      (do
        (reset! (.-candidateSeen resident) true)
        (set! (.-gameCustodyPhase (.-dataset (.-body document)))
              "candidate-hidden")
        (set! (.-textContent (element "game-custody"))
              (str "CandidateDelta retained and hidden"
                   "\ngeneration " (str generation)
                   " · operation " (str (.-operationId receipt)))))

      (= event "admission-accepted")
      (let [ordered Bool @(.-candidateSeen resident)
            pending Any @(.-pendingHot resident)]
        (set! (.-gameCustodyPhase (.-dataset (.-body document)))
              (if ordered "candidate-before-admission" "order-violation"))
        (set! (.-textContent (element "game-custody"))
              (str "CandidateDelta hidden first"
                   "\nseparate Admission installed successor"
                   "\noperation " (str (.-operationId receipt))))
        (reset! (.-candidateSeen resident) false)
        (when (and (not (nil? pending)) (.-hot pending))
          (let [now Float (.now Date)
                modified Float (.-sourceModifiedMillis pending)
                latency Float (- now modified)]
            (set! (.-residentLatencyMillis (.-dataset (.-body document)))
                  (str latency))
            (set! (.-textContent (element "resident-law"))
                  (str "generation " (str (.-generation pending))
                       " · admitted live edit"
                       "\nsource-save → behavior " (str latency) " ms"
                       " · resident compile "
                       (str (.-compilerMicros pending)) " µs"))
            (.push (.-__GREYWROUGHT_RESIDENT_EVENTS__ window)
                   {:phase "admitted"
                    :generation (.-generation pending)
                    :latencyMillis latency
                    :compilerMicros (.-compilerMicros pending)})
            (reset! (.-pendingHot resident) nil))))

      (= event "session-started")
      (set! (.-residentPhase (.-dataset (.-body document))) "session-started")

      (or (= event "candidate-failed")
          (= event "admission-rejected")
          (= event "session-failed")
          (= event "package-rejected"))
      (resident-law-failure! (.-detail receipt))

      :else nil))
  nil)

(defn install-resident-law!
  [app PlayApp
   payload Any] Nil
  (let [resident ResidentLawSession (.-residentLaw app)
        port workbench/CartridgePort (.-port resident)
        request wasm/ExactProcessRequest (wasm/->ExactProcessRequest (wasm/decode-cwr1-hex (.-cwr1 payload)))
        controller Any @(.-controller resident)]
    (reset! (.-generation resident) (.-generation payload))
    (reset! (.-pendingHot resident) (if (.-hot payload) payload nil))
    (set! (.-residentGeneration (.-dataset (.-body document)))
          (str (.-generation payload)))
    (set! (.-residentCompilerMicros (.-dataset (.-body document)))
          (str (.-compilerMicros payload)))
    (set! (.-textContent (element "resident-law"))
          (str "generation " (str (.-generation payload))
               " · checked"
               "\nresident compile " (str (.-compilerMicros payload)) " µs"
               "\nawaiting first admitted frame"))
    (if (nil? controller)
      (let [created Any (workbench/create-cartridge-workbench!
             port
             (workbench/->FixedTick 16)
             (resident-policy)
             (fn
               [milliseconds Int
                callback Any] Any
               (let [handle Int (browser-int (setInterval callback milliseconds))]
                 (fn [] Any (clearInterval handle))))
             (fn [frame Any] Any
               (try
                 (when (or (not (.isArray Array frame))
                           (> (.-length frame) 0))
                   (let [projection Any (wasm/decode-projected-term-frame frame)]
                     (render-game-projection! app projection)))
                 (catch Error error
                   (do
                     (resident-law-failure! (.-message error))
                     (throw error)))))
             (fn [receipt workbench/LifecycleReceipt] Any
               (game-lifecycle-receipt! app receipt))
             request)]
        (reset! (.-controller resident) created))
      (when-not ((.-reloadPackage controller) request)
        (resident-law-failure! "resident generation reload was not accepted"))))
  nil)

(defn focus-scene! [shell SceneShell] Nil
  (.focus (.-canvas shell) {:preventScroll true})
  (set! (.-textContent (element "selection"))
        "Arena focused. Keyboard input enters the resident Clause session.")
  nil)

(defn render-loop! [shell SceneShell] Nil
  (when @(.-alive shell)
    (let [canvas Any (.-canvas shell)
          presentation cinder/CinderwakePresentation (.-presentation shell)
          now Float (.now Date)
          time Float (/ now 1000.0)
          width Int (max 1 (browser-int (.-clientWidth canvas)))
          height Int (max 1 (browser-int (.-clientHeight canvas)))]
      (cinder/render-presentation-frame!
       presentation time width height)
      (set! (.-gameCameraX (.-dataset (.-body document)))
            (str (.-x (.-position (.-camera presentation)))))
      (set! (.-gameCameraY (.-dataset (.-body document)))
            (str (.-y (.-position (.-camera presentation)))))
      (set! (.-gameCameraZ (.-dataset (.-body document)))
            (str (.-z (.-position (.-camera presentation)))))
      (set! (.-gameCameraTargetX (.-dataset (.-body document)))
            (str @(.-cameraTargetX presentation)))
      (set! (.-gameCameraTargetY (.-dataset (.-body document)))
            (str @(.-cameraTargetY presentation)))
      (set! (.-gameCameraTargetZ (.-dataset (.-body document)))
            (str @(.-cameraTargetZ presentation)))
      (set! (.-gameCameraLookX (.-dataset (.-body document)))
            (str @(.-cameraFollowX presentation)))
      (set! (.-gameCameraLookY (.-dataset (.-body document)))
            (str (+ @(.-cameraFollowY presentation) 0.45)))
      (set! (.-gameCameraLookZ (.-dataset (.-body document)))
            (str @(.-cameraFollowZ presentation))))
    (reset! (.-frameHandle shell)
            (browser-int
             (requestAnimationFrame (fn [] Any (render-loop! shell))))))
  nil)

(defn create-scene! [] SceneShell
  (let [pixel-ratio Float (.-devicePixelRatio window)
        presentation cinder/CinderwakePresentation (cinder/create-cinderwake-presentation!
         (cinder/->CinderwakeSubjectIds
          "ashen-wayfarer" "cinder-wraith" "cinder-bolt" "ashen-key" "moonwell")
         (max 1.0 (min 2.0 pixel-ratio)))
        canvas Any (.-domElement (.-renderer presentation))
        frame (Atom Int) (atom 0)
        alive (Atom Bool) (atom true)
        shell-holder (Atom Any) (atom nil)
        pointer-handler Any (fn [event Any] Any (focus-scene! @shell-holder))
        shell SceneShell (->SceneShell
                          presentation canvas frame alive pointer-handler)]
    (reset! shell-holder shell)
    (set! (.-id canvas) "world-canvas")
    (set! (.-tabIndex canvas) 0)
    (.setAttribute canvas "aria-label" "Greywrought semantic world")
    (.prepend (element "world-wrap") canvas)
    (.addEventListener canvas "pointerdown" pointer-handler)
    (render-loop! shell)
    shell))

(defn stage-view [stage JourneyStage] StageView
  (match stage
    [(Dormant loaded)
     (->StageView
      "threshold" "Enter the pinned world. Nothing has executed yet."
      true false false false false false nil
      "Hidden until Admission." "No authoritative successor yet.")]
    [(Ready entered)
     (->StageView
      "authoritative · R0" "The wayfarer, wraith, key, and moonwell exist under the exact Clause program."
      false true false false false false nil
      "Hidden until Admission." "No authoritative successor yet.")]
    [(Disconnected process-branch)
     (->StageView
      "forked · tick 41" "The disconnected branch has exact ancestry and bounded authority. It is not world truth."
      false false true false false true nil
      "Hidden until Admission." "Branch ancestry retained; no successor yet.")]
    [(BranchAdvanced process-branch authoritative proposal)
     (->StageView
      "branch advanced" "Combat ran inside the isolated branch while the authoritative world advanced independently."
      false false false true false true nil
      "Hidden until Admission." "A branch result exists, but has not been submitted.")]
    [(CandidateSubmitted process-branch authoritative proposal)
     (let [candidate Any (.-candidate (.-evidence proposal))]
       (->StageView
        "candidate pending" "The Candidate Delta is visible as a sealed proposal only. Authoritative geometry is unchanged."
        false false false false true true
        (str "Pending CandidateDelta\n" (identity-string candidate))
        "Hidden until Admission." "Awaiting explicit authoritative adjudication."))]
    [(SuccessorAdmitted process-branch admitted explanation projection)
     (->StageView
      "admitted successor" "Admission replayed the branch against the current authority and established a new revision."
      false false false false false true nil
      (.stringify JSON projection nil 2)
      (.stringify JSON explanation nil 2))]))

(defn set-disabled!
  [id String
   disabled Bool] Nil
  (do (set! (.-disabled (element id)) disabled) nil))

(defn render-stage! [app PlayApp] Nil
  (let [view StageView (stage-view @(.-stage app))]
    (set! (.-textContent (element "stage")) (.-label view))
    (set! (.-textContent (element "summary")) (.-summary view))
    (set-disabled! "enter-world" (not (.-canEnter view)))
    (set-disabled! "disconnect" (not (.-canDisconnect view)))
    (set-disabled! "continue-branch" (not (.-canAdvance view)))
    (set-disabled! "submit-candidate" (not (.-canSubmit view)))
    (set-disabled! "admit-candidate" (not (.-canAdmit view)))
    (.toggle (.-classList (element "branch-label")) "visible" (.-branchVisible view))
    (let [candidate Any (element "candidate")]
      (.toggle (.-classList candidate) "visible" (not (nil? (.-candidateText view))))
      (set! (.-textContent candidate) (or (.-candidateText view) "")))
    (set! (.-textContent (element "projection")) (.-projectionText view))
    (set! (.-textContent (element "explanation")) (.-explanationText view))
    (set! (.-journey (.-dataset (.-body document))) (.-label view))
    nil))

(defn enter-world! [app PlayApp] Nil
  (match @(.-stage app)
    [(Dormant loaded) (reset! (.-stage app) (->Ready true))]
    [(Ready entered) nil]
    [(Disconnected value) nil]
    [(BranchAdvanced value authoritative proposal) nil]
    [(CandidateSubmitted value authoritative proposal) nil]
    [(SuccessorAdmitted value admitted explanation projection) nil])
  (render-stage! app))

(defn disconnect! [app PlayApp] Nil
  (match @(.-stage app)
    [(Dormant loaded) nil]
    [(Ready entered)
     (let [world-shift Any (nth (.-occurrences app) 0)
           process-branch branch/WasmProcessBranch (branch/open-process-branch!
            (.-module app) (.-branchRequest app) 41 world-shift 8)]
       (reset! (.-stage app) (->Disconnected process-branch)))]
    [(Disconnected value) nil]
    [(BranchAdvanced value authoritative proposal) nil]
    [(CandidateSubmitted value authoritative proposal) nil]
    [(SuccessorAdmitted value admitted explanation projection) nil])
  (render-stage! app))

(defn advance-branch! [app PlayApp] Nil
  (match @(.-stage app)
    [(Dormant loaded) nil]
    [(Ready entered) nil]
    [(Disconnected process-branch)
     (let [world-shift Any (nth (.-occurrences app) 0)
           combat Any (.slice (.-occurrences app) 1)
           authoritative Any (branch/admit-authoritative-occurrences!
                              (.-module app) process-branch [world-shift])
           proposal Any (branch/propose-branch-reconnect!
                         (.-module app) process-branch combat)]
       (reset! (.-stage app)
               (->BranchAdvanced process-branch authoritative proposal)))]
    [(BranchAdvanced value authoritative proposal) nil]
    [(CandidateSubmitted value authoritative proposal) nil]
    [(SuccessorAdmitted value admitted explanation projection) nil])
  (render-stage! app))

(defn submit-candidate! [app PlayApp] Nil
  (match @(.-stage app)
    [(Dormant loaded) nil]
    [(Ready entered) nil]
    [(Disconnected value) nil]
    [(BranchAdvanced process-branch authoritative proposal)
     (reset! (.-stage app)
             (->CandidateSubmitted process-branch authoritative proposal))]
    [(CandidateSubmitted value authoritative proposal) nil]
    [(SuccessorAdmitted value admitted explanation projection) nil])
  (render-stage! app))

(defn admit-candidate! [app PlayApp] Nil
  (match @(.-stage app)
    [(Dormant loaded) nil]
    [(Ready entered) nil]
    [(Disconnected value) nil]
    [(BranchAdvanced value authoritative proposal) nil]
    [(CandidateSubmitted process-branch authoritative proposal)
     (let [combat Any (.slice (.-occurrences app) 1)
           r1 Any (.-successor authoritative)
           admitted Any (branch/adjudicate-branch-reconnect!
                          (.-module app) process-branch proposal r1 combat)
           explanation Any (.-explanation
                            (branch/explain-process-branch!
                             (.-module app) process-branch))
           projection Any (wasm/decode-projected-term-frame
                           (.-termBytes (.-projection admitted)))]
       (reset! (.-stage app)
               (->SuccessorAdmitted
                process-branch admitted explanation projection)))]
    [(SuccessorAdmitted value admitted explanation projection) nil])
  (render-stage! app))

(defn pulse-moonwell! [app PlayApp] Nil
  (when-not @(.-effectSettled app)
    (let [session Any (.-session (.-effect app))
          module Any (.-module app)
          first Any (wasm/advance-session-occurrence! module session 0)
          suspension Any (wasm/suspend-session! module session)
          resumption Any (wasm/resume-session! module session)
          second Any (wasm/advance-session-occurrence! module session 1)
          intent Any (wasm/emit-effect-intent! module session)
          issued Any (wasm/issue-effect-authorization!
                      module session (.-intentId intent))
          attempt Any (wasm/begin-effect-attempt!
                       module session (.-authorizationId issued))
          key String "greywrought/moonwell-receipt-v1"
          payload String (.stringify JSON (.-payloadBytes attempt))]
      (.setItem localStorage key payload)
      (let [receipt Any (.parse JSON (.getItem localStorage key))
            settled Any (wasm/settle-effect-attempt!
                         module session (.-attemptId attempt) 0 receipt)]
        (reset! (.-effectSettled app) true)
        (set! (.-disabled (element "pulse-moonwell")) true)
        (set! (.-textContent (element "effect"))
              (str "Activation " (identity-string (.-activation intent))
                   "\nIntent " (identity-string (.-intentId intent))
                   "\nAttempt " (identity-string (.-attemptId attempt))
                   "\nReceipt " (identity-string (.-receiptId settled))
                   "\nObservation " (identity-string (.-observationId settled))
                   "\nJudgment " (identity-string (.-judgmentId settled))
                   "\nState revisions before/after: "
                   (str (.-stateRevisionCount intent)) "/"
                   (str (.-stateRevisionCount settled))
                   "\nContinuation retained: "
                   (= (identity-string (.-continuation suspension))
                      (identity-string (.-continuation resumption)))
                   "\nSteps observed: " (str (.-kind first)) ", " (str (.-kind second)))))))
  nil)

(defn bind-click!
  [listeners (Vec Any)
   id String
   action Any] Nil
  (let [target Any (element id)
        handler Any (fn [event Any] Any (action))]
    (.addEventListener target "click" handler)
    (.push listeners [target "click" handler])
    nil))

(defn physical-key-envelope
  [event Any
   phase String] Any
  (workbench/create-workbench-envelope
   (resident-policy)
   (.stringify JSON
               [(.stringify JSON {:kind "keyboard"
                                  :code (.-code event)
                                  :phase phase
                                  :repeat (.-repeat event)})])))

(defn observe-game-key!
  [app PlayApp
   event Any
   phase String] Nil
  (let [controller Any @(.-controller (.-residentLaw app))]
    (when-not (nil? controller)
      ((.-observeInput controller) (physical-key-envelope event phase))))
  nil)

(defn held-game-key? [code String] Bool
  (or (= code "KeyW")
      (= code "KeyA")
      (= code "KeyS")
      (= code "KeyD")
      (= code "ShiftLeft")
      (= code "ShiftRight")
      (= code "KeyE")))

(defn game-key? [code String] Bool
  (or (held-game-key? code)
      (= code "KeyQ")
      (= code "KeyF")
      (= code "Space")
      (= code "KeyR")))

(defn bind-game-input!
  [app PlayApp
   listeners (Vec Any)] Nil
  (let [canvas Any (.-canvas (.-scene app))
        down Any (fn [event Any] Any
                   (when (and (not (.-repeat event))
                              (game-key? (.-code event)))
                     (.preventDefault event)
                     (observe-game-key! app event "down")))
        up Any (fn [event Any] Any
                 (when (held-game-key? (.-code event))
                   (.preventDefault event)
                   (observe-game-key! app event "up")))]
    (.addEventListener canvas "keydown" down)
    (.addEventListener canvas "keyup" up)
    (.push listeners [canvas "keydown" down])
    (.push listeners [canvas "keyup" up]))
  nil)

(defn press-reset! [app PlayApp] Nil
  (let [event Any (.freeze Object {:code "KeyR" :repeat false})]
    (.focus (.-canvas (.-scene app)) {:preventScroll true})
    (observe-game-key! app event "down"))
  nil)

(defn poll-resident-law! [app PlayApp] Nil
  (let [resident ResidentLawSession (.-residentLaw app)]
    (when-not @(.-polling resident)
      (reset! (.-polling resident) true)
      (let [decoded Any (.then
             (fetch (str "/resident-generation?after="
                         (str @(.-generation resident)))
                    {:cache "no-store"})
             (fn [response Response] Any
               (if (= (.-status response) 204)
                 nil
                 (.then
                  (.json response)
                  (fn [payload Any] Any
                    (if (.-ok response)
                      payload
                      (throw (new Error
                                  (str "resident source rejected: "
                                       (.-errorHex payload))))))))))
            installed Any (.then decoded
                   (fn [payload Any] Any
                     (when-not (nil? payload)
                       (install-resident-law! app payload))))]
        (.then installed
               (fn [value Any] Any
                 (reset! (.-polling resident) false))
               (fn [error Any] Any
                 (resident-law-failure! (.-message error))
                 (reset! (.-polling resident) false))))))
  nil)

(defn teardown! [app PlayApp] Nil
  (clearInterval @(.-interval (.-residentLaw app)))
  (reset! (.-alive (.-scene app)) false)
  (cancelAnimationFrame @(.-frameHandle (.-scene app)))
  (.removeEventListener (.-canvas (.-scene app)) "pointerdown"
                        (.-pointerHandler (.-scene app)))
  (doseq [listener Any (.-listeners app)]
    (.removeEventListener (nth listener 0) (nth listener 1) (nth listener 2)))
  (cinder/dispose-cinderwake-presentation!
   (.-presentation (.-scene app)))
  (.remove (.-canvas (.-scene app)))
  (match @(.-stage app)
    [(Dormant loaded) nil]
    [(Ready entered) nil]
    [(Disconnected value) (branch/dispose-process-branch! (.-module app) value)]
    [(BranchAdvanced value authoritative proposal)
     (branch/dispose-process-branch! (.-module app) value)]
    [(CandidateSubmitted value authoritative proposal)
     (branch/dispose-process-branch! (.-module app) value)]
    [(SuccessorAdmitted value admitted explanation projection)
     (branch/dispose-process-branch! (.-module app) value)])
  ((.-disposeSession (.-port (.-effect app))) (.-session (.-effect app)))
  (let [controller Any @(.-controller (.-residentLaw app))]
    (when-not (nil? controller)
      ((.-dispose controller))))
  nil)

(defn run-smoke-if-requested! [app PlayApp] Nil
  (let [parameters Any (new URLSearchParams (.-search (.-location window)))]
    (when (= (.get parameters "smoke") "1")
      (doseq [id String ["enter-world"
                         "disconnect"
                         "continue-branch"
                         "submit-candidate"
                         "admit-candidate"
                         "pulse-moonwell"]]
        (.click (element id)))
      (set! (.-smoke (.-dataset (.-body document)))
            (if (and (= (.-journey (.-dataset (.-body document)))
                        "admitted successor")
                     @(.-effectSettled app))
              "passed"
              "failed")))
    nil))

(defn start-app!
  [module Any
   branch-source String
   effect-source String] PlayApp
  (let [branch-request wasm/ExactProcessRequest (wasm/->ExactProcessRequest (wasm/decode-cwr1-hex branch-source))
        occurrences (Vec Any) (wasm/process-request-occurrences! branch-request)
        effect-request wasm/ExactProcessRequest (wasm/->ExactProcessRequest (wasm/decode-cwr1-hex effect-source))
        effect EffectSession (open-effect-session! module effect-request)
        resident-law ResidentLawSession (open-resident-law-session! module)
        scene SceneShell (create-scene!)
        listeners (Vec Any) []
        app PlayApp (->PlayApp module branch-request occurrences effect resident-law
                               (atom (->Dormant true)) (atom false) scene listeners)]
    (set! (.-__GREYWROUGHT_RESIDENT_EVENTS__ window) [])
    (set! (.-__GREYWROUGHT_GAME_EVENTS__ window) [])
    (bind-game-input! app listeners)
    (bind-click! listeners "reset-encounter" (fn [] Any (press-reset! app)))
    (bind-click! listeners "enter-world" (fn [] Any (enter-world! app)))
    (bind-click! listeners "disconnect" (fn [] Any (disconnect! app)))
    (bind-click! listeners "continue-branch" (fn [] Any (advance-branch! app)))
    (bind-click! listeners "submit-candidate" (fn [] Any (submit-candidate! app)))
    (bind-click! listeners "admit-candidate" (fn [] Any (admit-candidate! app)))
    (bind-click! listeners "pulse-moonwell" (fn [] Any (pulse-moonwell! app)))
    (render-stage! app)
    (.addEventListener window "beforeunload" (fn [event Any] Any (teardown! app))
                       {:once true})
    (set! (.-__GREYWROUGHT_TEARDOWN__ window) (fn [] Any (teardown! app)))
    (poll-resident-law! app)
    (reset! (.-interval resident-law)
            (browser-int
             (setInterval (fn [] Any (poll-resident-law! app)) 25)))
    (run-smoke-if-requested! app)
    app))

(.then
 (.all Promise [(.then (fetch "/wasm/clause_runtime_bg.wasm")
                       (fn [response Response] (Promise ArrayBuffer)
                         (.arrayBuffer response)))
                (.then (fetch "/assets/conquest-v1.cwr1.hex")
                       (fn [response Response] (Promise String)
                         (.text response)))
                (.then (fetch "/assets/ongoing-effect-v1.cwr1.hex")
                       (fn [response Response] (Promise String)
                         (.text response)))])
 (fn [assets Any] Any
   (start-app! (initialize-runtime (nth assets 0))
               (nth assets 1)
               (nth assets 2))))
