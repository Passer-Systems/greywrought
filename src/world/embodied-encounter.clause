F64
Bool
Text
Controller
Unit
UnitClass

shape Vec3
  x: F64
  y: F64
  z: F64

relation clamped-between
  reads {value: F64} clamped between {lower: F64} and {upper: F64} as {result: F64}
  mode given value lower upper yields result: maybe

relation order-target
  reads {controller: Controller} order target {value: Vec3}
  subject controller
  mode given controller yields value: one

relation unit-name
  reads {unit: Unit} unit name {value: Text}
  subject unit
  mode given unit yields value: one

relation unit-class
  reads {unit: Unit} unit class {value: UnitClass}
  subject unit
  mode given unit yields value: one

relation class-name
  reads {class: UnitClass} class name {value: Text}
  subject class
  mode given class yields value: one

relation class-role
  reads {class: UnitClass} class role {value: Text}
  subject class
  mode given class yields value: one

relation unit-position
  reads {unit: Unit} unit position {value: Vec3}
  subject unit
  mode given unit yields value: one

relation unit-destination
  reads {unit: Unit} unit destination {value: Vec3}
  subject unit
  mode given unit yields value: one

relation formation-offset
  reads {unit: Unit} formation offset {value: Vec3}
  subject unit
  mode given unit yields value: one

relation movement-speed
  reads {unit: Unit} movement speed {value: F64}
  subject unit
  mode given unit yields value: one

relation selected
  reads {unit: Unit} selected {value: Bool}
  subject unit
  mode given unit yields value: one

relation moving
  reads {unit: Unit} moving {value: Bool}
  subject unit
  mode given unit yields value: one

relation vitality
  reads {unit: Unit} vitality {value: Vec3}
  subject unit
  mode given unit yields value: one

law clamp-lower
  if
    ?lower <= ?upper
    ?value < ?lower
  then
    ?value clamped between ?lower and ?upper as ?lower

law clamp-interior
  if
    ?lower <= ?value
    ?value <= ?upper
  then
    ?value clamped between ?lower and ?upper as ?value

law clamp-upper
  if
    ?lower <= ?upper
    ?value > ?upper
  then
    ?value clamped between ?lower and ?upper as ?upper

derive clamp-lower
derive clamp-interior
derive clamp-upper

player-1
  shape: Controller
warrior-1
  shape: Unit
artificer-1
  shape: Unit
rogue-1
  shape: Unit
priest-1
  shape: Unit
ranger-1
  shape: Unit
warrior-class
  shape: UnitClass
artificer-class
  shape: UnitClass
rogue-class
  shape: UnitClass
priest-class
  shape: UnitClass
ranger-class
  shape: UnitClass

player-1 order target Vec3 { x: 0.0, y: 0.0, z: 0.0 }

warrior-class class name "Warrior"
warrior-class class role "Front-line defender"
artificer-class class name "Artificer"
artificer-class class role "Magitek support"
rogue-class class name "Rogue"
rogue-class class role "Mobile striker"
priest-class class name "Priest"
priest-class class role "Restoration and wards"
ranger-class class name "Ranger"
ranger-class class role "Ranged pressure"

warrior-1 unit name "Aldric"
warrior-1 unit class warrior-class
warrior-1 unit position Vec3 { x: -2.0, y: 0.0, z: 1.0 }
warrior-1 unit destination Vec3 { x: -2.0, y: 0.0, z: 1.0 }
warrior-1 formation offset Vec3 { x: -2.0, y: 0.0, z: -1.0 }
warrior-1 movement speed 5.0
warrior-1 selected true
warrior-1 moving false
warrior-1 vitality Vec3 { x: 160.0, y: 160.0, z: 0.0 }

artificer-1 unit name "Cora"
artificer-1 unit class artificer-class
artificer-1 unit position Vec3 { x: 0.0, y: 0.0, z: 1.0 }
artificer-1 unit destination Vec3 { x: 0.0, y: 0.0, z: 1.0 }
artificer-1 formation offset Vec3 { x: 0.0, y: 0.0, z: -1.0 }
artificer-1 movement speed 4.3
artificer-1 selected true
artificer-1 moving false
artificer-1 vitality Vec3 { x: 105.0, y: 105.0, z: 0.0 }

rogue-1 unit name "Vey"
rogue-1 unit class rogue-class
rogue-1 unit position Vec3 { x: 2.0, y: 0.0, z: 1.0 }
rogue-1 unit destination Vec3 { x: 2.0, y: 0.0, z: 1.0 }
rogue-1 formation offset Vec3 { x: 2.0, y: 0.0, z: -1.0 }
rogue-1 movement speed 5.7
rogue-1 selected true
rogue-1 moving false
rogue-1 vitality Vec3 { x: 95.0, y: 95.0, z: 0.0 }

priest-1 unit name "Mara"
priest-1 unit class priest-class
priest-1 unit position Vec3 { x: -1.0, y: 0.0, z: 3.0 }
priest-1 unit destination Vec3 { x: -1.0, y: 0.0, z: 3.0 }
priest-1 formation offset Vec3 { x: -1.0, y: 0.0, z: 1.0 }
priest-1 movement speed 4.2
priest-1 selected true
priest-1 moving false
priest-1 vitality Vec3 { x: 90.0, y: 90.0, z: 0.0 }

ranger-1 unit name "Rowan"
ranger-1 unit class ranger-class
ranger-1 unit position Vec3 { x: 1.0, y: 0.0, z: 3.0 }
ranger-1 unit destination Vec3 { x: 1.0, y: 0.0, z: 3.0 }
ranger-1 formation offset Vec3 { x: 1.0, y: 0.0, z: 1.0 }
ranger-1 movement speed 4.8
ranger-1 selected true
ranger-1 moving false
ranger-1 vitality Vec3 { x: 100.0, y: 100.0, z: 0.0 }

bind scalar-input PointerWorldX to observe-order-x
bind scalar-input PointerWorldZ to observe-order-z
bind keyboard ClearSelection down to clear-selection
bind keyboard SelectAll down to select-all
bind referent-input Pick as Unit to select-unit
bind keyboard IssueMove down to issue-move

on observe-order-x ?controller ?x
  when
    ?controller order target Vec3 { x: ?prior-x, y: ?y, z: ?z }
  withdraw
    ?controller order target Vec3 { x: ?prior-x, y: ?y, z: ?z }
  include
    ?controller order target Vec3 { x: ?x, y: ?y, z: ?z }

on observe-order-z ?controller ?z
  when
    ?controller order target Vec3 { x: ?x, y: ?y, z: ?prior-z }
  withdraw
    ?controller order target Vec3 { x: ?x, y: ?y, z: ?prior-z }
  include
    ?controller order target Vec3 { x: ?x, y: ?y, z: ?z }

on clear-selection ?unit
  when
    ?unit selected ?was-selected
  withdraw
    ?unit selected ?was-selected
  include
    ?unit selected false

on select-all ?unit
  when
    ?unit selected ?was-selected
  withdraw
    ?unit selected ?was-selected
  include
    ?unit selected true

on select-unit ?unit ?target
  when
    ?unit selected ?was-selected
    ?unit = ?target
  withdraw
    ?unit selected ?was-selected
  include
    ?unit selected true

on issue-move ?unit
  when
    player-1 order target Vec3 { x: ?target-x, y: ?target-y, z: ?target-z }
    ?unit selected ?is-selected
    ?unit formation offset Vec3 { x: ?offset-x, y: ?offset-y, z: ?offset-z }
    ?unit unit destination ?prior-destination
    ?unit moving ?was-moving
    ?is-selected = true
  withdraw
    ?unit unit destination ?prior-destination
    ?unit moving ?was-moving
  include
    ?unit unit destination Vec3 { x: ?target-x + ?offset-x, y: 0.0, z: ?target-z + ?offset-z }
    ?unit moving true

on tick ?unit ?dt
  when
    ?dt > 0.0
    ?unit unit position Vec3 { x: ?x, y: ?y, z: ?z }
    ?unit unit destination Vec3 { x: ?destination-x, y: ?destination-y, z: ?destination-z }
    ?unit movement speed ?speed
    ?unit moving ?is-moving
    (?destination-x - ?x) * (?destination-x - ?x) + (?destination-z - ?z) * (?destination-z - ?z) > 0.0001
    (?destination-x - ?x) clamped between 0.0 - (?speed * ?dt) and ?speed * ?dt as ?step-x
    (?destination-z - ?z) clamped between 0.0 - (?speed * ?dt) and ?speed * ?dt as ?step-z
    ?is-moving = true
  withdraw
    ?unit unit position Vec3 { x: ?x, y: ?y, z: ?z }
  include
    ?unit unit position Vec3 { x: ?x + ?step-x, y: 0.0, z: ?z + ?step-z }

on tick ?unit ?dt
  when
    ?unit unit position Vec3 { x: ?x, y: ?y, z: ?z }
    ?unit unit destination Vec3 { x: ?destination-x, y: ?destination-y, z: ?destination-z }
    ?unit moving ?is-moving
    (?destination-x - ?x) * (?destination-x - ?x) + (?destination-z - ?z) * (?destination-z - ?z) <= 0.0001
    ?is-moving = true
  withdraw
    ?unit moving ?is-moving
  include
    ?unit moving false
