Vec3:
  x: F64
  y: F64
  z: F64

clamped-between:
  ?value shape F64
  ?lower shape F64
  ?upper shape F64
  ?result shape F64
  ?value clamped between ?lower and ?upper as ?result

mode clamped-between given value lower upper yields result: maybe

damage-after-ward:
  ?incoming shape F64
  ?remaining shape F64
  ?result shape F64
  ?incoming damage after ward ?remaining as ?result

mode damage-after-ward given incoming remaining yields result: maybe

order-readiness:
  ?active shape Bool
  ?selected shape Bool
  ?alive shape Bool
  ?health shape F64
  ?capable shape Bool
  ?kind shape Bool
  ?targetAlive shape Bool
  ?needed shape Bool
  ?inRange shape Bool
  ?cooldown shape F64
  ?message shape Text
  order active ?active selected ?selected alive ?alive health ?health capable ?capable kind ?kind targetAlive ?targetAlive needed ?needed inRange ?inRange cooldown ?cooldown reports ?message

mode order-readiness given active selected alive health capable kind targetAlive needed inRange cooldown yields message: maybe

hostile-order-readiness:
  ?active shape Bool
  ?selected shape Bool
  ?alive shape Bool
  ?health shape F64
  ?capable shape Bool
  ?hostile shape Bool
  ?targetHealth shape F64
  ?unitX shape F64
  ?unitZ shape F64
  ?targetX shape F64
  ?targetZ shape F64
  ?range shape F64
  ?cooldown shape F64
  ?message shape Text
  hostile order active ?active selected ?selected alive ?alive health ?health capable ?capable hostile ?hostile targetHealth ?targetHealth from ?unitX ?unitZ to ?targetX ?targetZ range ?range cooldown ?cooldown reports ?message

mode hostile-order-readiness given active selected alive health capable hostile targetHealth unitX unitZ targetX targetZ range cooldown yields message: maybe

destination-readiness:
  ?blockers shape F64
  ?terrain shape Bool
  ?obstacles shape F64
  ?message shape Text
  destination with ?blockers blockers terrain ?terrain obstacles ?obstacles reports ?message

mode destination-readiness given blockers terrain obstacles yields message: maybe

battlefield-size:
  ?field shape Battlefield
  ?value shape F64
  ?field:
    half width: ?value

mode battlefield-size given field yields value: one

obstacle-position:
  ?obstacle shape Obstacle
  ?value shape Vec3
  ?obstacle:
    obstacle position: ?value

mode obstacle-position given obstacle yields value: one

obstacle-radius:
