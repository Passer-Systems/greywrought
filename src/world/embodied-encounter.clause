referent F64
referent Bool
referent Player
referent Arena
referent Enemy
referent Projectile
referent Loot
referent Custodian
referent CombatStatus
referent ProjectileState
referent StatusEffect
referent LootState
referent Objective
referent ObjectiveState

referent alive
referent dead
referent hidden
referent available
referent acquired
referent playing
referent completed
referent failed
referent approach
referent telegraph
referent lunge
referent recovery
referent rearming
referent charging
referent hit-recovery
referent overrun-recovery
referent ready
referent queued
referent active
referent cooling
referent recovering
referent dormant
referent flight
referent spent
referent clear
referent ember-mark
referent burning

shape Vec3
  x: F64
  y: F64
  z: F64

relation clamped-between
  reads {value: F64} clamped between {lower: F64} and {upper: F64} as {result: F64}
  mode given value lower upper yields result: maybe

relation position
  reads {player: Player} position {value: Vec3}
  subject player
  mode given player yields value: one

relation velocity
  reads {player: Player} velocity {value: Vec3}
  subject player
  mode given player yields value: one

relation grounded
  reads {player: Player} grounded {value: Bool}
  subject player
  mode given player yields value: one

relation horizontal-intent
  reads {player: Player} horizontal intent {value: Vec3}
  subject player
  mode given player yields value: one

relation camera-forward
  reads {player: Player} camera forward {value: Vec3}
  subject player
  mode given player yields value: one

relation gravity
  reads {arena: Arena} gravity {value: F64}
  subject arena
  mode given arena yields value: one

relation jump-speed
  reads {arena: Arena} jump speed {value: F64}
  subject arena
  mode given arena yields value: one

relation melee-range
