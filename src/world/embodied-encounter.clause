F64
Bool
Text
Controller
Unit
UnitClass
Actor
Enemy
Objective
Encounter
EncounterState
CombatRules

shape Vec3
  x: F64
  y: F64
  z: F64

relation clamped-between
  reads {value: F64} clamped between {lower: F64} and {upper: F64} as {result: F64}
  mode given value lower upper yields result: maybe
relation damage-after-ward
  reads {incoming: F64} damage after ward {remaining: F64} as {result: F64}
  mode given incoming remaining yields result: maybe
relation order-target
  reads {controller: Controller} order target {value: Vec3}
  subject controller
  mode given controller yields value: one
relation chosen-target
  reads {controller: Controller} chosen target {value: Actor}
  subject controller
  mode given controller yields value: one
relation unit-class
  reads {unit: Unit} unit class {value: UnitClass}
  subject unit
  mode given unit yields value: one
relation class-name
  reads {class: UnitClass} class name {value: Text}
  subject class
  mode given class yields value: one
relation class-role
  reads {class: UnitClass} class role {value: Text}
  subject class
  mode given class yields value: one
relation actor-name
  reads {actor: Actor} actor name {value: Text}
  subject actor
  mode given actor yields value: one
relation presentation-kind
  reads {actor: Actor} presentation kind {value: Text}
  subject actor
  mode given actor yields value: one
relation actor-position
  reads {actor: Actor} actor position {value: Vec3}
  subject actor
  mode given actor yields value: one
relation unit-destination
  reads {unit: Unit} unit destination {value: Vec3}
  subject unit
  mode given unit yields value: one
relation formation-offset
  reads {unit: Unit} formation offset {value: Vec3}
  subject unit
  mode given unit yields value: one
relation movement-speed
  reads {unit: Unit} movement speed {value: F64}
  subject unit
  mode given unit yields value: one
relation selected
  reads {unit: Unit} selected {value: Bool}
  subject unit
  mode given unit yields value: one
relation moving
  reads {unit: Unit} moving {value: Bool}
  subject unit
  mode given unit yields value: one
relation hostile
  reads {actor: Actor} hostile {value: Bool}
  subject actor
  mode given actor yields value: one
relation vitality
  reads {actor: Actor} vitality {value: F64}
  subject actor
  mode given actor yields value: one
relation alive
  reads {actor: Actor} alive {value: Bool}
  subject actor
  mode given actor yields value: one
relation maximum-vitality
  reads {actor: Actor} maximum vitality {value: F64}
  subject actor
  mode given actor yields value: one
relation ward-remaining
  reads {actor: Actor} ward remaining {value: F64}
  subject actor
  mode given actor yields value: one
relation burn-remaining
  reads {actor: Actor} burn remaining {value: F64}
  subject actor
  mode given actor yields value: one
relation attack-damage
  reads {unit: Unit} attack damage {value: F64}
  subject unit
  mode given unit yields value: one
relation attack-range
  reads {unit: Unit} attack range {value: F64}
  subject unit
  mode given unit yields value: one
relation healing-power
  reads {unit: Unit} healing power {value: F64}
  subject unit
  mode given unit yields value: one
relation ward-duration
  reads {unit: Unit} ward duration {value: F64}
  subject unit
  mode given unit yields value: one
relation action-cooldown
  reads {unit: Unit} action cooldown {value: F64}
  subject unit
  mode given unit yields value: one
relation action-period
  reads {unit: Unit} action period {value: F64}
  subject unit
  mode given unit yields value: one
relation enemy-target
  reads {enemy: Enemy} enemy target {value: Actor}
  subject enemy
  mode given enemy yields value: one
relation enemy-damage
  reads {enemy: Enemy} enemy damage {value: F64}
  subject enemy
  mode given enemy yields value: one
relation enemy-range
  reads {enemy: Enemy} enemy range {value: F64}
  subject enemy
  mode given enemy yields value: one
relation enemy-cooldown
  reads {enemy: Enemy} enemy cooldown {value: F64}
  subject enemy
  mode given enemy yields value: one
relation enemy-period
  reads {enemy: Enemy} enemy period {value: F64}
  subject enemy
  mode given enemy yields value: one
relation enemy-burn-duration
  reads {enemy: Enemy} enemy burn duration {value: F64}
  subject enemy
  mode given enemy yields value: one
relation encounter-state
  reads {encounter: Encounter} encounter state {value: EncounterState}
  subject encounter
  mode given encounter yields value: one
relation state-name
  reads {state: EncounterState} state name {value: Text}
  subject state
  mode given state yields value: one
relation burn-damage
  reads {rules: CombatRules} burn damage {value: F64}
  subject rules
  mode given rules yields value: one

law clamp-lower
  if
    ?lower <= ?upper
    ?value < ?lower
  then
    ?value clamped between ?lower and ?upper as ?lower
law clamp-interior
  if
    ?lower <= ?value
    ?value <= ?upper
  then
    ?value clamped between ?lower and ?upper as ?value
law clamp-upper
  if
    ?lower <= ?upper
    ?value > ?upper
  then
    ?value clamped between ?lower and ?upper as ?upper
law full-damage
  if
    ?remaining <= 0.0
  then
    ?incoming damage after ward ?remaining as ?incoming
law warded-damage
  if
    ?remaining > 0.0
  then
    ?incoming damage after ward ?remaining as ?incoming * 0.5
derive clamp-lower
derive clamp-interior
derive clamp-upper
derive full-damage
derive warded-damage

player-1
