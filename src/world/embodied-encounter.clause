law clamp-lower
  if
    ?lower <= ?upper
    ?value < ?lower
  then
    ?value clamped between ?lower and ?upper as ?lower

law clamp-interior
  if
    ?lower <= ?value
    ?value <= ?upper
  then
    ?value clamped between ?lower and ?upper as ?value

law clamp-upper
  if
    ?lower <= ?upper
    ?value > ?upper
  then
    ?value clamped between ?lower and ?upper as ?upper

law projectile-contact-within-radius
  if
    ?player position Vec3 { x: ?player-x, y: ?player-y, z: ?player-z }
    ?projectile projectile position Vec3 { x: ?projectile-x, y: ?projectile-y, z: ?projectile-z }
    ?projectile projectile state ?projectile-state
    ?projectile projectile faction enemy-origin
    jump-arena projectile contact radius ?contact-radius
    ?projectile-state = flight
    ((?player-x - ?projectile-x) * (?player-x - ?projectile-x)) + ((?player-z - ?projectile-z) * (?player-z - ?projectile-z)) <= ?contact-radius * ?contact-radius
  then
    ?player has hostile projectile contact true

law shield-projectile-contact-within-radius
  if
    ?player position Vec3 { x: ?player-x, y: ?player-y, z: ?player-z }
    ?player shield active factor ?active
    ?player shield energy ?energy
    ?projectile projectile position Vec3 { x: ?projectile-x, y: ?projectile-y, z: ?projectile-z }
    ?projectile projectile state ?projectile-state
    ?projectile projectile faction enemy-origin
    jump-arena shield radius per energy ?radius-per-energy
    jump-arena shield protection threshold ?protection-threshold
    ?active = 1.0
    ?energy >= ?protection-threshold
    ?projectile-state = flight
    ((?player-x - ?projectile-x) * (?player-x - ?projectile-x)) + ((?player-z - ?projectile-z) * (?player-z - ?projectile-z)) <= (?energy * ?radius-per-energy) * (?energy * ?radius-per-energy)
  then
    ?player has shield projectile contact true

law charging-enemy-visible-shield-contact
  if
    ?enemy enemy pressure state ?pressure
    ?enemy enemy position Vec3 { x: ?enemy-x, y: ?enemy-y, z: ?enemy-z }
    ?player position Vec3 { x: ?player-x, y: ?player-y, z: ?player-z }
    ?player shield active factor ?shield-active
    ?player shield energy ?shield-energy
    ?pressure = charging
    ?shield-active = 1.0
    ?shield-energy >= 42.0
    ((?player-x - ?enemy-x) * (?player-x - ?enemy-x)) + ((?player-z - ?enemy-z) * (?player-z - ?enemy-z)) <= (?shield-energy * 0.018) * (?shield-energy * 0.018)
  then
    ?enemy has visible shield contact true

law enemy-projectile-contact-within-radius
  if
    ?enemy enemy position Vec3 { x: ?enemy-x, y: ?enemy-y, z: ?enemy-z }
    ?projectile projectile position Vec3 { x: ?projectile-x, y: ?projectile-y, z: ?projectile-z }
    ?projectile projectile state ?projectile-state
    ?projectile projectile faction player-origin
    jump-arena projectile contact radius ?contact-radius
    ?projectile-state = flight
    ((?enemy-x - ?projectile-x) * (?enemy-x - ?projectile-x)) + ((?enemy-z - ?projectile-z) * (?enemy-z - ?projectile-z)) <= ?contact-radius * ?contact-radius
  then
    ?enemy has player projectile contact true

derive clamp-lower
derive clamp-interior
derive clamp-upper
derive projectile-contact-within-radius
derive shield-projectile-contact-within-radius
derive charging-enemy-visible-shield-contact
derive enemy-projectile-contact-within-radius

