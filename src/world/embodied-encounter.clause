bind keyboard KeyW down to hold-forward
bind keyboard KeyW up to release-forward
bind keyboard KeyS down to hold-backward
bind keyboard KeyS up to release-backward
bind keyboard KeyA down to hold-left
bind keyboard KeyA up to release-left
bind keyboard KeyD down to hold-right
bind keyboard KeyD up to release-right
bind keyboard ShiftLeft down to enable-horizontal-sustain
bind keyboard ShiftLeft up to disable-horizontal-sustain
bind keyboard ShiftRight down to enable-horizontal-sustain
bind keyboard ShiftRight up to disable-horizontal-sustain
bind keyboard KeyQ down to horizontal-burst
bind keyboard KeyE down to pulse-shield
bind keyboard KeyE up to release-shield
bind keyboard Space down to jump-or-air-boost
bind keyboard Space up to disable-air-sustain
bind keyboard F1 down to select-warrior
bind keyboard F2 down to select-mage
bind keyboard F3 down to select-hunter
bind keyboard Digit1 down to primary-ability
bind keyboard Digit2 down to secondary-ability
bind keyboard Digit3 down to third-ability
bind keyboard Digit4 down to fourth-ability
bind keyboard Digit5 down to fifth-ability
bind keyboard KeyR down to class-utility
bind keyboard ShiftR down to reset-objective
bind keyboard Tab down to target-next-enemy
bind keyboard ShiftTab down to target-previous-enemy
bind keyboard LootItem down to acquire-loot
bind scalar-input CameraForwardX to observe-camera-forward-x
bind scalar-input CameraForwardZ to observe-camera-forward-z
bind scalar-input PersistedFootholdProgress to restore-partial-foothold-progress
bind scalar-input PersistedPermanentFootholdProgress to restore-permanent-foothold-progress

on select-warrior ?player
  when
    ?player target lock active ?target-active
    ?player character archetype ?prior
    ?player class resource ?resource
    ?player ability cooldowns ?cooldowns
    ?player utility cooldowns ?utility-cooldowns
    ?player last ability ?last
    ?player selection sequence ?sequence
  withdraw
    ?player target lock active ?target-active
    ?player character archetype ?prior
    ?player class resource ?resource
    ?player ability cooldowns ?cooldowns
    ?player utility cooldowns ?utility-cooldowns
    ?player last ability ?last
    ?player selection sequence ?sequence
  include
    ?player target lock active true
    ?player character archetype warrior
    ?player class resource Vec3 { x: 0.0, y: 100.0, z: 0.0 }
    ?player ability cooldowns Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    ?player utility cooldowns Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    ?player last ability battle-shout
    ?player selection sequence ?sequence + 1.0

on select-mage ?player
  when
    ?player target lock active ?target-active
    ?player character archetype ?prior
    ?player class resource ?resource
    ?player ability cooldowns ?cooldowns
    ?player utility cooldowns ?utility-cooldowns
    ?player last ability ?last
    ?player selection sequence ?sequence
  withdraw
    ?player target lock active ?target-active
    ?player character archetype ?prior
    ?player class resource ?resource
    ?player ability cooldowns ?cooldowns
    ?player utility cooldowns ?utility-cooldowns
    ?player last ability ?last
    ?player selection sequence ?sequence
  include
    ?player target lock active true
    ?player character archetype mage
    ?player class resource Vec3 { x: 100.0, y: 100.0, z: 0.65 }
    ?player ability cooldowns Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    ?player utility cooldowns Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    ?player last ability frostbolt
    ?player selection sequence ?sequence + 1.0

on select-hunter ?player
  when
    ?player target lock active ?target-active
    ?player character archetype ?prior
    ?player class resource ?resource
    ?player ability cooldowns ?cooldowns
    ?player utility cooldowns ?utility-cooldowns
    ?player last ability ?last
    ?player selection sequence ?sequence
  withdraw
    ?player target lock active ?target-active
    ?player character archetype ?prior
    ?player class resource ?resource
    ?player ability cooldowns ?cooldowns
    ?player utility cooldowns ?utility-cooldowns
    ?player last ability ?last
    ?player selection sequence ?sequence
  include
    ?player target lock active true
    ?player character archetype hunter
    ?player class resource Vec3 { x: 100.0, y: 100.0, z: 0.9 }
    ?player ability cooldowns Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    ?player utility cooldowns Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    ?player last ability steady-shot
    ?player selection sequence ?sequence + 1.0

on secondary-ability ?player
  when
    ?player ability request ?request
    ?request = idle-request
  withdraw
    ?player ability request ?request
  include
    ?player ability request secondary-request

on third-ability ?player
  when
    ?player ability request ?request
    ?request = idle-request
  withdraw
    ?player ability request ?request
  include
    ?player ability request third-request

on fourth-ability ?player
  when
    ?player ability request ?request
    ?request = idle-request
  withdraw
    ?player ability request ?request
  include
    ?player ability request fourth-request

on fifth-ability ?player
  when
    ?player ability request ?request
    ?request = idle-request
  withdraw
    ?player ability request ?request
  include
    ?player ability request fifth-request

on class-utility ?player
  when
    ?player ability request ?request
    ?request = idle-request
  withdraw
    ?player ability request ?request
  include
    ?player ability request utility-request

on primary-ability ?player
  when
    ?player ability sequences Vec3 { x: ?first, y: ?second, z: ?third }
    ?player sword action sequence ?sword-sequence
    ?player sword commitment clock ?clock
    ?player last ability ?last
    ?player combat status ?status
    ?player ranged action state ?ranged-state
    jump-arena sword commitment ticks ?commitment
    ?status = alive
    ?ranged-state = ready
    ?clock = 0.0
  withdraw
    ?player ability sequences Vec3 { x: ?first, y: ?second, z: ?third }
    ?player sword action sequence ?sword-sequence
    ?player sword commitment clock ?clock
    ?player last ability ?last
  include
    ?player ability sequences Vec3 { x: ?first + 1.0, y: ?second, z: ?third }
    ?player sword action sequence ?sword-sequence + 1.0
    ?player sword commitment clock ?commitment
    ?player last ability basic-attack

on resolve-warrior-secondary ?player
  when
    ?player ability request ?request
    ?request = secondary-request
    ?player character archetype ?archetype
    ?player class resource Vec3 { x: ?resource, y: ?maximum, z: ?regeneration }
    ?player ability cooldowns Vec3 { x: ?cooldown, y: ?third-cooldown, z: ?fourth-cooldown }
    ?player ability sequences Vec3 { x: ?first, y: ?second, z: ?third }
    ?player ranged action state ?state
    ?player ranged action clock ?clock
    ?player ranged action sequence ?ranged-sequence
    ?player ranged action duration ?duration
    ?player projectile damage ?damage
    ?player last ability ?last
    ?player target lock active ?target-active
    wayfarer-bolt projectile state ?projectile-state
    ?archetype = warrior
    ?cooldown = 0.0
    ?state = ready
    ?clock = 0.0
    ?target-active = true
    ?projectile-state = dormant
  withdraw
    ?player class resource Vec3 { x: ?resource, y: ?maximum, z: ?regeneration }
    ?player ability cooldowns Vec3 { x: ?cooldown, y: ?third-cooldown, z: ?fourth-cooldown }
    ?player ability sequences Vec3 { x: ?first, y: ?second, z: ?third }
    ?player ranged action state ?state
    ?player ranged action clock ?clock
    ?player ranged action sequence ?ranged-sequence
    ?player ranged action duration ?duration
    ?player projectile damage ?damage
    ?player last ability ?last
  include
    ?player class resource Vec3 { x: ?resource, y: ?maximum, z: ?regeneration }
    ?player ability cooldowns Vec3 { x: 45.0, y: ?third-cooldown, z: ?fourth-cooldown }
    ?player ability sequences Vec3 { x: ?first, y: ?second + 1.0, z: ?third }
    ?player ranged action state charging
    ?player ranged action clock 24.0
    ?player ranged action sequence ?ranged-sequence + 1.0
    ?player ranged action duration 24.0
    ?player projectile damage 3.0
    ?player last ability heroic-throw

on resolve-mage-secondary ?player
  when
    ?player ability request ?request
    ?request = secondary-request
    ?player character archetype ?archetype
    ?player class resource Vec3 { x: ?resource, y: ?maximum, z: ?regeneration }
    ?player ability cooldowns Vec3 { x: ?cooldown, y: ?third-cooldown, z: ?fourth-cooldown }
