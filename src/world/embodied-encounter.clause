bind scalar-input PointerWorldX to observe-order-x
bind scalar-input PointerWorldZ to observe-order-z
bind keyboard ClearSelection down to clear-selection
bind keyboard SelectAll down to select-all
bind referent-input Pick as Unit to select-unit
bind referent-input TogglePick as Unit to toggle-unit
bind referent-input Target as Actor to choose-target
bind referent-input Scenario as Scenario to choose-scenario
bind keyboard IssueMove down to issue-move
bind keyboard Stop down to stop-unit
bind keyboard BeginEncounter down to begin-encounter
bind keyboard Attack down to party-attack
bind keyboard Heal down to party-heal
bind keyboard Ward down to raise-ward
bind keyboard Ignite down to ignite-target
bind referent-input CancelBurn as BurnEffect to cancel-burn

on observe-order-x ?controller ?x
  when
    ?controller:
      order target:
        x: ?prior-x
        y: ?y
        z: ?z
  withdraw
    ?controller:
      order target:
        x: ?prior-x
        y: ?y
        z: ?z
  include
    ?controller:
      order target:
        x: ?x
        y: ?y
        z: ?z
on observe-order-z ?controller ?z
  when
    ?controller:
      order target:
        x: ?x
        y: ?y
        z: ?prior-z
  withdraw
    ?controller:
      order target:
        x: ?x
        y: ?y
        z: ?prior-z
  include
    ?controller:
      order target:
        x: ?x
        y: ?y
        z: ?z
on clear-selection ?unit
  when
    ?unit selected ?was-selected
  withdraw
    ?unit selected ?was-selected
  include
    ?unit selected false
on select-all ?unit
  when
    ?unit selected ?was-selected
  withdraw
    ?unit selected ?was-selected
  include
    ?unit selected true
on select-unit ?unit ?target
  when
    ?unit selected ?was-selected
    ?unit = ?target
  withdraw
    ?unit selected ?was-selected
  include
    ?unit selected true
on toggle-unit ?unit ?target
  when
    ?unit selected ?was-selected
    ?unit = ?target
  withdraw
    ?unit selected ?was-selected
  include
    ?unit selected (?was-selected = false)
on choose-target ?controller ?picked
  when
    ?controller chosen target ?prior
    ?picked vitality ?health
  withdraw
    ?controller chosen target ?prior
  include
    ?controller chosen target ?picked
on choose-scenario ?encounter ?picked
  when
    ?encounter:
      encounter state: ready
      encounter scenario: ?prior-scenario
    ?picked scenario opening target ?opening-target
    player-1 chosen target ?prior-target
  withdraw
    ?encounter encounter scenario ?prior-scenario
    player-1 chosen target ?prior-target
  include
    ?encounter encounter scenario ?picked
    player-1 chosen target ?opening-target
on begin-encounter ?encounter
  when
    ?encounter encounter state ?state
    ?state = ready
  withdraw
    ?encounter encounter state ?state
  include
    ?encounter encounter state active
on issue-move ?unit
  when
    player-1:
      order target:
        x: ?target-x
        y: ?target-y
        z: ?target-z
    ?unit:
      selected formation:
        x: ?offset-x
        y: ?offset-y
        z: ?offset-z
    sum 1.0 where { ?member selected formation Vec3 { x: ?x, y: ?y, z: ?z } } as ?group-size
    sum ?x where { ?member selected formation Vec3 { x: ?x, y: ?y, z: ?z } } as ?offset-sum-x
    sum ?z where { ?member selected formation Vec3 { x: ?x, y: ?y, z: ?z } } as ?offset-sum-z
    ?group-size > 0.0
    ?unit footprint radius ?radius
    sum 1.0 given ?target-x ?target-z ?offset-x ?offset-z ?offset-sum-x ?offset-sum-z ?group-size ?radius where { ?other selected false; ?other alive true; ?other footprint radius ?other-radius; ?other actor position Vec3 { x: ?x, y: ?y, z: ?z }; (?target-x + ?offset-x - ?offset-sum-x / ?group-size - ?x) * (?target-x + ?offset-x - ?offset-sum-x / ?group-size - ?x) + (?target-z + ?offset-z - ?offset-sum-z / ?group-size - ?z) * (?target-z + ?offset-z - ?offset-sum-z / ?group-size - ?z) < (?radius + ?other-radius) * (?radius + ?other-radius) } as ?blockers
    field half width ?field-size
    point (?target-x + ?offset-x - ?offset-sum-x / ?group-size) (?target-z + ?offset-z - ?offset-sum-z / ?group-size) radius ?radius inside ?field-size as ?terrain
    sum 1.0 given ?target-x ?target-z ?offset-x ?offset-z ?offset-sum-x ?offset-sum-z ?group-size ?radius where { ?obstacle obstacle position Vec3 { x: ?x, y: ?y, z: ?z }; ?obstacle obstacle radius ?obstacle-radius; (?target-x + ?offset-x - ?offset-sum-x / ?group-size - ?x) * (?target-x + ?offset-x - ?offset-sum-x / ?group-size - ?x) + (?target-z + ?offset-z - ?offset-sum-z / ?group-size - ?z) * (?target-z + ?offset-z - ?offset-sum-z / ?group-size - ?z) < (?radius + ?obstacle-radius) * (?radius + ?obstacle-radius) } as ?obstacles
    destination with ?blockers blockers terrain ?terrain obstacles ?obstacles reports ?readiness
    ?readiness = "Ready"
    ?unit:
      unit destination: ?prior-destination
      moving: ?was-moving
  withdraw
    ?unit:
      unit destination: ?prior-destination
      moving: ?was-moving
  include
    ?unit:
      unit destination:
        x: ?target-x + (?offset-x - ?offset-sum-x / ?group-size)
        y: 0.0
        z: ?target-z + (?offset-z - ?offset-sum-z / ?group-size)
      moving: true

on issue-move ?unit
  when
    player-1:
      order target:
        x: ?target-x
        y: ?target-y
        z: ?target-z
    ?unit:
      selected formation:
        x: ?offset-x
        y: ?offset-y
        z: ?offset-z
    sum 1.0 where { ?member selected formation Vec3 { x: ?x, y: ?y, z: ?z } } as ?group-size
    sum ?x where { ?member selected formation Vec3 { x: ?x, y: ?y, z: ?z } } as ?offset-sum-x
    sum ?z where { ?member selected formation Vec3 { x: ?x, y: ?y, z: ?z } } as ?offset-sum-z
    ?group-size > 0.0
    ?unit footprint radius ?radius
    sum 1.0 given ?target-x ?target-z ?offset-x ?offset-z ?offset-sum-x ?offset-sum-z ?group-size ?radius where { ?other selected false; ?other alive true; ?other footprint radius ?other-radius; ?other actor position Vec3 { x: ?x, y: ?y, z: ?z }; (?target-x + ?offset-x - ?offset-sum-x / ?group-size - ?x) * (?target-x + ?offset-x - ?offset-sum-x / ?group-size - ?x) + (?target-z + ?offset-z - ?offset-sum-z / ?group-size - ?z) * (?target-z + ?offset-z - ?offset-sum-z / ?group-size - ?z) < (?radius + ?other-radius) * (?radius + ?other-radius) } as ?blockers
    field half width ?field-size
    point (?target-x + ?offset-x - ?offset-sum-x / ?group-size) (?target-z + ?offset-z - ?offset-sum-z / ?group-size) radius ?radius inside ?field-size as ?terrain
    sum 1.0 given ?target-x ?target-z ?offset-x ?offset-z ?offset-sum-x ?offset-sum-z ?group-size ?radius where { ?obstacle obstacle position Vec3 { x: ?x, y: ?y, z: ?z }; ?obstacle obstacle radius ?obstacle-radius; (?target-x + ?offset-x - ?offset-sum-x / ?group-size - ?x) * (?target-x + ?offset-x - ?offset-sum-x / ?group-size - ?x) + (?target-z + ?offset-z - ?offset-sum-z / ?group-size - ?z) * (?target-z + ?offset-z - ?offset-sum-z / ?group-size - ?z) < (?radius + ?obstacle-radius) * (?radius + ?obstacle-radius) } as ?obstacles
    destination with ?blockers blockers terrain ?terrain obstacles ?obstacles reports ?readiness
    ?unit:
      order report: ?prior-report
      order name: ?prior-name
      order number: ?prior-number
      order accepted: ?prior-accepted
  withdraw
    ?unit:
      order report: ?prior-report
      order name: ?prior-name
      order number: ?prior-number
      order accepted: ?prior-accepted
  include
    ?unit:
      order report: ?readiness
      order name: "Move"
      order number: ?prior-number + 1.0
      order accepted: (?readiness = "Ready")

on stop-unit ?unit
  when
    ?unit:
      selected: true
      alive: true
      vitality: ?health
    ?health > 0.0
    ?unit:
      actor position: ?position
      unit destination: ?destination
      moving: ?was-moving
  withdraw
    ?unit:
      unit destination: ?destination
      moving: ?was-moving
  include
    ?unit:
      unit destination: ?position
      moving: false

on party-attack ?unit
  when
    encounter encounter state ?state
    ?unit:
      selected: ?is-selected
      vitality: ?unit-health
      maximum vitality: ?unit-maximum
      alive: ?is-alive
      actor position:
        x: ?unit-x
        y: ?unit-y
        z: ?unit-z
      attack damage: ?damage
      attack range: ?range
      action cooldown: ?cooldown
      action period: ?period
    player-1 chosen target ?target
    ?target:
      actor position:
        x: ?target-x
        y: ?target-y
        z: ?target-z
      vitality: ?health
      hostile: ?target-hostile
    hostile order active (?state = active) selected ?is-selected alive ?is-alive health ?unit-health capable true hostile ?target-hostile targetHealth ?health from ?unit-x ?unit-z to ?target-x ?target-z range ?range cooldown ?cooldown reports ?readiness
    ?readiness = "Ready"
  withdraw
    ?unit action cooldown ?cooldown
  include
    ?unit action cooldown ?period
  accumulate
    ?target vitality 0.0 - if(?unit-health < ?unit-maximum * 0.5, ?damage * 0.5, ?damage)
on party-heal ?unit
  when
    encounter encounter state ?state
    ?unit:
      selected: ?is-selected
      vitality: ?unit-health
      alive: ?is-alive
      actor position:
        x: ?unit-x
        y: ?unit-y
        z: ?unit-z
      healing power: ?healing
      attack range: ?range
      action cooldown: ?cooldown
      action period: ?period
    player-1 chosen target ?target
    ?target:
      actor position:
        x: ?target-x
        y: ?target-y
        z: ?target-z
      vitality: ?health
      maximum vitality: ?maximum
      hostile: ?target-hostile
      alive: ?target-alive
    ?health + ?healing clamped between 0.0 and ?maximum as ?next-health
    order active (?state = active) selected ?is-selected alive ?is-alive health ?unit-health capable (?healing > 0.0) kind (?target-hostile = false) targetAlive ?target-alive needed (?health < ?maximum) inRange ((?target-x - ?unit-x) * (?target-x - ?unit-x) + (?target-z - ?unit-z) * (?target-z - ?unit-z) <= ?range * ?range) cooldown ?cooldown reports ?readiness
    ?readiness = "Ready"
  withdraw
    ?unit action cooldown ?cooldown
  include
    ?unit action cooldown ?period
  accumulate
    ?target vitality ?next-health - ?health
on raise-ward ?unit
  when
    encounter encounter state ?state
    ?unit:
      selected: ?is-selected
      vitality: ?unit-health
      alive: ?is-alive
      actor position:
        x: ?unit-x
        y: ?unit-y
        z: ?unit-z
      ward duration: ?duration
      attack range: ?range
      action cooldown: ?cooldown
      action period: ?period
    player-1 chosen target ?target
    ?target:
      actor position:
        x: ?target-x
        y: ?target-y
        z: ?target-z
      ward remaining: ?prior
      hostile: ?target-hostile
      alive: ?target-alive
    order active (?state = active) selected ?is-selected alive ?is-alive health ?unit-health capable (?duration > 0.0) kind (?target-hostile = false) targetAlive ?target-alive needed true inRange ((?target-x - ?unit-x) * (?target-x - ?unit-x) + (?target-z - ?unit-z) * (?target-z - ?unit-z) <= ?range * ?range) cooldown ?cooldown reports ?readiness
    ?readiness = "Ready"
  withdraw
    ?unit action cooldown ?cooldown
    ?target ward remaining ?prior
  include
    ?unit action cooldown ?period
    ?target ward remaining ?duration

on ignite-target ?unit
  when
    encounter encounter state ?state
    ?unit:
      selected: ?is-selected
      vitality: ?unit-health
      alive: ?is-alive
      actor position:
        x: ?unit-x
        y: ?unit-y
        z: ?unit-z
      ignite duration: ?duration
      ignite damage: ?damage
      attack range: ?range
      action cooldown: ?cooldown
      action period: ?period
    player-1 chosen target ?target
    ?target:
      actor position:
        x: ?target-x
        y: ?target-y
        z: ?target-z
      vitality: ?health
      hostile: ?target-hostile
    sum 1.0 given ?unit where { ?unit ignite duration ?duration; ?unit ignite damage ?damage; ?duration > 0.0; ?damage > 0.0 } as ?ignite-count
    hostile order active (?state = active) selected ?is-selected alive ?is-alive health ?unit-health capable (?ignite-count > 0.0) hostile ?target-hostile targetHealth ?health from ?unit-x ?unit-z to ?target-x ?target-z range ?range cooldown ?cooldown reports ?readiness
    ?readiness = "Ready"
  create
    ?effect
      member of: BurnEffect
  withdraw
    ?unit action cooldown ?cooldown
  include
    ?unit action cooldown ?period
    ?effect:
      burn target: ?target
      effect remaining: ?duration
      effect damage: ?damage

on party-attack ?unit
  when
    encounter encounter state ?state
    ?unit:
      selected: ?is-selected
      vitality: ?unit-health
      alive: ?is-alive
      actor position:
        x: ?unit-x
        y: ?unit-y
        z: ?unit-z
      attack damage: ?damage
      attack range: ?range
      action cooldown: ?cooldown
      action period: ?period
    player-1 chosen target ?target
    ?target:
      actor position:
        x: ?target-x
        y: ?target-y
        z: ?target-z
      vitality: ?health
      hostile: ?target-hostile
    hostile order active (?state = active) selected ?is-selected alive ?is-alive health ?unit-health capable true hostile ?target-hostile targetHealth ?health from ?unit-x ?unit-z to ?target-x ?target-z range ?range cooldown ?cooldown reports ?readiness
    ?is-selected = true
    ?unit:
      order report: ?prior-report
      order name: ?prior-name
      order number: ?prior-number
      order accepted: ?prior-accepted
  withdraw
    ?unit:
      order report: ?prior-report
      order name: ?prior-name
      order number: ?prior-number
      order accepted: ?prior-accepted
  include
    ?unit:
      order report: ?readiness
      order name: "Attack"
      order number: ?prior-number + 1.0
      order accepted: (?readiness = "Ready")

on party-heal ?unit
  when
    encounter encounter state ?state
    ?unit:
      selected: ?is-selected
