    x: -6.0
    y: 0.0
    z: 4.0
  obstacle radius: 1.2

law destination-status
  then
    destination with ?blockers blockers terrain ?terrain obstacles ?obstacles reports if(?terrain, if(?obstacles > 0.0, "Path blocked", if(?blockers > 0.0, "Space occupied", "Ready")), "Beyond the battlefield")
law terrain-bounds
  then
    point ?x ?z radius ?radius inside ?size as if(?x < 0.0 - ?size + ?radius, false, if(?x > ?size - ?radius, false, if(?z < 0.0 - ?size + ?radius, false, ?z <= ?size - ?radius)))
law travel-component
  then
    from ?position toward ?destination fraction ?fraction advances (?destination - ?position) * ?fraction
law closest-projection
  then
    step ?dx ?dz toward relative point ?px ?pz projects if(?dx * ?dx + ?dz * ?dz > 0.0, (?px * ?dx + ?pz * ?dz) / (?dx * ?dx + ?dz * ?dz), 0.0)
law swept-distance
  then
    step ?dx ?dz past relative point ?px ?pz radius ?radius along ?along blocked ((?along * ?dx - ?px) * (?along * ?dx - ?px) + (?along * ?dz - ?pz) * (?along * ?dz - ?pz) < ?radius * ?radius)
law choose-travel
  then
    paths forward ?forward right ?right left ?left choose if(?forward <= 0.0, 0.0, if(?right <= 0.0, 1.0, if(?left <= 0.0, -1.0, 2.0)))
derive destination-status
derive terrain-bounds
derive travel-component
derive closest-projection
derive swept-distance
derive choose-travel

