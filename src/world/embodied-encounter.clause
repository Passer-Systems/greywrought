  subject enemy
  mode given enemy yields value: one

relation enemy-combat-status
  reads {enemy: Enemy} enemy combat status {value: CombatStatus}
  subject enemy
  mode given enemy yields value: one

relation next-target
  reads {enemy: Enemy} next target {next: Enemy}
  subject enemy
  mode given enemy yields next: one

relation previous-target
  reads {enemy: Enemy} previous target {previous: Enemy}
  subject enemy
  mode given enemy yields previous: one

relation enemy-pressure-state
  reads {enemy: Enemy} enemy pressure state {value: CombatStatus}
  subject enemy
  mode given enemy yields value: one

relation enemy-pressure-clock
  reads {enemy: Enemy} enemy pressure clock {value: F64}
  subject enemy
  mode given enemy yields value: one

relation enemy-charge-start
  reads {enemy: Enemy} enemy charge start {value: Vec3}
  subject enemy
  mode given enemy yields value: one

relation enemy-charge-end
  reads {enemy: Enemy} enemy charge end {value: Vec3}
  subject enemy
  mode given enemy yields value: one

relation enemy-charge-envelope
  reads {enemy: Enemy} enemy charge envelope {value: Vec3}
  subject enemy
  mode given enemy yields value: one

relation enemy-charge-committed
  reads {enemy: Enemy} enemy charge committed {value: Bool}
  subject enemy
  mode given enemy yields value: one

relation enemy-recovery-clock
  reads {enemy: Enemy} enemy recovery clock {value: F64}
  subject enemy
  mode given enemy yields value: one

relation enemy-random-sample
  reads {enemy: Enemy} enemy random sample {value: F64}
  subject enemy
  mode given enemy yields value: one

relation projectile-position
  reads {projectile: Projectile} projectile position {value: Vec3}
  subject projectile
  mode given projectile yields value: one

relation projectile-state
  reads {projectile: Projectile} projectile state {value: ProjectileState}
  subject projectile
  mode given projectile yields value: one

relation projectile-visible
  reads {projectile: Projectile} projectile visible {value: Bool}
  subject projectile
  mode given projectile yields value: one

relation projectile-contact-radius
  reads {arena: Arena} projectile contact radius {value: F64}
  subject arena
  mode given arena yields value: one

relation projectile-contact
  reads {player: Player} has projectile contact with {projectile: Projectile} as {value: Bool}
  subject player
  mode given player projectile yields value: maybe

relation loot-state
  reads {loot: Loot} loot state {value: LootState}
  subject loot
  mode given loot yields value: one

relation custody
  reads {loot: Loot} custody {custodian: Custodian}
  subject loot
  mode given loot yields custodian: one

relation loot-position
  reads {loot: Loot} loot position {value: Vec3}
  subject loot
  mode given loot yields value: one

relation loot-pickup-radius
  reads {arena: Arena} loot pickup radius {value: F64}
  subject arena
  mode given arena yields value: one

relation exit-position
  reads {objective: Objective} exit position {value: Vec3}
  subject objective
  mode given objective yields value: one

relation objective-state
  reads {objective: Objective} objective state {value: Vec3}
  subject objective
  mode given objective yields value: one

relation reset-signal
  reads {objective: Objective} reset signal {value: Vec3}
  subject objective
  mode given objective yields value: one

law clamp-lower
  if
    ?lower <= ?upper
    ?value < ?lower
  then
    ?value clamped between ?lower and ?upper as ?lower

law clamp-interior
  if
    ?lower <= ?value
    ?value <= ?upper
  then
    ?value clamped between ?lower and ?upper as ?value

law clamp-upper
  if
    ?lower <= ?upper
    ?value > ?upper
  then
    ?value clamped between ?lower and ?upper as ?upper

law projectile-contact-within-radius
  if
    ?player position Vec3 { x: ?player-x, y: ?player-y, z: ?player-z }
    ?projectile projectile position Vec3 { x: ?projectile-x, y: ?projectile-y, z: ?projectile-z }
    ?projectile projectile state ?projectile-state
    jump-arena projectile contact radius ?contact-radius
    ?projectile-state = flight
    ((?player-x - ?projectile-x) * (?player-x - ?projectile-x)) + ((?player-z - ?projectile-z) * (?player-z - ?projectile-z)) <= ?contact-radius * ?contact-radius
  then
    ?player has projectile contact with ?projectile as true

derive clamp-lower
derive clamp-interior
derive clamp-upper
derive projectile-contact-within-radius

jump-arena ∈ Arena
player-1 ∈ Player
player-1 ∈ Custodian
cinder-wraith ∈ Enemy
cinder-wraith ∈ Custodian
cinder-bolt ∈ Projectile
ashen-key ∈ Loot
game-objective ∈ Objective

jump-arena gravity -12.0
jump-arena jump speed 3.0
jump-arena melee range 2.0
jump-arena floor height 0.0
jump-arena minimum x -4.6
jump-arena maximum x 4.8
jump-arena minimum z -3.2
jump-arena maximum z 3.2
jump-arena projectile contact radius 0.6
jump-arena loot pickup radius 0.6

player-1 position Vec3 { x: -2.0, y: 0.0, z: 0.5 }
player-1 velocity Vec3 { x: 0.0, y: 0.0, z: 0.0 }
player-1 grounded true
player-1 horizontal intent Vec3 { x: 0.0, y: 0.0, z: 0.0 }
player-1 camera forward Vec3 { x: 0.0, y: 0.0, z: -1.0 }
player-1 move speed 4.0
player-1 base move speed 4.0
player-1 sustained move speed 7.0
player-1 negative control Vec3 { x: 0.0, y: 0.0, z: 0.0 }
player-1 positive control Vec3 { x: 0.0, y: 0.0, z: 0.0 }
player-1 booster energy 100.0
player-1 booster capacity 100.0
player-1 booster regeneration 1.0
player-1 booster ignition threshold 25.0
player-1 booster regeneration delay limit 8.0
player-1 booster regeneration delay 0.0
player-1 horizontal sustain drain 0.5
player-1 horizontal burst displacement 1.92
player-1 horizontal burst cost 20.0
player-1 vertical sustain thrust 0.55
player-1 vertical sustain drain 1.0
player-1 vertical burst impulse 5.0
player-1 vertical burst cost 25.0
player-1 player vitals Vec3 { x: 4.0, y: 4.0, z: 1.0 }
player-1 combat status alive
player-1 status effect clear
player-1 status clock 12.0
player-1 sword action sequence 0.0
player-1 sword commitment clock 0.0
player-1 combat target cinder-wraith
player-1 target lock active false
player-1 target selection sequence 0.0

cinder-wraith enemy position Vec3 { x: 12.0, y: 0.0, z: 0.0 }
cinder-wraith enemy vitals Vec3 { x: 6.0, y: 6.0, z: 1.0 }
cinder-wraith enemy combat status alive
cinder-wraith next target cinder-wraith
cinder-wraith previous target cinder-wraith
cinder-wraith enemy pressure state approach
cinder-wraith enemy pressure clock 0.0
cinder-wraith enemy recovery clock 0.0
cinder-wraith enemy charge start Vec3 { x: 0.0, y: 0.0, z: 0.0 }
cinder-wraith enemy charge end Vec3 { x: 0.0, y: 0.0, z: 0.0 }
cinder-wraith enemy charge envelope Vec3 { x: 0.0, y: 0.0, z: 0.0 }
cinder-wraith enemy charge committed false
cinder-wraith enemy random sample 0.5

cinder-bolt projectile position Vec3 { x: 2.0, y: 0.55, z: 0.0 }
cinder-bolt projectile state dormant
cinder-bolt projectile visible false

ashen-key loot state hidden
ashen-key custody cinder-wraith
ashen-key loot position Vec3 { x: 1.2, y: 0.0, z: -1.0 }
game-objective exit position Vec3 { x: -2.0, y: 0.0, z: -1.0 }
game-objective objective state Vec3 { x: 0.0, y: 0.0, z: 0.0 }
game-objective reset signal Vec3 { x: 0.0, y: 0.0, z: 0.0 }

bind keyboard KeyW down to hold-forward
bind keyboard KeyW up to release-forward
bind keyboard KeyS down to hold-backward
bind keyboard KeyS up to release-backward
bind keyboard KeyA down to hold-left
bind keyboard KeyA up to release-left
bind keyboard KeyD down to hold-right
bind keyboard KeyD up to release-right
bind keyboard ShiftLeft down to enable-horizontal-sustain
bind keyboard ShiftLeft up to disable-horizontal-sustain
bind keyboard ShiftRight down to enable-horizontal-sustain
bind keyboard ShiftRight up to disable-horizontal-sustain
bind keyboard KeyQ down to horizontal-burst
bind keyboard Space down to jump
bind keyboard KeyE down to enable-vertical-sustain
bind keyboard KeyE up to disable-vertical-sustain
bind keyboard KeyF down to vertical-burst
bind keyboard KeyJ down to begin-sword-action
bind keyboard Tab down to target-next-enemy
bind keyboard ShiftTab down to target-previous-enemy
bind keyboard KeyR down to reset-objective
bind scalar-input CameraForwardX to observe-camera-forward-x
bind scalar-input CameraForwardZ to observe-camera-forward-z

on hold-forward ?player
  when
    ?player negative control Vec3 { x: ?left, y: ?vertical, z: ?forward }
  withdraw
    ?player negative control Vec3 { x: ?left, y: ?vertical, z: ?forward }
  include
    ?player negative control Vec3 { x: ?left, y: ?vertical, z: 1.0 }

on release-forward ?player
  when
    ?player negative control Vec3 { x: ?left, y: ?vertical, z: ?forward }
  withdraw
    ?player negative control Vec3 { x: ?left, y: ?vertical, z: ?forward }
  include
    ?player negative control Vec3 { x: ?left, y: ?vertical, z: 0.0 }

on hold-backward ?player
  when
    ?player positive control Vec3 { x: ?right, y: ?horizontal, z: ?backward }
  withdraw
    ?player positive control Vec3 { x: ?right, y: ?horizontal, z: ?backward }
  include
    ?player positive control Vec3 { x: ?right, y: ?horizontal, z: 1.0 }

on release-backward ?player
  when
    ?player positive control Vec3 { x: ?right, y: ?horizontal, z: ?backward }
  withdraw
    ?player positive control Vec3 { x: ?right, y: ?horizontal, z: ?backward }
  include
    ?player positive control Vec3 { x: ?right, y: ?horizontal, z: 0.0 }

on hold-left ?player
  when
    ?player negative control Vec3 { x: ?left, y: ?vertical, z: ?forward }
  withdraw
    ?player negative control Vec3 { x: ?left, y: ?vertical, z: ?forward }
  include
    ?player negative control Vec3 { x: 1.0, y: ?vertical, z: ?forward }

on release-left ?player
  when
    ?player negative control Vec3 { x: ?left, y: ?vertical, z: ?forward }
  withdraw
    ?player negative control Vec3 { x: ?left, y: ?vertical, z: ?forward }
  include
    ?player negative control Vec3 { x: 0.0, y: ?vertical, z: ?forward }

on hold-right ?player
  when
    ?player positive control Vec3 { x: ?right, y: ?horizontal, z: ?backward }
  withdraw
    ?player positive control Vec3 { x: ?right, y: ?horizontal, z: ?backward }
  include
    ?player positive control Vec3 { x: 1.0, y: ?horizontal, z: ?backward }

on release-right ?player
  when
    ?player positive control Vec3 { x: ?right, y: ?horizontal, z: ?backward }
  withdraw
    ?player positive control Vec3 { x: ?right, y: ?horizontal, z: ?backward }
  include
    ?player positive control Vec3 { x: 0.0, y: ?horizontal, z: ?backward }

on enable-horizontal-sustain ?player
  when
    ?player positive control Vec3 { x: ?right, y: ?horizontal, z: ?backward }
  withdraw
    ?player positive control Vec3 { x: ?right, y: ?horizontal, z: ?backward }
  include
    ?player positive control Vec3 { x: ?right, y: 1.0, z: ?backward }

on disable-horizontal-sustain ?player
  when
    ?player positive control Vec3 { x: ?right, y: ?horizontal, z: ?backward }
  withdraw
    ?player positive control Vec3 { x: ?right, y: ?horizontal, z: ?backward }
  include
    ?player positive control Vec3 { x: ?right, y: 0.0, z: ?backward }

on enable-vertical-sustain ?player
  when
    ?player negative control Vec3 { x: ?left, y: ?vertical, z: ?forward }
  withdraw
    ?player negative control Vec3 { x: ?left, y: ?vertical, z: ?forward }
  include
    ?player negative control Vec3 { x: ?left, y: 1.0, z: ?forward }

on disable-vertical-sustain ?player
  when
    ?player negative control Vec3 { x: ?left, y: ?vertical, z: ?forward }
  withdraw
    ?player negative control Vec3 { x: ?left, y: ?vertical, z: ?forward }
  include
    ?player negative control Vec3 { x: ?left, y: 0.0, z: ?forward }

on observe-camera-forward-x ?player ?observed-x
  when
    ?player camera forward Vec3 { x: ?camera-x, y: ?camera-y, z: ?camera-z }
  withdraw
    ?player camera forward Vec3 { x: ?camera-x, y: ?camera-y, z: ?camera-z }
  include
    ?player camera forward Vec3 { x: ?observed-x, y: ?camera-y, z: ?camera-z }

on observe-camera-forward-z ?player ?observed-z
  when
    ?player camera forward Vec3 { x: ?camera-x, y: ?camera-y, z: ?camera-z }
  withdraw
    ?player camera forward Vec3 { x: ?camera-x, y: ?camera-y, z: ?camera-z }
  include
    ?player camera forward Vec3 { x: ?camera-x, y: ?camera-y, z: ?observed-z }

on derive-horizontal-intent-x ?player
  when
    ?player horizontal intent Vec3 { x: ?intent-x, y: ?intent-y, z: ?intent-z }
    ?player negative control Vec3 { x: ?left, y: ?vertical, z: ?forward }
    ?player positive control Vec3 { x: ?right, y: ?horizontal, z: ?backward }
    ?player camera forward Vec3 { x: ?camera-x, y: ?camera-y, z: ?camera-z }
  withdraw
    ?player horizontal intent Vec3 { x: ?intent-x, y: ?intent-y, z: ?intent-z }
  include
    ?player horizontal intent Vec3 { x: ((?right - ?left) * (0.0 - ?camera-z)) + ((?backward - ?forward) * (0.0 - ?camera-x)), y: ?intent-y, z: ?intent-z }

on derive-horizontal-intent-z ?player
  when
    ?player horizontal intent Vec3 { x: ?intent-x, y: ?intent-y, z: ?intent-z }
    ?player negative control Vec3 { x: ?left, y: ?vertical, z: ?forward }
    ?player positive control Vec3 { x: ?right, y: ?horizontal, z: ?backward }
    ?player camera forward Vec3 { x: ?camera-x, y: ?camera-y, z: ?camera-z }
  withdraw
    ?player horizontal intent Vec3 { x: ?intent-x, y: ?intent-y, z: ?intent-z }
  include
    ?player horizontal intent Vec3 { x: ?intent-x, y: ?intent-y, z: ((?right - ?left) * ?camera-x) + ((?backward - ?forward) * (0.0 - ?camera-z)) }

on apply-horizontal-sustain ?player
  when
    ?player move speed ?speed
    ?player booster energy ?energy
    ?player booster ignition threshold ?threshold
    ?player booster regeneration delay ?delay
    ?player booster regeneration delay limit ?delay-limit
    ?player positive control Vec3 { x: ?right, y: ?horizontal, z: ?backward }
    ?player sustained move speed ?sustained
    ?player horizontal sustain drain ?drain
    ?horizontal = 1.0
    ?threshold <= ?energy
    ?drain <= ?energy
  withdraw
    ?player move speed ?speed
    ?player booster energy ?energy
    ?player booster regeneration delay ?delay
  include
    ?player move speed ?sustained
    ?player booster energy ?energy - ?drain
    ?player booster regeneration delay ?delay-limit

on restore-horizontal-speed ?player
  when
    ?player move speed ?speed
    ?player positive control Vec3 { x: ?right, y: ?horizontal, z: ?backward }
    ?player base move speed ?base
    ?horizontal = 0.0
  withdraw
    ?player move speed ?speed
  include
    ?player move speed ?base

on restore-exhausted-horizontal-speed ?player
  when
    ?player move speed ?speed
    ?player booster energy ?energy
    ?player booster ignition threshold ?threshold
    ?player base move speed ?base
    ?energy < ?threshold
  withdraw
    ?player move speed ?speed
  include
    ?player move speed ?base

on horizontal-burst ?player
  when
    ?player position Vec3 { x: ?position-x, y: ?position-y, z: ?position-z }
    ?player horizontal intent Vec3 { x: ?intent-x, y: ?intent-y, z: ?intent-z }
    ?player booster energy ?energy
    ?player booster ignition threshold ?threshold
    ?player booster regeneration delay ?delay
    ?player booster regeneration delay limit ?delay-limit
    ?player horizontal burst displacement ?displacement
    ?player horizontal burst cost ?cost
    jump-arena minimum x ?min-x
    jump-arena maximum x ?max-x
    jump-arena minimum z ?min-z
    jump-arena maximum z ?max-z
    (?position-x + ?intent-x * ?displacement) clamped between ?min-x and ?max-x as ?next-x
    (?position-z + ?intent-z * ?displacement) clamped between ?min-z and ?max-z as ?next-z
    ?intent-x * ?intent-x + ?intent-z * ?intent-z > 0.0
    ?threshold <= ?energy
    ?cost <= ?energy
  withdraw
    ?player position Vec3 { x: ?position-x, y: ?position-y, z: ?position-z }
    ?player booster energy ?energy
    ?player booster regeneration delay ?delay
  include
    ?player position Vec3 { x: ?next-x, y: ?position-y, z: ?next-z }
    ?player booster energy ?energy - ?cost
    ?player booster regeneration delay ?delay-limit

on apply-vertical-sustain ?player
  when
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: ?velocity-z }
    ?player grounded ?grounded
    ?player negative control Vec3 { x: ?left, y: ?vertical, z: ?forward }
    ?player booster energy ?energy
    ?player booster ignition threshold ?threshold
    ?player booster regeneration delay ?delay
    ?player booster regeneration delay limit ?delay-limit
    ?player vertical sustain thrust ?thrust
    ?player vertical sustain drain ?drain
    ?vertical = 1.0
    ?threshold <= ?energy
    ?drain <= ?energy
  withdraw
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: ?velocity-z }
    ?player grounded ?grounded
    ?player booster energy ?energy
    ?player booster regeneration delay ?delay
  include
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y + ?thrust, z: ?velocity-z }
    ?player grounded false
    ?player booster energy ?energy - ?drain
    ?player booster regeneration delay ?delay-limit

on vertical-burst ?player
  when
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: ?velocity-z }
    ?player grounded ?grounded
    ?player booster energy ?energy
    ?player booster ignition threshold ?threshold
    ?player booster regeneration delay ?delay
    ?player booster regeneration delay limit ?delay-limit
    ?player vertical burst impulse ?impulse
    ?player vertical burst cost ?cost
    ?threshold <= ?energy
    ?cost <= ?energy
  withdraw
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: ?velocity-z }
    ?player grounded ?grounded
    ?player booster energy ?energy
    ?player booster regeneration delay ?delay
  include
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y + ?impulse, z: ?velocity-z }
    ?player grounded false
    ?player booster energy ?energy - ?cost
    ?player booster regeneration delay ?delay-limit

on count-booster-regeneration-delay ?player
  when
    ?player booster regeneration delay ?delay
    ?delay > 0.0
  withdraw
    ?player booster regeneration delay ?delay
  include
    ?player booster regeneration delay ?delay - 1.0

on regenerate-booster-energy ?player
  when
    ?player booster energy ?energy
    ?player booster capacity ?capacity
    ?player booster regeneration ?regeneration
    ?player booster regeneration delay ?delay
    ?player negative control Vec3 { x: ?left, y: ?vertical, z: ?forward }
    ?player positive control Vec3 { x: ?right, y: ?horizontal, z: ?backward }
    ?delay <= 0.0
    ?vertical = 0.0
    ?horizontal = 0.0
    ?energy <= ?capacity - ?regeneration
  withdraw
    ?player booster energy ?energy
  include
    ?player booster energy ?energy + ?regeneration

on jump ?player
  when
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: ?velocity-z }
    ?player grounded true
    jump-arena jump speed ?jump-speed
  withdraw
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: ?velocity-z }
    ?player grounded true
  include
    ?player velocity Vec3 { x: ?velocity-x, y: ?jump-speed, z: ?velocity-z }
    ?player grounded false

on begin-sword-action ?player
  when
    ?player sword action sequence ?sequence
    ?player sword commitment clock ?clock
    ?player combat status ?combat-status
    ?combat-status = alive
    ?clock = 0.0
  withdraw
    ?player sword action sequence ?sequence
    ?player sword commitment clock ?clock
  include
    ?player sword action sequence ?sequence + 1.0
    ?player sword commitment clock 18.0

on target-next-enemy ?player
  when
    ?player combat target ?current-target
    ?player target lock active ?was-active
    ?player target selection sequence ?sequence
    ?current-target next target ?next-target
    ?next-target enemy combat status ?target-status
    ?target-status = alive
  withdraw
    ?player combat target ?current-target
    ?player target lock active ?was-active
    ?player target selection sequence ?sequence
  include
    ?player combat target ?next-target
    ?player target lock active true
    ?player target selection sequence ?sequence + 1.0

on target-previous-enemy ?player
  when
    ?player combat target ?current-target
    ?player target lock active ?was-active
    ?player target selection sequence ?sequence
    ?current-target previous target ?previous-target
    ?previous-target enemy combat status ?target-status
    ?target-status = alive
  withdraw
    ?player combat target ?current-target
    ?player target lock active ?was-active
    ?player target selection sequence ?sequence
  include
    ?player combat target ?previous-target
    ?player target lock active true
    ?player target selection sequence ?sequence + 1.0

on count-sword-commitment ?player
  when
    ?player sword commitment clock ?clock
    ?clock > 0.0
  withdraw
    ?player sword commitment clock ?clock
  include
    ?player sword commitment clock ?clock - 1.0

on resolve-sword-hitbox-contact ?enemy
  when
    player-1 sword commitment clock ?commitment-clock
    player-1 position Vec3 { x: ?player-x, y: ?player-y, z: ?player-z }
    player-1 combat status ?player-status
    ?enemy enemy position Vec3 { x: ?enemy-x, y: ?enemy-y, z: ?enemy-z }
    ?enemy enemy vitals Vec3 { x: ?vitality, y: ?maximum, z: ?alive-flag }
    ?enemy enemy combat status ?enemy-status
    jump-arena melee range ?melee-range
    ?commitment-clock = 12.0
    ?player-status = alive
    ?enemy-status = alive
    ?vitality > 0.0
    ((?player-x - ?enemy-x) * (?player-x - ?enemy-x)) + ((?player-y - ?enemy-y) * (?player-y - ?enemy-y)) + ((?player-z - ?enemy-z) * (?player-z - ?enemy-z)) <= ?melee-range * ?melee-range
    (?vitality - 2.0) clamped between 0.0 and ?maximum as ?next-vitality
  withdraw
    ?enemy enemy vitals Vec3 { x: ?vitality, y: ?maximum, z: ?alive-flag }
  include
    ?enemy enemy vitals Vec3 { x: ?next-vitality, y: ?maximum, z: ?alive-flag }

on reset-objective ?objective
  when
    ?objective reset signal Vec3 { x: ?reset, y: ?phase, z: ?unused }
    ?reset = 0.0
  withdraw
    ?objective reset signal Vec3 { x: ?reset, y: ?phase, z: ?unused }
  include
    ?objective reset signal Vec3 { x: 1.0, y: ?phase, z: ?unused }

on tick ?player ?dt
  when
    ?dt > 0.0
    ?player position Vec3 { x: ?position-x, y: ?floor, z: ?position-z }
    ?player velocity Vec3 { x: ?velocity-x, y: 0.0, z: ?velocity-z }
    ?player horizontal intent Vec3 { x: ?intent-x, y: 0.0, z: ?intent-z }
    ?player grounded true
    ?player move speed ?move-speed
    jump-arena floor height ?floor
    jump-arena minimum x ?min-x
    jump-arena maximum x ?max-x
    jump-arena minimum z ?min-z
    jump-arena maximum z ?max-z
    (?position-x + ?intent-x * ?move-speed * ?dt) clamped between ?min-x and ?max-x as ?next-x
    (?position-z + ?intent-z * ?move-speed * ?dt) clamped between ?min-z and ?max-z as ?next-z
  withdraw
    ?player position Vec3 { x: ?position-x, y: ?floor, z: ?position-z }
    ?player velocity Vec3 { x: ?velocity-x, y: 0.0, z: ?velocity-z }
  include
    ?player position Vec3 { x: ?next-x, y: ?floor, z: ?next-z }
    ?player velocity Vec3 { x: ?intent-x * ?move-speed, y: 0.0, z: ?intent-z * ?move-speed }

on tick ?player ?dt
  when
    ?dt > 0.0
    ?player position Vec3 { x: ?position-x, y: ?position-y, z: ?position-z }
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: ?velocity-z }
    ?player horizontal intent Vec3 { x: ?intent-x, y: 0.0, z: ?intent-z }
    ?player grounded false
    jump-arena gravity ?gravity
    ?player move speed ?move-speed
    jump-arena floor height ?floor
    jump-arena minimum x ?min-x
    jump-arena maximum x ?max-x
    jump-arena minimum z ?min-z
    jump-arena maximum z ?max-z
    (?position-x + ?intent-x * ?move-speed * ?dt) clamped between ?min-x and ?max-x as ?next-x
    (?position-z + ?intent-z * ?move-speed * ?dt) clamped between ?min-z and ?max-z as ?next-z
    ?position-y + (?velocity-y + ?gravity * ?dt) * ?dt > ?floor
  withdraw
    ?player position Vec3 { x: ?position-x, y: ?position-y, z: ?position-z }
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: ?velocity-z }
  include
    ?player position Vec3 { x: ?next-x, y: ?position-y + (?velocity-y + ?gravity * ?dt) * ?dt, z: ?next-z }
    ?player velocity Vec3 { x: (?next-x - ?position-x) / ?dt, y: ?velocity-y + ?gravity * ?dt, z: (?next-z - ?position-z) / ?dt }

on tick ?player ?dt
  when
    ?dt > 0.0
    ?player position Vec3 { x: ?position-x, y: ?position-y, z: ?position-z }
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: ?velocity-z }
    ?player horizontal intent Vec3 { x: ?intent-x, y: 0.0, z: ?intent-z }
    ?player grounded false
    jump-arena gravity ?gravity
    ?player move speed ?move-speed
    jump-arena floor height ?floor
    jump-arena minimum x ?min-x
    jump-arena maximum x ?max-x
    jump-arena minimum z ?min-z
    jump-arena maximum z ?max-z
    (?position-x + ?intent-x * ?move-speed * ?dt) clamped between ?min-x and ?max-x as ?next-x
    (?position-z + ?intent-z * ?move-speed * ?dt) clamped between ?min-z and ?max-z as ?next-z
    ?position-y + (?velocity-y + ?gravity * ?dt) * ?dt <= ?floor
  withdraw
    ?player position Vec3 { x: ?position-x, y: ?position-y, z: ?position-z }
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: ?velocity-z }
    ?player grounded false
  include
    ?player position Vec3 { x: ?next-x, y: ?floor, z: ?next-z }
    ?player velocity Vec3 { x: (?next-x - ?position-x) / ?dt, y: 0.0, z: (?next-z - ?position-z) / ?dt }
    ?player grounded true

on combat-impact ?enemy
  when
    ?enemy enemy vitals Vec3 { x: ?vitality, y: ?maximum, z: ?alive-flag }
    cinder-wraith enemy combat status ?enemy-status
    player-1 grounded ?grounded
    player-1 combat status ?player-status
    player-1 has projectile contact with cinder-bolt as true
    ?enemy-status = alive
    ?player-status = alive
    ?grounded = false
    ?vitality = 6.0
  withdraw
    ?enemy enemy vitals Vec3 { x: ?vitality, y: ?maximum, z: ?alive-flag }
  include
    ?enemy enemy vitals Vec3 { x: ?vitality - 6.0, y: ?maximum, z: ?alive-flag }

on apply-ember-mark ?player
  when
    ?player status effect ?effect
    player-1 grounded ?grounded
    player-1 combat status ?player-status
    cinder-wraith enemy combat status ?enemy-status
    player-1 has projectile contact with cinder-bolt as true
    ?player-status = alive
    ?enemy-status = alive
    ?grounded = true
    ?effect = clear
  withdraw
    ?player status effect ?effect
  include
    ?player status effect ember-mark

on spend-cinder-bolt-on-contact ?projectile
  when
    ?projectile projectile state ?state
    player-1 has projectile contact with ?projectile as true
    ?state = flight
  withdraw
    ?projectile projectile state ?state
  include
    ?projectile projectile state spent

on count-ember-mark ?player
  when
    ?player status clock ?clock
    player-1 status effect ?effect
    ?effect = ember-mark
  withdraw
    ?player status clock ?clock
  include
    ?player status clock ?clock - 1.0

on ignite-ember-mark ?player
  when
    ?player status effect ?effect
    player-1 status clock ?clock
    ?effect = ember-mark
    ?clock = 0.0
  withdraw
    ?player status effect ?effect
  include
    ?player status effect burning

on resolve-ember-mark ?player
  when
    ?player player vitals Vec3 { x: ?vitality, y: ?maximum, z: ?alive-flag }
    player-1 status effect ?effect
    ?effect = burning
    ?vitality = 4.0
  withdraw
    ?player player vitals Vec3 { x: ?vitality, y: ?maximum, z: ?alive-flag }
  include
    ?player player vitals Vec3 { x: ?vitality - 2.0, y: ?maximum, z: ?alive-flag }

on resolve-finishing-ember-mark ?player
  when
    ?player player vitals Vec3 { x: ?vitality, y: ?maximum, z: ?alive-flag }
    player-1 status effect ?effect
    ?effect = burning
    ?vitality = 2.0
  withdraw
    ?player player vitals Vec3 { x: ?vitality, y: ?maximum, z: ?alive-flag }
  include
    ?player player vitals Vec3 { x: ?vitality - 2.0, y: ?maximum, z: ?alive-flag }

on clear-ember-mark-after-impact ?player
  when
    ?player status effect ?effect
    player-1 player vitals Vec3 { x: ?vitality, y: ?maximum, z: ?alive-flag }
    ?effect = burning
    ?vitality = 2.0
  withdraw
    ?player status effect ?effect
  include
    ?player status effect clear

on clear-ember-mark-after-finishing-impact ?player
  when
    ?player status effect ?effect
    player-1 player vitals Vec3 { x: ?vitality, y: ?maximum, z: ?alive-flag }
    ?effect = burning
    ?vitality = 0.0
  withdraw
    ?player status effect ?effect
  include
    ?player status effect clear

on reset-status-clock ?player
  when
    ?player status clock ?clock
    player-1 status effect ?effect
    ?effect = clear
    ?clock = 0.0
  withdraw
    ?player status clock ?clock
  include
    ?player status clock 12.0

on advance-boar-approach ?enemy
  when
    ?enemy enemy pressure state ?pressure
    ?enemy enemy position Vec3 { x: ?enemy-x, y: ?enemy-y, z: ?enemy-z }
    player-1 position Vec3 { x: ?player-x, y: ?player-y, z: ?player-z }
    (?player-x - ?enemy-x) clamped between -0.06 and 0.06 as ?step-x
    (?player-z - ?enemy-z) clamped between -0.06 and 0.06 as ?step-z
    ?pressure = approach
    ((?player-x - ?enemy-x) * (?player-x - ?enemy-x)) + ((?player-z - ?enemy-z) * (?player-z - ?enemy-z)) > 49.0
  withdraw
    ?enemy enemy position Vec3 { x: ?enemy-x, y: ?enemy-y, z: ?enemy-z }
  include
    ?enemy enemy position Vec3 { x: ?enemy-x + ?step-x, y: ?enemy-y, z: ?enemy-z + ?step-z }

on begin-boar-telegraph ?enemy
  when
    ?enemy enemy pressure state ?pressure
    ?enemy enemy pressure clock ?clock
    ?enemy enemy position Vec3 { x: ?enemy-x, y: ?enemy-y, z: ?enemy-z }
    ?enemy enemy charge start ?prior-start
    ?enemy enemy charge end ?prior-end
    ?enemy enemy charge envelope ?prior-envelope
    player-1 position Vec3 { x: ?player-x, y: ?player-y, z: ?player-z }
    ?pressure = approach
    ?player-y <= 2.0
    ((?player-x - ?enemy-x) * (?player-x - ?enemy-x)) + ((?player-z - ?enemy-z) * (?player-z - ?enemy-z)) <= 49.0
  withdraw
    ?enemy enemy pressure state ?pressure
    ?enemy enemy pressure clock ?clock
    ?enemy enemy charge start ?prior-start
    ?enemy enemy charge end ?prior-end
    ?enemy enemy charge envelope ?prior-envelope
  include
    ?enemy enemy pressure state telegraph
    ?enemy enemy pressure clock 63.0
    ?enemy enemy charge start Vec3 { x: ?enemy-x, y: ?enemy-y, z: ?enemy-z }
    ?enemy enemy charge end Vec3 { x: ?player-x, y: ?player-y, z: ?player-z }
    ?enemy enemy charge envelope Vec3 { x: 2.0, y: 8.0, z: 0.75 }

on count-telegraph-pressure ?enemy
  when
    ?enemy enemy pressure state ?pressure
    ?enemy enemy pressure clock ?clock
    cinder-wraith enemy combat status ?enemy-status
    player-1 combat status ?player-status
    game-objective objective state Vec3 { x: ?objective, y: ?branch, z: ?unused }
    ?pressure = telegraph
    ?clock > 0.0
    ?enemy-status = alive
    ?player-status = alive
    ?objective = 0.0
  withdraw
    ?enemy enemy pressure clock ?clock
  include
    ?enemy enemy pressure clock ?clock - 1.0

on commit-boar-charge ?enemy
  when
    ?enemy enemy pressure state ?pressure
    ?enemy enemy pressure clock ?clock
    ?enemy enemy position Vec3 { x: ?start-x, y: ?start-y, z: ?start-z }
    ?enemy enemy charge start ?prior-start
    ?enemy enemy charge end Vec3 { x: ?target-x, y: ?target-y, z: ?target-z }
    ?enemy enemy charge envelope ?prior-envelope
    ?enemy enemy charge committed ?committed
    ?pressure = telegraph
    ?clock = 0.0
    ?committed = false
  withdraw
    ?enemy enemy pressure state ?pressure
    ?enemy enemy pressure clock ?clock
    ?enemy enemy charge start ?prior-start
    ?enemy enemy charge end Vec3 { x: ?target-x, y: ?target-y, z: ?target-z }
    ?enemy enemy charge envelope ?prior-envelope
    ?enemy enemy charge committed ?committed
  include
    ?enemy enemy pressure state charging
    ?enemy enemy pressure clock 12.0
    ?enemy enemy charge start Vec3 { x: ?start-x, y: ?start-y, z: ?start-z }
    ?enemy enemy charge end Vec3 { x: ?target-x, y: ?target-y, z: ?target-z }
    ?enemy enemy charge envelope Vec3 { x: 2.0, y: 8.0, z: 0.75 }
    ?enemy enemy charge committed true

on count-charge-pressure ?enemy
  when
    ?enemy enemy pressure state ?pressure
    ?enemy enemy pressure clock ?clock
    ?pressure = charging
    ?clock >= 0.0
  withdraw
    ?enemy enemy pressure clock ?clock
  include
    ?enemy enemy pressure clock ?clock - 1.0

on advance-boar-charge ?enemy
  when
    ?enemy enemy pressure state ?pressure
    ?enemy enemy pressure clock ?clock
    ?enemy enemy position Vec3 { x: ?enemy-x, y: ?enemy-y, z: ?enemy-z }
    ?enemy enemy charge start Vec3 { x: ?start-x, y: ?start-y, z: ?start-z }
    ?enemy enemy charge end Vec3 { x: ?end-x, y: ?end-y, z: ?end-z }
    ?pressure = charging
    ?clock > 0.0
  withdraw
    ?enemy enemy position Vec3 { x: ?enemy-x, y: ?enemy-y, z: ?enemy-z }
  include
    ?enemy enemy position Vec3 { x: ?enemy-x + ((?end-x - ?start-x) / 12.0), y: ?enemy-y + ((?end-y - ?start-y) / 12.0), z: ?enemy-z + ((?end-z - ?start-z) / 12.0) }

on observe-boar-charge-hit ?enemy
  when
    ?enemy enemy pressure state ?pressure
    ?enemy enemy recovery clock ?recovery-clock
    ?enemy enemy position Vec3 { x: ?enemy-x, y: ?enemy-y, z: ?enemy-z }
    ?enemy enemy charge envelope Vec3 { x: ?maximum-height, y: ?maximum-distance, z: ?corridor-radius }
    player-1 position Vec3 { x: ?player-x, y: ?player-y, z: ?player-z }
    player-1 player vitals Vec3 { x: ?vitality, y: ?maximum, z: ?alive-flag }
    ?pressure = charging
    ((?player-x - ?enemy-x) * (?player-x - ?enemy-x)) + ((?player-y - ?enemy-y) * (?player-y - ?enemy-y)) + ((?player-z - ?enemy-z) * (?player-z - ?enemy-z)) <= ?corridor-radius * ?corridor-radius
  withdraw
    ?enemy enemy pressure state ?pressure
    ?enemy enemy recovery clock ?recovery-clock
    player-1 player vitals Vec3 { x: ?vitality, y: ?maximum, z: ?alive-flag }
  include
    ?enemy enemy pressure state hit-recovery
    ?enemy enemy recovery clock 30.0
    player-1 player vitals Vec3 { x: ?vitality - 2.0, y: ?maximum, z: ?alive-flag }

on begin-boar-overrun-recovery ?enemy
  when
    ?enemy enemy pressure state ?pressure
    ?enemy enemy pressure clock ?clock
    ?enemy enemy recovery clock ?recovery-clock
    ?pressure = charging
    ?clock = -1.0
  withdraw
    ?enemy enemy pressure state ?pressure
    ?enemy enemy recovery clock ?recovery-clock
  include
    ?enemy enemy pressure state overrun-recovery
    ?enemy enemy recovery clock 31.0

on launch-cinder-bolt ?projectile
  when
    ?projectile projectile state ?state
    cinder-wraith enemy pressure state ?pressure
    cinder-wraith enemy pressure clock ?clock
    ?state = dormant
    ?pressure = lunge
    ?clock = 59.0
  withdraw
    ?projectile projectile state ?state
  include
    ?projectile projectile state flight

on show-cinder-bolt ?projectile
  when
    ?projectile projectile visible ?visible
    cinder-bolt projectile state ?state
    ?visible = false
    ?state = flight
  withdraw
    ?projectile projectile visible ?visible
  include
    ?projectile projectile visible true

on advance-cinder-bolt ?projectile
  when
    ?projectile projectile position Vec3 { x: ?projectile-x, y: ?projectile-y, z: ?projectile-z }
    cinder-bolt projectile state ?state
    ?state = flight
  withdraw
    ?projectile projectile position Vec3 { x: ?projectile-x, y: ?projectile-y, z: ?projectile-z }
  include
    ?projectile projectile position Vec3 { x: ?projectile-x - 0.25, y: ?projectile-y, z: ?projectile-z }

on spend-cinder-bolt ?projectile
  when
    ?projectile projectile state ?state
    cinder-wraith enemy pressure clock ?clock
    ?state = flight
    ?clock = 49.0
  withdraw
    ?projectile projectile state ?state
  include
    ?projectile projectile state spent

on hide-cinder-bolt ?projectile
  when
    ?projectile projectile visible ?visible
    cinder-bolt projectile state ?state
    ?visible = true
    ?state = spent
  withdraw
    ?projectile projectile visible ?visible
  include
    ?projectile projectile visible false

on reset-cinder-bolt-x ?projectile
  when
    ?projectile projectile position Vec3 { x: ?projectile-x, y: ?projectile-y, z: ?projectile-z }
    cinder-bolt projectile state ?state
    ?state = spent
  withdraw
    ?projectile projectile position Vec3 { x: ?projectile-x, y: ?projectile-y, z: ?projectile-z }
  include
    ?projectile projectile position Vec3 { x: 2.0, y: ?projectile-y, z: ?projectile-z }

on rearm-cinder-bolt ?projectile
  when
    ?projectile projectile state ?state
    cinder-wraith enemy pressure state ?pressure
    ?state = spent
    ?pressure = rearming
  withdraw
    ?projectile projectile state ?state
  include
    ?projectile projectile state dormant

on count-hit-recovery ?enemy
  when
    ?enemy enemy pressure state ?pressure
    ?enemy enemy recovery clock ?clock
    ?pressure = hit-recovery
    ?clock > 0.0
  withdraw
    ?enemy enemy recovery clock ?clock
  include
    ?enemy enemy recovery clock ?clock - 1.0

on count-overrun-recovery ?enemy
  when
    ?enemy enemy pressure state ?pressure
    ?enemy enemy recovery clock ?clock
    ?pressure = overrun-recovery
    ?clock > 0.0
  withdraw
    ?enemy enemy recovery clock ?clock
  include
    ?enemy enemy recovery clock ?clock - 1.0

on rearm-after-hit-recovery ?enemy
  when
    ?enemy enemy pressure state ?pressure
    ?enemy enemy pressure clock ?pressure-clock
    ?enemy enemy recovery clock ?recovery-clock
    ?enemy enemy charge start ?start
    ?enemy enemy charge end ?end
    ?enemy enemy charge envelope ?envelope
    ?enemy enemy charge committed ?committed
    ?pressure = hit-recovery
    ?recovery-clock = 0.0
  withdraw
    ?enemy enemy pressure state ?pressure
    ?enemy enemy pressure clock ?pressure-clock
    ?enemy enemy recovery clock ?recovery-clock
    ?enemy enemy charge start ?start
    ?enemy enemy charge end ?end
    ?enemy enemy charge envelope ?envelope
    ?enemy enemy charge committed ?committed
  include
    ?enemy enemy pressure state approach
    ?enemy enemy pressure clock 0.0
    ?enemy enemy recovery clock 0.0
    ?enemy enemy charge start Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    ?enemy enemy charge end Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    ?enemy enemy charge envelope Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    ?enemy enemy charge committed false

on rearm-after-overrun-recovery ?enemy
  when
    ?enemy enemy pressure state ?pressure
    ?enemy enemy pressure clock ?pressure-clock
    ?enemy enemy recovery clock ?recovery-clock
    ?enemy enemy charge start ?start
    ?enemy enemy charge end ?end
    ?enemy enemy charge envelope ?envelope
    ?enemy enemy charge committed ?committed
    ?pressure = overrun-recovery
    ?recovery-clock = 0.0
  withdraw
    ?enemy enemy pressure state ?pressure
    ?enemy enemy pressure clock ?pressure-clock
    ?enemy enemy recovery clock ?recovery-clock
    ?enemy enemy charge start ?start
    ?enemy enemy charge end ?end
    ?enemy enemy charge envelope ?envelope
    ?enemy enemy charge committed ?committed
  include
    ?enemy enemy pressure state approach
    ?enemy enemy pressure clock 0.0
    ?enemy enemy recovery clock 0.0
    ?enemy enemy charge start Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    ?enemy enemy charge end Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    ?enemy enemy charge envelope Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    ?enemy enemy charge committed false

on resolve-wraith-death ?enemy
  when
    ?enemy enemy combat status ?status
    cinder-wraith enemy vitals Vec3 { x: ?vitality, y: ?maximum, z: ?alive-flag }
    ?status = alive
    ?vitality = 0.0
  withdraw
    ?enemy enemy combat status ?status
  include
    ?enemy enemy combat status dead

on resolve-player-death ?player
  when
    ?player combat status ?status
    player-1 player vitals Vec3 { x: ?vitality, y: ?maximum, z: ?alive-flag }
    ?status = alive
    ?vitality = 0.0
  withdraw
    ?player combat status ?status
  include
    ?player combat status dead

on reveal-loot ?loot
  when
    ?loot loot state ?state
    cinder-wraith enemy vitals Vec3 { x: ?vitality, y: ?maximum, z: ?alive-flag }
    ?state = hidden
    ?vitality = 0.0
  withdraw
    ?loot loot state ?state
  include
    ?loot loot state available

on transfer-loot ?loot
  when
    ?loot custody ?custodian
    ashen-key loot state ?state
    ?custodian = cinder-wraith
    ?state = acquired
  withdraw
    ?loot custody ?custodian
  include
    ?loot custody player-1

on carry-loot-x ?loot
  when
    ?loot loot position Vec3 { x: ?loot-x, y: ?loot-y, z: ?loot-z }
    ?loot loot state ?state
    ?loot custody ?custodian
    player-1 position Vec3 { x: ?player-x, y: ?player-y, z: ?player-z }
    ?state = acquired
    ?custodian = player-1
  withdraw
    ?loot loot position Vec3 { x: ?loot-x, y: ?loot-y, z: ?loot-z }
  include
    ?loot loot position Vec3 { x: ?player-x, y: ?loot-y, z: ?loot-z }

on carry-loot-z ?loot
  when
    ?loot loot position Vec3 { x: ?loot-x, y: ?loot-y, z: ?loot-z }
    ?loot loot state ?state
    ?loot custody ?custodian
    player-1 position Vec3 { x: ?player-x, y: ?player-y, z: ?player-z }
    ?state = acquired
    ?custodian = player-1
  withdraw
    ?loot loot position Vec3 { x: ?loot-x, y: ?loot-y, z: ?loot-z }
  include
    ?loot loot position Vec3 { x: ?loot-x, y: ?loot-y, z: ?player-z }

on acquire-loot ?loot
  when
    ?loot loot state ?state
    player-1 position Vec3 { x: ?player-x, y: ?player-y, z: ?player-z }
    ashen-key loot position Vec3 { x: ?loot-x, y: ?loot-y, z: ?loot-z }
    cinder-wraith enemy vitals Vec3 { x: ?vitality, y: ?maximum, z: ?alive-flag }
    cinder-wraith enemy combat status ?enemy-status
    jump-arena loot pickup radius ?pickup-radius
    ?state = available
    ?vitality = 0.0
    ?enemy-status = dead
    ((?player-x - ?loot-x) * (?player-x - ?loot-x)) + ((?player-z - ?loot-z) * (?player-z - ?loot-z)) <= ?pickup-radius * ?pickup-radius
  withdraw
    ?loot loot state ?state
  include
    ?loot loot state acquired

on complete-objective ?objective
  when
    ?objective objective state Vec3 { x: ?state, y: ?branch, z: ?unused-state }
    player-1 position Vec3 { x: ?player-x, y: ?player-y, z: ?player-z }
    game-objective exit position Vec3 { x: ?exit-x, y: ?exit-y, z: ?exit-z }
    cinder-wraith enemy vitals Vec3 { x: ?vitality, y: ?maximum, z: ?alive-flag }
    ashen-key loot state ?loot-state
    ashen-key custody ?custodian
    ?state = 0.0
    ?vitality = 0.0
    ?loot-state = acquired
    ?custodian = player-1
    ?player-x = ?exit-x
    ?player-z = ?exit-z
  withdraw
    ?objective objective state Vec3 { x: ?state, y: ?branch, z: ?unused-state }
  include
    ?objective objective state Vec3 { x: 1.0, y: ?branch, z: ?unused-state }

on fail-objective ?objective
  when
    ?objective objective state Vec3 { x: ?state, y: ?branch, z: ?unused-state }
    player-1 player vitals Vec3 { x: ?vitality, y: ?maximum, z: ?alive-flag }
    ?state = 0.0
    ?vitality = 0.0
  withdraw
    ?objective objective state Vec3 { x: ?state, y: ?branch, z: ?unused-state }
  include
    ?objective objective state Vec3 { x: -1.0, y: ?branch, z: ?unused-state }

on clear-reset-signal ?objective
  when
    ?objective reset signal Vec3 { x: ?reset, y: ?phase, z: ?unused }
    player-1 position Vec3 { x: ?player-x, y: ?player-y, z: ?player-z }
    player-1 velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: ?velocity-z }
    player-1 grounded ?grounded
    player-1 horizontal intent Vec3 { x: ?intent-x, y: ?intent-y, z: ?intent-z }
    player-1 negative control Vec3 { x: ?negative-x, y: ?negative-y, z: ?negative-z }
    player-1 positive control Vec3 { x: ?positive-x, y: ?positive-y, z: ?positive-z }
    player-1 move speed ?move-speed
    player-1 base move speed ?base-speed
    player-1 booster energy ?energy
    player-1 booster capacity ?capacity
    player-1 booster regeneration delay ?regeneration-delay
    player-1 player vitals Vec3 { x: ?player-vitality, y: ?player-maximum, z: ?player-alive }
    player-1 status effect ?effect
    player-1 status clock ?status-clock
    cinder-wraith enemy vitals Vec3 { x: ?enemy-vitality, y: ?enemy-maximum, z: ?enemy-alive }
    cinder-wraith enemy pressure state ?pressure
    cinder-wraith enemy pressure clock ?clock
    cinder-bolt projectile position Vec3 { x: ?projectile-x, y: ?projectile-y, z: ?projectile-z }
    cinder-bolt projectile state ?projectile-state
    cinder-bolt projectile visible ?projectile-visible
    ashen-key loot position Vec3 { x: ?loot-x, y: ?loot-y, z: ?loot-z }
    game-objective objective state Vec3 { x: ?objective-state, y: ?branch, z: ?unused-state }
    ?reset = 1.0
    ?player-x = -2.0
    ?player-y = 0.0
    ?player-z = 0.5
    ?velocity-x = 0.0
    ?velocity-y = 0.0
    ?velocity-z = 0.0
    ?grounded = true
    ?intent-x = 0.0
    ?intent-y = 0.0
    ?intent-z = 0.0
    ?negative-x = 0.0
    ?negative-y = 0.0
    ?negative-z = 0.0
    ?positive-x = 0.0
    ?positive-y = 0.0
    ?positive-z = 0.0
    ?move-speed = ?base-speed
    ?energy = ?capacity
    ?regeneration-delay = 0.0
    ?player-vitality = ?player-maximum
    ?effect = clear
    ?status-clock = 12.0
    ?enemy-vitality = ?enemy-maximum
    ?pressure = approach
    ?clock = 0.0
    ?projectile-x = 2.0
    ?projectile-y = 0.55
    ?projectile-z = 0.0
    ?projectile-state = dormant
    ?projectile-visible = false
    ?loot-x = 1.2
    ?loot-z = -1.0
    ?objective-state = 0.0
  withdraw
    ?objective reset signal Vec3 { x: ?reset, y: ?phase, z: ?unused }
  include
    ?objective reset signal Vec3 { x: 0.0, y: ?phase, z: ?unused }

on reset-player-x ?player
  when
    ?player position Vec3 { x: ?player-x, y: ?player-y, z: ?player-z }
    game-objective reset signal Vec3 { x: ?reset, y: ?phase, z: ?unused }
    ?reset = 1.0
  withdraw
    ?player position Vec3 { x: ?player-x, y: ?player-y, z: ?player-z }
  include
    ?player position Vec3 { x: -2.0, y: ?player-y, z: ?player-z }

on reset-player-z ?player
