mode obstacle-radius given obstacle yields value: one

open-terrain:
  ?x shape F64
  ?z shape F64
  ?radius shape F64
  ?size shape F64
  ?open shape Bool
  point ?x ?z radius ?radius inside ?size as ?open

mode open-terrain given x z radius size yields open: maybe

step-component:
  ?position shape F64
  ?destination shape F64
  ?fraction shape F64
  ?step shape F64
  from ?position toward ?destination fraction ?fraction advances ?step

mode step-component given position destination fraction yields step: maybe

segment-projection:
  ?dx shape F64
  ?dz shape F64
  ?px shape F64
  ?pz shape F64
  ?along shape F64
  step ?dx ?dz toward relative point ?px ?pz projects ?along

mode segment-projection given dx dz px pz yields along: maybe

swept-footprint:
  ?dx shape F64
  ?dz shape F64
  ?px shape F64
  ?pz shape F64
  ?radius shape F64
  ?along shape F64
  ?blocked shape Bool
  step ?dx ?dz past relative point ?px ?pz radius ?radius along ?along blocked ?blocked

mode swept-footprint given dx dz px pz radius along yields blocked: maybe

travel-direction:
  ?forward shape F64
  ?right shape F64
  ?left shape F64
  ?direction shape F64
  paths forward ?forward right ?right left ?left choose ?direction

mode travel-direction given forward right left yields direction: maybe

