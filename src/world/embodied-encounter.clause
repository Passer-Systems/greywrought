    paths forward (?forward-units + ?forward-obstacles + if(?forward-terrain, 0.0, 1.0)) right (?right-units + ?right-obstacles + if(?right-terrain, 0.0, 1.0)) left (?left-units + ?left-obstacles + if(?left-terrain, 0.0, 1.0)) choose ?direction
