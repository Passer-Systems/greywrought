  subject arena
  mode given arena yields value: one

relation max-z
  reads {arena: Arena} maximum z {value: F64}
  subject arena
  mode given arena yields value: one

relation player-vitals
  reads {player: Player} player vitals {value: Vec3}
  subject player
  mode given player yields value: one

relation status-effect
  reads {player: Player} status effect {value: StatusEffect}
  subject player
  mode given player yields value: one

relation status-clock
  reads {player: Player} status clock {value: F64}
  subject player
  mode given player yields value: one

relation sword-action-sequence
  reads {player: Player} sword action sequence {value: F64}
  subject player
  mode given player yields value: one

relation sword-commitment-clock
  reads {player: Player} sword commitment clock {value: F64}
  subject player
  mode given player yields value: one

relation combat-target
  reads {player: Player} combat target {enemy: Enemy}
  subject player
  mode given player yields enemy: one

relation target-lock-active
  reads {player: Player} target lock active {value: Bool}
  subject player
  mode given player yields value: one

relation target-selection-sequence
  reads {player: Player} target selection sequence {value: F64}
  subject player
  mode given player yields value: one

relation combat-status
  reads {player: Player} combat status {value: CombatStatus}
  subject player
  mode given player yields value: one

