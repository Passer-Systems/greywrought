  include
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: 0.0 }

on reset-player-grounding ?player
  when
    ?player grounded ?was-grounded
    game-objective reset signal Vec3 { x: ?reset, y: ?phase, z: ?unused }
    ?reset = 1.0
  withdraw
    ?player grounded ?was-grounded
  include
    ?player grounded true

on reset-player-vitality ?player
  when
    ?player player vitals Vec3 { x: ?vitality, y: ?maximum, z: ?alive-flag }
    game-objective reset signal Vec3 { x: ?reset, y: ?phase, z: ?unused }
    ?reset = 1.0
  withdraw
    ?player player vitals Vec3 { x: ?vitality, y: ?maximum, z: ?alive-flag }
  include
    ?player player vitals Vec3 { x: 4.0, y: ?maximum, z: ?alive-flag }

on reset-player-status ?player
  when
    ?player combat status ?status
    game-objective reset signal Vec3 { x: ?reset, y: ?phase, z: ?unused }
    ?reset = 1.0
  withdraw
    ?player combat status ?status
  include
    ?player combat status alive

on reset-propulsion ?player
  when
    ?player horizontal intent Vec3 { x: ?intent-x, y: ?intent-y, z: ?intent-z }
    ?player negative control Vec3 { x: ?negative-x, y: ?negative-y, z: ?negative-z }
    ?player positive control Vec3 { x: ?positive-x, y: ?positive-y, z: ?positive-z }
    ?player move speed ?move-speed
    ?player base move speed ?base-speed
    ?player booster energy ?energy
    ?player booster capacity ?capacity
    ?player booster regeneration delay ?delay
    game-objective reset signal Vec3 { x: ?reset, y: ?phase, z: ?unused }
    ?reset = 1.0
  withdraw
    ?player horizontal intent Vec3 { x: ?intent-x, y: ?intent-y, z: ?intent-z }
    ?player negative control Vec3 { x: ?negative-x, y: ?negative-y, z: ?negative-z }
    ?player positive control Vec3 { x: ?positive-x, y: ?positive-y, z: ?positive-z }
    ?player move speed ?move-speed
    ?player booster energy ?energy
    ?player booster regeneration delay ?delay
  include
    ?player horizontal intent Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    ?player negative control Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    ?player positive control Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    ?player move speed ?base-speed
    ?player booster energy ?capacity
    ?player booster regeneration delay 0.0

on reset-player-effect ?player
  when
    ?player status effect ?effect
    game-objective reset signal Vec3 { x: ?reset, y: ?phase, z: ?unused }
    ?reset = 1.0
  withdraw
    ?player status effect ?effect
  include
    ?player status effect clear

on reset-player-effect-clock ?player
