    ?loot-z = -1.0
    ?key-state = hidden
    ?key-custodian = ?key-source
    ?cache-state = hidden
    ?cache-custodian = ?cache-source
    ?objective-state = 0.0
  withdraw
    ?objective reset signal Vec3 { x: ?reset, y: ?phase, z: ?unused }
  include
    ?objective reset signal Vec3 { x: 0.0, y: ?phase, z: ?unused }

