on resolve-warrior-third ?player
  when
    ?player ability request ?request
    ?request = third-request
    ?player character archetype ?archetype
    ?player class resource Vec3 { x: ?resource, y: ?maximum, z: ?regeneration }
    ?player ability cooldowns Vec3 { x: ?second-cooldown, y: ?cooldown, z: ?fourth-cooldown }
    ?player ability sequences Vec3 { x: ?first, y: ?second, z: ?third }
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: ?velocity-z }
    ?player camera forward Vec3 { x: ?camera-x, y: ?camera-y, z: ?camera-z }
    ?player grounded ?grounded
    ?player airborne factor ?airborne
    ?player last ability ?last
    ?archetype = warrior
    ?resource >= 10.0
    ?cooldown = 0.0
  withdraw
    ?player class resource Vec3 { x: ?resource, y: ?maximum, z: ?regeneration }
    ?player ability cooldowns Vec3 { x: ?second-cooldown, y: ?cooldown, z: ?fourth-cooldown }
    ?player ability sequences Vec3 { x: ?first, y: ?second, z: ?third }
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: ?velocity-z }
    ?player grounded ?grounded
    ?player airborne factor ?airborne
    ?player last ability ?last
  include
    ?player class resource Vec3 { x: ?resource - 10.0, y: ?maximum, z: ?regeneration }
    ?player ability cooldowns Vec3 { x: ?second-cooldown, y: 90.0, z: ?fourth-cooldown }
    ?player ability sequences Vec3 { x: ?first, y: ?second, z: ?third + 1.0 }
    ?player velocity Vec3 { x: ?camera-x * 18.0, y: 0.8, z: ?camera-z * 18.0 }
    ?player grounded false
    ?player airborne factor 1.0
    ?player last ability warrior-charge

on resolve-mage-third ?player
  when
    ?player ability request ?request
    ?request = third-request
    ?player character archetype ?archetype
    ?player class resource Vec3 { x: ?resource, y: ?maximum, z: ?regeneration }
    ?player ability cooldowns Vec3 { x: ?second-cooldown, y: ?cooldown, z: ?fourth-cooldown }
    ?player ability sequences Vec3 { x: ?first, y: ?second, z: ?third }
    ?player combat target ?target
    ?target enemy vitals Vec3 { x: ?vitality, y: ?enemy-maximum, z: ?alive }
    ?target enemy combat status ?target-status
    ?player last ability ?last
    (?vitality - 2.0) clamped between 0.0 and ?enemy-maximum as ?next-vitality
    ?archetype = mage
    ?resource >= 18.0
    ?cooldown = 0.0
    ?target-status = alive
  withdraw
    ?player class resource Vec3 { x: ?resource, y: ?maximum, z: ?regeneration }
    ?player ability cooldowns Vec3 { x: ?second-cooldown, y: ?cooldown, z: ?fourth-cooldown }
    ?player ability sequences Vec3 { x: ?first, y: ?second, z: ?third }
    ?target enemy vitals Vec3 { x: ?vitality, y: ?enemy-maximum, z: ?alive }
    ?player last ability ?last
  include
    ?player class resource Vec3 { x: ?resource - 18.0, y: ?maximum, z: ?regeneration }
    ?player ability cooldowns Vec3 { x: ?second-cooldown, y: 50.0, z: ?fourth-cooldown }
    ?player ability sequences Vec3 { x: ?first, y: ?second, z: ?third + 1.0 }
    ?target enemy vitals Vec3 { x: ?next-vitality, y: ?enemy-maximum, z: ?alive }
    ?player last ability fire-blast

on resolve-hunter-third ?player
  when
