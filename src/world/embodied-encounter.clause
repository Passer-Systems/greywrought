law clamp-lower
  if
    ?lower <= ?upper
    ?value < ?lower
  then
    ?value clamped between ?lower and ?upper as ?lower
law clamp-interior
  if
    ?lower <= ?value
    ?value <= ?upper
  then
    ?value clamped between ?lower and ?upper as ?value
law clamp-upper
  if
    ?lower <= ?upper
    ?value > ?upper
  then
    ?value clamped between ?lower and ?upper as ?upper
law full-damage
  if
    ?remaining <= 0.0
  then
    ?incoming damage after ward ?remaining as ?incoming
law warded-damage
  if
    ?remaining > 0.0
  then
    ?incoming damage after ward ?remaining as ?incoming * 0.5
derive clamp-lower
derive clamp-interior
derive clamp-upper
derive full-damage
derive warded-damage

law order-no-battle
  then
    order active false selected ?selected alive ?alive health ?health capable ?capable kind ?kind targetAlive ?targetAlive needed ?needed inRange ?inRange cooldown ?cooldown reports "No battle in progress"
law order-unselected
  then
    order active true selected false alive ?alive health ?health capable ?capable kind ?kind targetAlive ?targetAlive needed ?needed inRange ?inRange cooldown ?cooldown reports "Not selected"
law order-fallen
  then
    order active true selected true alive false health ?health capable ?capable kind ?kind targetAlive ?targetAlive needed ?needed inRange ?inRange cooldown ?cooldown reports "Unit has fallen"
law order-no-health
  if
    ?health <= 0.0
  then
    order active true selected true alive true health ?health capable ?capable kind ?kind targetAlive ?targetAlive needed ?needed inRange ?inRange cooldown ?cooldown reports "Unit has fallen"
law order-unavailable
  if
    ?health > 0.0
  then
    order active true selected true alive true health ?health capable false kind ?kind targetAlive ?targetAlive needed ?needed inRange ?inRange cooldown ?cooldown reports "Ability unavailable"
law order-wrong-target
  if
    ?health > 0.0
  then
    order active true selected true alive true health ?health capable true kind false targetAlive ?targetAlive needed ?needed inRange ?inRange cooldown ?cooldown reports "Wrong target"
law order-target-fallen
  if
    ?health > 0.0
  then
    order active true selected true alive true health ?health capable true kind true targetAlive false needed ?needed inRange ?inRange cooldown ?cooldown reports "Target has fallen"
law order-unneeded
  if
    ?health > 0.0
  then
    order active true selected true alive true health ?health capable true kind true targetAlive true needed false inRange ?inRange cooldown ?cooldown reports "Target already at full health"
law order-distant
  if
    ?health > 0.0
  then
    order active true selected true alive true health ?health capable true kind true targetAlive true needed true inRange false cooldown ?cooldown reports "Out of range"
law order-cooling
  if
    ?health > 0.0
    ?cooldown > 0.0
  then
    order active true selected true alive true health ?health capable true kind true targetAlive true needed true inRange true cooldown ?cooldown reports "Cooling down"
law order-ready
  if
    ?health > 0.0
    ?cooldown <= 0.0
  then
    order active true selected true alive true health ?health capable true kind true targetAlive true needed true inRange true cooldown ?cooldown reports "Ready"
derive order-no-battle
derive order-unselected
derive order-fallen
derive order-no-health
derive order-unavailable
derive order-wrong-target
derive order-target-fallen
derive order-unneeded
derive order-distant
derive order-cooling
derive order-ready

law hostile-order-readiness
  if
    order active ?active selected ?selected alive ?alive health ?health capable ?capable kind ?hostile targetAlive (?targetHealth > 0.0) needed true inRange ((?targetX - ?unitX) * (?targetX - ?unitX) + (?targetZ - ?unitZ) * (?targetZ - ?unitZ) <= ?range * ?range) cooldown ?cooldown reports ?message
  then
    hostile order active ?active selected ?selected alive ?alive health ?health capable ?capable hostile ?hostile targetHealth ?targetHealth from ?unitX ?unitZ to ?targetX ?targetZ range ?range cooldown ?cooldown reports ?message
derive hostile-order-readiness

law selected-living-formation
  if
    ?unit selected true
    ?unit alive true
    ?unit vitality ?health
    ?health > 0.0
    ?unit formation offset ?offset
  then
    ?unit selected formation ?offset
derive selected-living-formation

