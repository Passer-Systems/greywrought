  subject player
  mode given player yields value: one

relation horizontal-burst-displacement
  reads {player: Player} horizontal burst displacement {value: F64}
  subject player
  mode given player yields value: one

relation horizontal-burst-cost
  reads {player: Player} horizontal burst cost {value: F64}
  subject player
  mode given player yields value: one

relation vertical-sustain-thrust
  reads {player: Player} vertical sustain thrust {value: F64}
  subject player
  mode given player yields value: one

relation vertical-sustain-drain
  reads {player: Player} vertical sustain drain {value: F64}
  subject player
  mode given player yields value: one

relation vertical-burst-impulse
  reads {player: Player} vertical burst impulse {value: F64}
  subject player
  mode given player yields value: one

relation vertical-burst-cost
  reads {player: Player} vertical burst cost {value: F64}
  subject player
  mode given player yields value: one

relation floor-height
  reads {arena: Arena} floor height {value: F64}
  subject arena
  mode given arena yields value: one

relation min-x
  reads {arena: Arena} minimum x {value: F64}
  subject arena
  mode given arena yields value: one

relation max-x
  reads {arena: Arena} maximum x {value: F64}
  subject arena
  mode given arena yields value: one

relation min-z
