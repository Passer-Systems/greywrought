    sum 1.0 given ?x ?z ?step-x ?step-z ?radius where { ?obstacle obstacle position Vec3 { x: ?obstacle-x, y: ?obstacle-y, z: ?obstacle-z }; ?obstacle obstacle radius ?obstacle-radius; step ?step-x ?step-z toward relative point (?obstacle-x - ?x) (?obstacle-z - ?z) projects ?projection; ?projection clamped between 0.0 and 1.0 as ?along; step ?step-x ?step-z past relative point (?obstacle-x - ?x) (?obstacle-z - ?z) radius (?radius + ?obstacle-radius) along ?along blocked ?collision; ?collision = true } as ?forward-obstacles
    point (?x + (0.0 - ?step-z)) (?z + ?step-x) radius ?radius inside ?field-size as ?right-terrain
    sum 1.0 given ?unit ?x ?z ?step-x ?step-z ?priority ?radius ?dt where { ?other alive true; ?other actor position Vec3 { x: ?other-x, y: ?other-y, z: ?other-z }; ?other footprint radius ?other-radius; ?other movement speed ?other-speed; ?other moving ?other-moving; ?other formation offset Vec3 { x: ?other-priority, y: ?other-offset-y, z: ?other-offset-z }; (?other = ?unit) = false; step (0.0 - ?step-z) ?step-x toward relative point (?other-x - ?x) (?other-z - ?z) projects ?projection; ?projection clamped between 0.0 and 1.0 as ?along; step (0.0 - ?step-z) ?step-x past relative point (?other-x - ?x) (?other-z - ?z) radius (?radius + ?other-radius + if(?priority >= ?other-priority, if(?other-moving, ?other-speed * ?dt, 0.0), 0.0)) along ?along blocked ?collision; ?collision = true } as ?right-units
    sum 1.0 given ?x ?z ?step-x ?step-z ?radius where { ?obstacle obstacle position Vec3 { x: ?obstacle-x, y: ?obstacle-y, z: ?obstacle-z }; ?obstacle obstacle radius ?obstacle-radius; step (0.0 - ?step-z) ?step-x toward relative point (?obstacle-x - ?x) (?obstacle-z - ?z) projects ?projection; ?projection clamped between 0.0 and 1.0 as ?along; step (0.0 - ?step-z) ?step-x past relative point (?obstacle-x - ?x) (?obstacle-z - ?z) radius (?radius + ?obstacle-radius) along ?along blocked ?collision; ?collision = true } as ?right-obstacles
    point (?x + ?step-z) (?z + (0.0 - ?step-x)) radius ?radius inside ?field-size as ?left-terrain
    sum 1.0 given ?unit ?x ?z ?step-x ?step-z ?priority ?radius ?dt where { ?other alive true; ?other actor position Vec3 { x: ?other-x, y: ?other-y, z: ?other-z }; ?other footprint radius ?other-radius; ?other movement speed ?other-speed; ?other moving ?other-moving; ?other formation offset Vec3 { x: ?other-priority, y: ?other-offset-y, z: ?other-offset-z }; (?other = ?unit) = false; step ?step-z (0.0 - ?step-x) toward relative point (?other-x - ?x) (?other-z - ?z) projects ?projection; ?projection clamped between 0.0 and 1.0 as ?along; step ?step-z (0.0 - ?step-x) past relative point (?other-x - ?x) (?other-z - ?z) radius (?radius + ?other-radius + if(?priority >= ?other-priority, if(?other-moving, ?other-speed * ?dt, 0.0), 0.0)) along ?along blocked ?collision; ?collision = true } as ?left-units
