bind referent-input PickComponent as Component to pick-component
bind referent-input WireComponent as Component to wire-component
bind referent-input ChooseDoctrine as Doctrine to choose-doctrine
bind referent-input FitComponent as BodyPart to fit-component
bind keyboard UnequipComponent down to unequip-component
bind keyboard RestCreature down to rest-creature
bind keyboard DisconnectComponent down to disconnect-component
bind keyboard RepairComponent down to repair-component
bind keyboard LaunchExpedition down to launch-expedition
bind keyboard WithdrawExpedition down to withdraw-expedition

on pick-component ?workshop ?picked
  when
    ?workshop selected ?prior
    ?picked health ?health
  withdraw
    ?workshop selected ?prior
  include
    ?workshop selected ?picked

on wire-component ?workshop ?upstream
  when
    ?workshop phase ?phase
    ?phase != "Expedition"
    ?workshop selected ?component
    ?component upstream ?prior
    ?component linked ?linked
    ?upstream health ?health
  withdraw
    ?component upstream ?prior
    ?component linked ?linked
  include
    ?component upstream ?upstream
    ?component linked true

on fit-component ?workshop ?part
  when
    ?workshop phase ?phase
    ?workshop selected ?component
    ?workshop fit-report ?prior
    ?component accepted-kind ?expected
    ?part part-kind ?actual
    sum 1.0 given ?component ?part where { ?component available-fit ?part } as ?available
  withdraw
    ?workshop fit-report ?prior
  include
    ?workshop fit-report if(?phase = "Expedition", "Return before changing equipment.", if(?expected = ?actual, if(?available > 0.0, "Equipment fitted to the selected body part.", "That body part has no free attachment slot."), "That equipment does not fit this body part."))

on fit-component ?workshop ?part
  when
    ?workshop selected ?component
    ?component available-fit ?part
    ?component attached-to ?prior
  withdraw
    ?component attached-to ?prior
  include
    ?component attached-to ?part

on fit-component ?workshop ?part
  when
    ?workshop selected ?component
    ?component available-fit ?part
    sum 1.0 given ?component where { ?component attached-to ?prior } as ?attached
    ?attached = 0.0
  include
    ?component attached-to ?part

on unequip-component ?workshop
  when
    ?workshop phase ?phase
    ?phase != "Expedition"
    ?workshop selected ?component
    ?component attached-to ?part
  withdraw
    ?component attached-to ?part

on rest-creature ?part
  when
    workshop phase ?phase
    ?phase != "Expedition"
    ?part part-health ?health
    ?part max-part-health ?maximum
  withdraw
    ?part part-health ?health
  include
    ?part part-health ?maximum

on disconnect-component ?workshop
  when
    ?workshop phase ?phase
    ?phase != "Expedition"
    ?workshop selected ?component
    ?component linked ?prior
  withdraw
    ?component linked ?prior
  include
    ?component linked false

on repair-component ?workshop
  when
    ?workshop phase ?phase
    ?phase != "Expedition"
    ?workshop selected ?component
    ?component health ?health
    ?component max-health ?maximum
    ?health < ?maximum
    ?workshop stock ?stock
    ?stock >= 1.0
    (?stock * 4.0) bounded by 0.0 and (?maximum - ?health) as ?repair
  withdraw
    ?component health ?health
    ?workshop stock ?stock
  include
    ?component health ?health + ?repair
    ?workshop stock ?stock - ?repair / 4.0

on choose-doctrine ?workshop ?picked
  when
    ?workshop doctrine ?prior
    ?picked heat-limit ?limit
  withdraw
    ?workshop doctrine ?prior
  include
    ?workshop doctrine ?picked

on launch-expedition ?workshop
  when
    ?workshop phase ?phase
    ?phase != "Expedition"
    ?workshop position ?position
    ?workshop heat ?heat
    ?workshop reserve ?reserve
    ?workshop cargo ?cargo
    ?workshop threat-health ?enemy
    ?workshop threat-maximum ?maximum
    ?workshop withdrawing ?withdraw
    ?workshop report ?report
  withdraw
    ?workshop phase ?phase
    ?workshop position ?position
    ?workshop heat ?heat
    ?workshop reserve ?reserve
    ?workshop cargo ?cargo
    ?workshop threat-health ?enemy
    ?workshop withdrawing ?withdraw
    ?workshop report ?report
  include
    ?workshop phase "Expedition"
    ?workshop position 0.0
    ?workshop heat 0.0
    ?workshop reserve 100.0
    ?workshop cargo 0.0
    ?workshop threat-health ?maximum
    ?workshop withdrawing false
    ?workshop report "The wayfarer sets out toward the ashfield sentinel."

on withdraw-expedition ?workshop
  when
    ?workshop phase "Expedition"
    ?workshop withdrawing ?prior
  withdraw
    ?workshop withdrawing ?prior
  include
    ?workshop withdrawing true

on tick ?workshop ?dt
  when
    ?workshop phase ?phase
    ?workshop total-mass ?old-mass
    ?workshop available-power ?old-power
    ?workshop drive-power ?old-drive
    ?workshop weapon-power ?old-weapon
    ?workshop cooling-power ?old-cooling
    ?workshop capacity Capacity { mass: ?mass, power: ?power, drive: ?drive, weapon: ?weapon, cooling: ?cooling, drive-draw: ?drive-draw, weapon-draw: ?weapon-draw, cooling-draw: ?cooling-draw }
  withdraw
    ?workshop total-mass ?old-mass
    ?workshop available-power ?old-power
    ?workshop drive-power ?old-drive
    ?workshop weapon-power ?old-weapon
    ?workshop cooling-power ?old-cooling
  include
    ?workshop total-mass ?mass
    ?workshop available-power ?power
    ?workshop drive-power ?drive
    ?workshop weapon-power ?weapon
    ?workshop cooling-power ?cooling

on tick ?workshop ?dt
  when
    ?workshop phase "Expedition"
    ?workshop position ?position
    ?workshop encounter-position ?destination
    ?workshop heat ?heat
    ?workshop reserve ?reserve
    ?workshop stock ?stock
    ?workshop cargo ?cargo
    ?workshop doctrine ?doctrine
    ?doctrine heat-limit ?heat-limit
    ?doctrine reserve-floor ?reserve-floor
    ?workshop report ?report
    ?workshop threat-health ?enemy
    ?workshop threat-maximum ?maximum
    ?workshop withdrawing ?withdraw
    ?workshop action ?old-action
    ?workshop objective ?target
    wayfarer baseline-speed ?baseline
    wayfarer body-mass ?body-mass
    wayfarer creature-condition ?condition
    wayfarer retreat-condition ?retreat-condition
    legs part-health ?legs
    legs max-part-health ?maximum-legs
    ?workshop capacity Capacity { mass: ?mass, power: ?power, drive: ?drive, weapon: ?weapon, cooling: ?cooling, drive-draw: ?drive-draw, weapon-draw: ?weapon-draw, cooling-draw: ?cooling-draw }
    ((?baseline * ?body-mass * ?legs / ?maximum-legs + ?drive) / (?body-mass + ?mass)) bounded by 0.0 and 8.0 as ?speed
    pilot at ?position destination ?destination enemy ?enemy heat ?heat reserve ?reserve cargo ?cargo target ?target heat-limit ?heat-limit reserve-floor ?reserve-floor drive ?speed weapon ?weapon withdraw if(?condition <= ?retreat-condition, true, ?withdraw) prior-action ?old-action chooses ?action
    if(?action = 1.0, ?position + ?speed * ?dt, if(?action = 0.0, ?position - ?speed * ?dt, ?position)) bounded by 0.0 and ?destination as ?next-position
    (?heat + if(?action = 2.0, 15.0, if(?action = 1.0, 2.0, 0.0)) * ?dt - (1.0 + if(?power >= if(?action = 2.0, ?weapon-draw + ?cooling-draw, if(?action = 3.0, ?cooling-draw, ?drive-draw + ?cooling-draw)), ?cooling, 0.0)) * ?dt) bounded by 0.0 and 150.0 as ?next-heat
    (?reserve - if(?action = 2.0, 2.2, 0.7) * ?dt) bounded by 0.0 and 100.0 as ?next-reserve
    (?enemy - if(?action = 2.0, ?weapon * ?dt, 0.0)) bounded by 0.0 and ?maximum as ?next-enemy
  withdraw
    ?workshop phase "Expedition"
    ?workshop position ?position
    ?workshop heat ?heat
    ?workshop reserve ?reserve
    ?workshop stock ?stock
    ?workshop cargo ?cargo
    ?workshop report ?report
    ?workshop threat-health ?enemy
    ?workshop action ?old-action
    ?workshop withdrawing ?withdraw
  include
    ?workshop phase if(?action = 0.0, if(?next-position <= 0.0, "Returned", "Expedition"), "Expedition")
    ?workshop position ?next-position
    ?workshop heat ?next-heat
    ?workshop reserve ?next-reserve
    ?workshop stock if(?action = 0.0, if(?next-position <= 0.0, ?stock + ?cargo, ?stock), ?stock)
    ?workshop cargo if(?action = 4.0, ?cargo + 3.0 * ?dt, ?cargo)
    ?workshop threat-health ?next-enemy
    ?workshop action ?action
    ?workshop withdrawing if(?action = 0.0, true, ?withdraw)
    ?workshop report if(?action = 0.0, if(?next-position <= 0.0, "Back at the workshop. Salvage banked; injuries and equipment wear remain.", if(?condition <= ?retreat-condition, "The wayfarer is too injured to press on and is heading home.", if(?drive <= 0.0, "The braces have no power. The wayfarer is returning on foot.", "The wayfarer is withdrawing with remaining reserve."))), if(?action = 1.0, "Approaching the sentinel. Equipment weight and leg condition set the pace.", if(?action = 2.0, "The wayfarer fires the arm-mounted lance; heat is rising.", if(?action = 3.0, "Holding fire to cool within the chosen heat limit.", "Sentinel defeated. Gathering salvage."))))

on tick ?component ?dt
  when
    workshop phase "Expedition"
    workshop position ?position
    workshop encounter-position ?destination
    workshop threat-health ?enemy
    workshop heat ?heat
    ?component mounted true
    ?component attached-to ?part
    ?component health ?health
    ?health > 0.0
    sum ?protection given ?part where { ?armor attached-to ?part; ?armor mounted true; ?armor health ?health; ?health > 0.0; ?armor protection ?protection } as ?protection
    (?health - if(?position >= ?destination - 3.0, if(?enemy > 0.0, 1.8 * ?dt / (1.0 + ?protection), 0.0), 0.0) - if(?heat > 70.0, (?heat - 70.0) * 0.035 * ?dt, 0.0)) bounded by 0.0 and ?health as ?next-health
  withdraw
    ?component health ?health
  include
    ?component health ?next-health

on tick ?part ?dt
  when
    workshop phase "Expedition"
    workshop position ?position
    workshop encounter-position ?destination
    workshop threat-health ?enemy
    workshop heat ?heat
    ?part part-health ?health
    ?part max-part-health ?maximum
    sum ?protection given ?part where { ?armor attached-to ?part; ?armor mounted true; ?armor health ?health; ?health > 0.0; ?armor protection ?protection } as ?protection
    (?health - if(?position >= ?destination - 3.0, if(?enemy > 0.0, 0.8 * ?dt / (1.0 + ?protection), 0.0), 0.0) - if(?heat > 70.0, (?heat - 70.0) * 0.02 * ?dt / (1.0 + ?protection), 0.0)) bounded by 0.0 and ?maximum as ?next-health
  withdraw
    ?part part-health ?health
  include
    ?part part-health ?next-health
