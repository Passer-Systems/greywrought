bind referent-input PickComponent as Component to pick-component
bind referent-input WireComponent as Component to wire-component
bind referent-input FitComponent as BodyPart to fit-component
bind keyboard UnequipComponent down to unequip-component
bind keyboard RestCreature down to rest-creature
bind keyboard DisconnectComponent down to disconnect-component
bind keyboard RepairComponent down to repair-component

on pick-component ?workshop ?picked
  when
    ?workshop selected ?prior
    ?picked health ?health
  withdraw
    ?workshop selected ?prior
  include
    ?workshop selected ?picked

on wire-component ?workshop ?upstream
  when
    ?workshop phase ?phase
    if(?phase = "Workshop", true, ?phase = "Returned") = true
    ?workshop selected ?component
    ?component:
      upstream: ?prior
      linked: ?linked
    ?upstream health ?health
  withdraw
    ?component:
      upstream: ?prior
      linked: ?linked
  include
    ?component:
      upstream: ?upstream
      linked: true

on fit-component ?workshop ?part
  when
    ?workshop:
      phase: ?phase
      selected: ?component
      fit-report: ?prior
    ?component accepted-kind ?expected
    ?part part-kind ?actual
    sum 1.0 given ?component ?part where { ?component available-fit ?part } as ?available
  withdraw
    ?workshop fit-report ?prior
  include
    ?workshop fit-report if(?phase = "Expedition", "Return before changing equipment.", if(?expected = ?actual, if(?available > 0.0, "Equipment fitted to the selected body part.", "That body part has no free attachment slot."), "That equipment does not fit this body part."))

on fit-component ?workshop ?part
  when
    ?workshop selected ?component
    ?component:
      available-fit: ?part
      attached-to: ?prior
  withdraw
    ?component attached-to ?prior
  include
    ?component attached-to ?part

on fit-component ?workshop ?part
  when
    ?workshop selected ?component
    ?component available-fit ?part
    sum 1.0 given ?component where { ?component attached-to ?prior } as ?attached
    ?attached = 0.0
  include
    ?component attached-to ?part

on unequip-component ?workshop
  when
    ?workshop phase ?phase
    if(?phase = "Workshop", true, ?phase = "Returned") = true
    ?workshop selected ?component
    ?component attached-to ?part
  withdraw
    ?component attached-to ?part

on rest-creature ?part
  when
    workshop phase ?phase
    if(?phase = "Workshop", true, ?phase = "Returned") = true
    ?part:
      part-health: ?health
      max-part-health: ?maximum
  withdraw
    ?part part-health ?health
  include
    ?part part-health ?maximum

on disconnect-component ?workshop
  when
    ?workshop phase ?phase
    if(?phase = "Workshop", true, ?phase = "Returned") = true
    ?workshop selected ?component
    ?component linked ?prior
  withdraw
    ?component linked ?prior
  include
    ?component linked false

on repair-component ?workshop
  when
    ?workshop phase ?phase
    if(?phase = "Workshop", true, ?phase = "Returned") = true
    ?workshop selected ?component
    ?component:
      health: ?health
      max-health: ?maximum
    ?health < ?maximum
    ?workshop stock ?stock
    ?stock >= 1.0
    (?stock * 4.0) bounded by 0.0 and (?maximum - ?health) as ?repair
  withdraw
    ?component health ?health
    ?workshop stock ?stock
  include
    ?component health ?health + ?repair
    ?workshop stock ?stock - ?repair / 4.0


