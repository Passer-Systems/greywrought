workshop
  selected-threat: scout

law readable-current-intent
  if
    ?enemy active-threat ?active
    ?enemy enemy-health ?health
    ?enemy intent-stage ?stage
    ?enemy intent-preparation ?preparation
    ?enemy intent-action ?action
  then
    ?enemy current-intent if(?active, if(?health > 0.0, if(?stage = 0.0, ?preparation, ?action), "Cleared"), "Dormant until called")
derive readable-current-intent
law readable-upcoming-intent
  if
    ?enemy active-threat ?active
    ?enemy enemy-health ?health
    ?enemy intent-stage ?stage
    ?enemy intent-preparation ?preparation
    ?enemy intent-action ?action
  then
    ?enemy upcoming-intent if(?active, if(?health > 0.0, if(?stage = 0.0, ?action, ?preparation), "Route remains clear"), "Offer six frost cores at the deep grove")
derive readable-upcoming-intent

