  intent-noise: 0.0
  intent-reach: 5.0
  obstacle-benefit: "Clear the warder to gather frost cores without cutting thorns."

patrol
  threat-name: "Ash hound patrol"
  threat-position:
    x: 3.0
    z: 35.0
  enemy-health: 36.0
  maximum-enemy-health: 36.0
  active-threat: true
  intent-stage: 0.0
  intent-remaining: 3.0
  intent-preparation: "Sweeping the trail"
  intent-action: "Charging the company"
  intent-damage: 10.0
  intent-noise: 0.0
  intent-reach: 7.0
  obstacle-benefit: "Clear the patrol to prevent ambushes during retreat."

ritual-guardian
  threat-name: "Called frost guardian"
  threat-position:
    x: 2.0
    z: 40.0
  enemy-health: 48.0
  maximum-enemy-health: 48.0
  active-threat: false
  intent-stage: 0.0
  intent-remaining: 3.0
  intent-preparation: "Drawing a freezing breath"
  intent-action: "Frost torrent"
  intent-damage: 20.0
  intent-noise: 0.0
  intent-reach: 3.0
  obstacle-benefit: "Defeat the deliberately called guardian, then extract its frost relic."

bind referent-input TargetThreat as ForestThreat to target-threat
bind keyboard StrikeThreat down to strike-threat
bind keyboard Brace down to brace
bind keyboard CallRitual down to call-ritual

on target-threat ?workshop ?target
  when
    ?workshop connected true
    ?workshop selected-threat ?prior
    ?target threat-name ?name
  withdraw
    ?workshop selected-threat ?prior
  include
    ?workshop selected-threat ?target

on tick ?enemy ?dt
  when
    workshop phase ?phase
    if(?phase = "Workshop", true, ?phase = "Returned") = true
    workshop position Position { x: ?x, z: ?z }
    ?z >= 2.0
    workshop connected true
    torso part-health ?living
    ?living > 0.0
    ?enemy enemy-health ?health
    ?enemy maximum-enemy-health ?maximum
    ?enemy active-threat ?active
    ?enemy intent-stage ?stage
    ?enemy intent-remaining ?remaining
  withdraw
    ?enemy enemy-health ?health
    ?enemy active-threat ?active
    ?enemy intent-stage ?stage
    ?enemy intent-remaining ?remaining
  include
    ?enemy enemy-health ?maximum
    ?enemy active-threat if(?enemy = ritual-guardian, false, true)
    ?enemy intent-stage 0.0
    ?enemy intent-remaining 3.0

on strike-threat ?workshop
  when
    ?workshop phase "Expedition"
    ?workshop connected true
    torso part-health ?living
    ?living > 0.0
    ?workshop position Position { x: ?x, z: ?z }
    ?workshop selected-threat ?target
    ?target threat-position Position { x: ?target-x, z: ?target-z }
    ?target active-threat true
    ?target enemy-health ?health
    ?health > 0.0
    (?x - ?target-x) * (?x - ?target-x) + (?z - ?target-z) * (?z - ?target-z) <= 12.25
    ?workshop action-cooldown ?cooldown
    ?cooldown <= 0.0
    ?workshop party-size ?party
    ?workshop banked-relics ?relics
    ?workshop capacity Capacity { mass: ?mass, power: ?power, drive: ?drive, weapon: ?weapon, cooling: ?cooling, drive-draw: ?drive-draw, weapon-draw: ?weapon-draw, cooling-draw: ?cooling-draw }
    ?weapon > 0.0
  withdraw
    ?workshop action-cooldown ?cooldown
  include
    ?workshop action-cooldown 2.0 / (1.0 + ?cooling / 20.0)
  accumulate
    ?target enemy-health 0.0 - (?weapon + 4.0 * (?party - 1.0) + 4.0 * ?relics)
    ?workshop presence 1.0 + 0.1 * (?party - 1.0)

on brace ?workshop
  when
    ?workshop phase "Expedition"
    ?workshop connected true
    torso part-health ?living
    ?living > 0.0
    ?workshop action-cooldown ?cooldown
    ?cooldown <= 0.0
    ?workshop guard-remaining ?guard
  withdraw
    ?workshop action-cooldown ?cooldown
    ?workshop guard-remaining ?guard
  include
    ?workshop action-cooldown 1.0
    ?workshop guard-remaining 3.0

on tick ?workshop ?dt
  when
    ?workshop connected true
    ?workshop guard-remaining ?guard
    ?guard > 0.0
  withdraw
    ?workshop guard-remaining ?guard
  include
    ?workshop guard-remaining if(?guard > ?dt, ?guard - ?dt, 0.0)

on tick ?enemy ?dt
  when
    workshop phase "Expedition"
    workshop connected true
    torso part-health ?living
    ?living > 0.0
    ?enemy active-threat true
    ?enemy enemy-health ?health
    ?health > 0.0
    ?enemy intent-remaining ?remaining
    ?enemy intent-stage ?stage
  withdraw
    ?enemy intent-remaining ?remaining
    ?enemy intent-stage ?stage
  include
    ?enemy intent-remaining if(?remaining > ?dt, ?remaining - ?dt, 3.0)
    ?enemy intent-stage if(?remaining > ?dt, ?stage, if(?stage = 0.0, 1.0, 0.0))

on tick ?enemy ?dt
  when
    workshop phase "Expedition"
    workshop connected true
    torso part-health ?living
    ?living > 0.0
    workshop position Position { x: ?x, z: ?z }
    ?z > 0.0
    workshop presence ?presence
    workshop guard-remaining ?guard
    ?enemy active-threat true
    ?enemy enemy-health ?health
    ?health > 0.0
    ?enemy intent-stage 0.0
    ?enemy intent-remaining ?remaining
    ?remaining <= ?dt
    ?enemy threat-position Position { x: ?enemy-x, z: ?enemy-z }
    ?enemy intent-reach ?reach
    (?x - ?enemy-x) * (?x - ?enemy-x) + (?z - ?enemy-z) * (?z - ?enemy-z) <= ?reach * ?reach
    ?enemy intent-damage ?damage
    ?enemy intent-noise ?noise
    sum ?protection where { ?armor attached-to torso; ?armor mounted true; ?armor protection ?protection; ?armor health ?health; ?health > 0.0 } as ?protection
  accumulate
    torso part-health 0.0 - ?damage * (1.0 + ?presence / 100.0) * if(?guard > 0.0, 0.5, 1.0) / (1.0 + ?protection * 0.1)
    workshop presence ?noise

on gather-resource ?workshop
  when
    ?workshop phase "Expedition"
    ?workshop connected true
    torso part-health ?health
    ?health > 0.0
    ?workshop position Position { x: ?x, z: ?z }
    frost-cores place-position Position { x: ?resource-x, z: ?resource-z }
    (?x - ?resource-x) * (?x - ?resource-x) + (?z - ?resource-z) * (?z - ?resource-z) <= 9.0
    ?workshop resource-remaining ?remaining
    ?remaining >= 3.0
    ?workshop action-cooldown ?cooldown
    ?cooldown <= 0.0
    warder enemy-health ?warder
    ?warder > 0.0
    ?workshop guard-remaining ?guard
  accumulate
    torso part-health if(?guard > 0.0, -4.0, -8.0)

on call-ritual ?workshop
  when
    ?workshop phase "Expedition"
    ?workshop connected true
    torso part-health ?living
    ?living > 0.0
    ?workshop position Position { x: ?x, z: ?z }
    ritual-site place-position Position { x: ?resource-x, z: ?resource-z }
    (?x - ?resource-x) * (?x - ?resource-x) + (?z - ?resource-z) * (?z - ?resource-z) <= 9.0
    ?workshop cargo ?cargo
    ?cargo >= 6.0
    ?workshop ritual-called false
    ?workshop action-cooldown ?cooldown
    ?cooldown <= 0.0
    ?workshop report ?report
    ritual-guardian active-threat false
  withdraw
    ?workshop cargo ?cargo
    ?workshop ritual-called false
    ?workshop action-cooldown ?cooldown
    ?workshop report ?report
    ritual-guardian active-threat false
  include
    ?workshop cargo ?cargo - 6.0
    ?workshop ritual-called true
    ?workshop action-cooldown 1.0
    ?workshop report "Six cores offered. The frost guardian answers; its relic still has to be carried home."
    ritual-guardian active-threat true
  accumulate
    ?workshop presence 12.0

on tick ?workshop ?dt
  when
    ?workshop phase "Expedition"
    ?workshop connected true
    torso part-health ?living
    ?living > 0.0
    ?workshop ritual-called true
    ritual-guardian enemy-health ?health
    ?health <= 0.0
    ?workshop carried-relics 0.0
    ?workshop report ?report
  withdraw
    ?workshop carried-relics 0.0
    ?workshop report ?report
  include
    ?workshop carried-relics 1.0
    ?workshop report "The frost relic is in your pack. Reach Hearthstead alive to keep it."

on tick ?workshop ?dt
  when
    ?workshop phase "Expedition"
    torso part-health ?health
    ?health <= 0.0
    ?workshop cargo ?cargo
    ?workshop stock ?stock
    ?workshop carried-relics ?carried
    ?workshop banked-relics ?banked
    ?workshop report ?report
  withdraw
    ?workshop phase "Expedition"
    ?workshop cargo ?cargo
    ?workshop stock ?stock
    ?workshop carried-relics ?carried
    ?workshop banked-relics ?banked
    ?workshop report ?report
  include
    ?workshop phase "Lost"
    ?workshop cargo 0.0
    ?workshop stock 0.0
    ?workshop carried-relics 0.0
    ?workshop banked-relics 0.0
    ?workshop report "The wayfarer is lost. Equipment, carried rewards and personal stores are gone."

on tick ?component ?dt
  when
    workshop phase "Expedition"
    torso part-health ?health
    ?health <= 0.0
    ?component health ?prior
  withdraw
    ?component health ?prior
  include
    ?component health 0.0
on tick ?part ?dt
  when
    workshop phase "Expedition"
    torso part-health ?health
    ?health <= 0.0
    ?part part-health ?prior
  withdraw
    ?part part-health ?prior
  include
    ?part part-health 0.0

Landmark
place-name
  domain: Landmark
  range: Text
  cardinality: one
place-position
  domain: Landmark
  range: Position
  cardinality: one
hearthstead
  place-name: "Hearthstead"
  place-position:
    x: 0.0
    z: -8.0
forest-gate
  place-name: "North gate / return to safety"
  place-position:
    x: 0.0
    z: 0.0
frost-cores
  place-name: "Frost cores / G to gather"
  place-position:
    x: -2.0
    z: 12.0
ritual-site
  place-name: "Deep grove / R to offer six cores"
  place-position:
    x: 2.0
    z: 40.0

move-x
  domain: Workshop
  range: F64
  cardinality: one
move-z
  domain: Workshop
  range: F64
  cardinality: one
move-remaining
  domain: Workshop
  range: F64
  cardinality: one
workshop
  move-x: 0.0
  move-z: 0.0
  move-remaining: 0.0
bind scalar-input MoveX to move-x
bind scalar-input MoveZ to move-z
on move-x ?workshop ?value
  when
    ?workshop move-x ?old
    ?value bounded by -1.0 and 1.0 as ?bounded
  withdraw
    ?workshop move-x ?old
  include
    ?workshop move-x ?bounded
on move-z ?workshop ?value
  when
    ?workshop move-z ?old
    ?workshop move-remaining ?remaining
    ?value bounded by -1.0 and 1.0 as ?bounded
  withdraw
    ?workshop move-z ?old
    ?workshop move-remaining ?remaining
  include
    ?workshop move-z ?bounded
    ?workshop move-remaining 0.25
on tick ?workshop ?dt
  when
    ?workshop move-remaining ?remaining
    ?remaining > 0.0
  withdraw
    ?workshop move-remaining ?remaining
  include
    ?workshop move-remaining if(?remaining > ?dt, ?remaining - ?dt, 0.0)
on tick ?workshop ?dt
  when
    ?workshop phase ?phase
    ?phase != "Lost"
    ?workshop connected true
    torso part-health ?health
    ?health > 0.0
    ?workshop position Position { x: ?x, z: ?z }
    ?workshop move-x ?mx
    ?workshop move-z ?mz
    ?workshop move-remaining ?remaining
    ?remaining > 0.0
    ?mx * ?mx + ?mz * ?mz > 0.0
    sqrt(?mx * ?mx + ?mz * ?mz) bounded by 1.0 and 2.0 as ?length
    (?x + ?mx * 4.5 * ?dt / ?length) bounded by -12.0 and 12.0 as ?nx
    (?z + ?mz * 4.5 * ?dt / ?length) bounded by -14.0 and 45.0 as ?nz
    nest enemy-health ?nest
    if(?nz >= -0.5, if(?nz <= 4.0, ?nx * ?nx <= 9.0, true), true) = true
    if(?nz >= 18.0, if(?nz <= 24.0, if(?nest > 0.0, ?nx <= 2.0, true), true), true) = true
  withdraw
    ?workshop position Position { x: ?x, z: ?z }
  include
    ?workshop position Position { x: ?nx, z: ?nz }
on tick ?workshop ?dt
  when
    ?workshop phase "Expedition"
    ?workshop connected true
    ?workshop move-remaining ?remaining
    ?remaining > 0.0
    ?workshop move-x ?mx
    ?workshop move-z ?mz
    ?mx * ?mx + ?mz * ?mz > 0.0
    ?workshop party-size ?party
    torso part-health ?health
    ?health > 0.0
  accumulate
    ?workshop presence (0.4 + 0.04 * (?party - 1.0)) * ?dt

elevation
  domain: Workshop
  range: F64
  cardinality: one
vertical-speed
  domain: Workshop
  range: F64
  cardinality: one
potions
  domain: Workshop
  range: F64
  cardinality: one
shop-open
  domain: Workshop
  range: Bool
  cardinality: one
shop-status
  domain: Workshop
  range: Text
  cardinality: one
seller-near
  domain: Workshop
  range: Bool
  cardinality: maybe
Merchant
potion-price
  domain: Merchant
  range: F64
  cardinality: one
potion-healing
  domain: Merchant
  range: F64
  cardinality: one

workshop
  elevation: 0.0
  vertical-speed: 0.0
  potions: 0.0
  shop-open: false
  shop-status: "Mara sells health potions beside the Hearthstead road."
mara
  place-name: "Mara / Apothecary / F to talk"
  place-position:
    x: 3.4
    z: -7.5
  potion-price: 3.0
  potion-healing: 30.0

law seller-near
  if
    workshop position Position { x: ?x, z: ?z }
    mara place-position Position { x: ?sx, z: ?sz }
  then
    workshop seller-near ((?x - ?sx) * (?x - ?sx) + (?z - ?sz) * (?z - ?sz) <= 6.25)
derive seller-near

bind keyboard Jump down to jump
bind keyboard Interact down to interact
bind keyboard CloseShop down to close-shop
bind keyboard BuyPotion down to buy-potion
bind keyboard DrinkPotion down to drink-potion

on jump ?workshop
  when
    ?workshop connected true
    torso part-health ?health
    ?health > 0.0
    ?workshop elevation 0.0
    ?workshop vertical-speed 0.0
  withdraw
    ?workshop vertical-speed 0.0
  include
    ?workshop vertical-speed 5.5

on tick ?workshop ?dt
  when
    ?workshop connected true
    ?workshop elevation ?height
    ?workshop vertical-speed ?speed
    if(?height > 0.0, true, ?speed > 0.0) = true
  withdraw
    ?workshop elevation ?height
    ?workshop vertical-speed ?speed
  include
    ?workshop elevation if(?height + ?speed * ?dt - 7.0 * ?dt * ?dt > 0.0, ?height + ?speed * ?dt - 7.0 * ?dt * ?dt, 0.0)
    ?workshop vertical-speed if(?height + ?speed * ?dt - 7.0 * ?dt * ?dt > 0.0, ?speed - 14.0 * ?dt, 0.0)

on interact ?workshop
  when
    ?workshop connected true
    torso part-health ?health
    ?health > 0.0
    ?workshop seller-near ?near
    ?workshop shop-open ?open
    ?workshop shop-status ?status
  withdraw
    ?workshop shop-open ?open
    ?workshop shop-status ?status
  include
    ?workshop shop-open ?near
    ?workshop shop-status if(?near, "Mara: A little preparation goes a long way.", "Approach Mara beside the Hearthstead road to trade.")

on close-shop ?workshop
  when
    ?workshop shop-open true
  withdraw
    ?workshop shop-open true
  include
    ?workshop shop-open false

on buy-potion ?workshop
  when
    ?workshop connected true
    torso part-health ?health
    ?health > 0.0
    ?workshop shop-open true
    ?workshop seller-near ?near
    ?workshop stock ?stock
    ?workshop potions ?potions
    ?workshop shop-status ?status
    mara potion-price ?price
  withdraw
    ?workshop stock ?stock
    ?workshop potions ?potions
    ?workshop shop-status ?status
  include
    ?workshop stock if(?near, if(?stock >= ?price, ?stock - ?price, ?stock), ?stock)
    ?workshop potions if(?near, if(?stock >= ?price, ?potions + 1.0, ?potions), ?potions)
    ?workshop shop-status if(?near, if(?stock >= ?price, "Health potion purchased. Press H to drink when hurt.", "Not enough supplies for a health potion."), "You are too far from Mara. Move closer to buy.")

on drink-potion ?workshop
  when
    ?workshop connected true
    torso part-health ?health
    torso max-part-health ?maximum
    ?health > 0.0
    ?workshop potions ?potions
    ?workshop shop-status ?status
    mara potion-healing ?healing
    (?health + ?healing) bounded by 0.0 and ?maximum as ?healed
  withdraw
    torso part-health ?health
    ?workshop potions ?potions
    ?workshop shop-status ?status
  include
    torso part-health if(?potions >= 1.0, if(?health < ?maximum, ?healed, ?health), ?health)
    ?workshop potions if(?potions >= 1.0, if(?health < ?maximum, ?potions - 1.0, ?potions), ?potions)
    ?workshop shop-status if(?health >= ?maximum, "Your health is already full. Potion kept.", if(?potions >= 1.0, "You drink a health potion and recover health.", "No health potions. Visit Mara in Hearthstead."))
