law anatomical-attachment
  if
    ?component:
      attached-to: ?part
      accepted-kind: ?kind
    ?part:
      part-kind: ?kind
      part-owner: ?creature
  then
    ?component mounted true
derive anatomical-attachment

law free-compatible-slot
  if
    workshop phase ?phase
    if(?phase = "Workshop", true, ?phase = "Returned") = true
    ?component accepted-kind ?kind
    ?part:
      part-kind: ?kind
      slot-capacity: ?slots
    sum 1.0 given ?part ?component where { ?other attached-to ?part; ?other != ?component } as ?occupied
    ?occupied < ?slots
  then
    ?component available-fit ?part
derive free-compatible-slot

law living-condition
  if
    ?creature baseline-speed ?speed
    sum ?health given ?creature where { ?part part-owner ?creature; ?part part-health ?health } as ?health
    sum ?maximum given ?creature where { ?part part-owner ?creature; ?part max-part-health ?maximum } as ?maximum
    ?maximum > 0.0
  then
    ?creature creature-condition 100.0 * ?health / ?maximum
derive living-condition

law live-source
  if
    ?component:
      mounted: true
      health: ?health
    ?health > 0.0
    ?component generation ?generation
    ?generation > 0.0
  then
    ?component powered true
derive live-source

law live-connection
  if
    ?component:
      mounted: true
      health: ?health
    ?health > 0.0
    ?component:
      linked: true
      upstream: ?upstream
    ?upstream powered true
  then
    ?component powered true
derive live-connection

law component-capacity
  if
    ?workshop phase ?phase
    sum ?mass where { ?component mounted true; ?component mass ?mass } as ?mass
    sum ?generation where { ?component powered true; ?component generation ?generation } as ?power
    sum (?thrust * ?health / ?maximum) where { ?component powered true; ?component thrust ?thrust; ?component attached-to ?part; ?part part-health ?health; ?part max-part-health ?maximum } as ?drive
    sum (?firepower * ?health / ?maximum) where { ?component powered true; ?component firepower ?firepower; ?component attached-to ?part; ?part part-health ?health; ?part max-part-health ?maximum } as ?weapon
    sum ?cooling where { ?component powered true; ?component cooling ?cooling } as ?cooling
    sum ?draw where { ?component powered true; ?component thrust ?thrust; ?thrust > 0.0; ?component draw ?draw } as ?drive-draw
    sum ?draw where { ?component powered true; ?component firepower ?firepower; ?firepower > 0.0; ?component draw ?draw } as ?weapon-draw
    sum ?draw where { ?component powered true; ?component cooling ?cooling; ?cooling > 0.0; ?component draw ?draw } as ?cooling-draw
  then
    ?workshop:
      capacity:
        mass: ?mass
        power: ?power
        drive: if(?power >= ?drive-draw, ?drive, 0.0)
        weapon: if(?power >= ?weapon-draw, ?weapon, 0.0)
        cooling: if(?power >= ?cooling-draw, ?cooling, 0.0)
        drive-draw: ?drive-draw
        weapon-draw: ?weapon-draw
        cooling-draw: ?cooling-draw
derive component-capacity

bounded:
  (shape: F64):
    ?value ?low ?high ?result
  ?value bounded by ?low and ?high as ?result
mode bounded given value low high yields result: maybe
law bound
  if
    ?low <= ?high
  then
    ?value bounded by ?low and ?high as if(?value < ?low, ?low, if(?value > ?high, ?high, ?value))
derive bound

