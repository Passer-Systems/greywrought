  domain: Workshop
  range: F64
  cardinality: one

workshop
  presence: 0.0
  party-size: 1.0
  connected: true
  resource-remaining: 12.0
  ritual-called: false
  carried-relics: 0.0
  banked-relics: 0.0
  action-cooldown: 0.0
  guard-remaining: 0.0

journey-vitality
  domain: Workshop
  range: F64
  cardinality: maybe
law journey-vitality
  if
    workshop phase ?phase
    torso part-health ?health
  then
    workshop journey-vitality ?health
derive journey-vitality

bind keyboard AdvanceForest down to advance-forest
bind keyboard RetreatForest down to retreat-forest
bind keyboard GatherResource down to gather-resource
bind keyboard ExtractExpedition down to extract-expedition
bind scalar-input PartySize to choose-party-size
bind keyboard ConnectionLost down to connection-lost
bind keyboard ConnectionRestored down to connection-restored

on choose-party-size ?workshop ?size
  when
    ?workshop phase ?phase
    if(?phase = "Workshop", true, ?phase = "Returned") = true
    ?workshop party-size ?prior
    if(?size = 1.0, true, if(?size = 2.0, true, if(?size = 3.0, true, ?size = 4.0))) = true
  withdraw
    ?workshop party-size ?prior
  include
    ?workshop party-size ?size

on connection-lost ?workshop
  when
    ?workshop connected true
  withdraw
    ?workshop connected true
  include
    ?workshop connected false
on connection-restored ?workshop
  when
    ?workshop connected false
  withdraw
    ?workshop connected false
  include
    ?workshop connected true

on launch-expedition ?workshop
  when
    ?workshop phase ?phase
    if(?phase = "Workshop", true, ?phase = "Returned") = true
    ?workshop connected true
    torso part-health ?health
    ?health > 0.0
    ?workshop position ?position
    ?workshop cargo ?cargo
    ?workshop presence ?presence
    ?workshop report ?report
    ?workshop resource-remaining ?resource
    ?workshop ritual-called ?called
    ?workshop carried-relics ?relics
  withdraw
    ?workshop phase ?phase
    ?workshop position ?position
    ?workshop cargo ?cargo
    ?workshop presence ?presence
    ?workshop report ?report
    ?workshop resource-remaining ?resource
    ?workshop ritual-called ?called
    ?workshop carried-relics ?relics
  include
    ?workshop phase "Expedition"
    ?workshop position 0.0
    ?workshop cargo 0.0
    ?workshop presence 0.0
    ?workshop report "The forest is listening. Frost cores wait at the deep grove; Hearthstead lies behind you."
    ?workshop resource-remaining 12.0
    ?workshop ritual-called false
    ?workshop carried-relics 0.0

on advance-forest ?workshop
  when
    ?workshop phase "Expedition"
    ?workshop connected true
    torso part-health ?health
    ?health > 0.0
    ?workshop position ?position
    ?position < 4.0
    nest enemy-health ?nest
    ?workshop capacity Capacity { mass: ?mass, power: ?power, drive: ?drive, weapon: ?weapon, cooling: ?cooling, drive-draw: ?drive-draw, weapon-draw: ?weapon-draw, cooling-draw: ?cooling-draw }
    ?workshop party-size ?party
    ?workshop action-cooldown ?cooldown
    ?cooldown <= 0.0
  withdraw
    ?workshop position ?position
    ?workshop action-cooldown ?cooldown
  include
    ?workshop position if(?position = 2.0, if(?nest <= 0.0, 4.0, 3.0), ?position + 1.0)
    ?workshop action-cooldown 1.0 / (1.0 + ?drive / (28.0 + ?mass))
  accumulate
    ?workshop presence 2.0 + 0.2 * (?party - 1.0)

on retreat-forest ?workshop
  when
    ?workshop phase "Expedition"
    ?workshop connected true
    torso part-health ?health
    ?health > 0.0
    ?workshop position ?position
    ?position > 0.0
    nest enemy-health ?nest
    ?workshop party-size ?party
    ?workshop action-cooldown ?cooldown
    ?cooldown <= 0.0
  withdraw
    ?workshop position ?position
    ?workshop action-cooldown ?cooldown
  include
    ?workshop position if(?position = 4.0, if(?nest <= 0.0, 2.0, 3.0), ?position - 1.0)
    ?workshop action-cooldown 1.0
  accumulate
    ?workshop presence 1.0 + 0.1 * (?party - 1.0)

on gather-resource ?workshop
  when
    ?workshop phase "Expedition"
    ?workshop connected true
    torso part-health ?health
    ?health > 0.0
    ?workshop position 4.0
    ?workshop resource-remaining ?remaining
    ?remaining >= 3.0
    ?workshop action-cooldown ?cooldown
    ?cooldown <= 0.0
    ?workshop report ?report
  withdraw
    ?workshop resource-remaining ?remaining
    ?workshop action-cooldown ?cooldown
    ?workshop report ?report
  include
    ?workshop resource-remaining ?remaining - 3.0
    ?workshop action-cooldown 2.0
    ?workshop report "Three frost cores gathered. They are yours only if you return alive."
  accumulate
    ?workshop cargo 3.0
    ?workshop presence 4.0

on extract-expedition ?workshop
  when
    ?workshop phase "Expedition"
    ?workshop connected true
    torso part-health ?health
    ?health > 0.0
    ?workshop position 0.0
    ?workshop cargo ?cargo
    ?workshop carried-relics ?carried
    ?workshop report ?report
  withdraw
    ?workshop phase "Expedition"
    ?workshop cargo ?cargo
    ?workshop carried-relics ?carried
    ?workshop report ?report
  include
    ?workshop phase "Returned"
    ?workshop cargo 0.0
    ?workshop carried-relics 0.0
    ?workshop report "Safe at Hearthstead. Extracted cores and relics are secured."
  accumulate
    ?workshop stock ?cargo
    ?workshop banked-relics ?carried

on tick ?workshop ?dt
  when
    ?workshop phase "Expedition"
    ?workshop connected true
    torso part-health ?health
    ?health > 0.0
  accumulate
    ?workshop presence 0.1 * ?dt
on tick ?workshop ?dt
  when
    ?workshop connected true
    ?workshop action-cooldown ?cooldown
    ?cooldown > 0.0
  withdraw
    ?workshop action-cooldown ?cooldown
  include
    ?workshop action-cooldown if(?cooldown > ?dt, ?cooldown - ?dt, 0.0)

on tick ?workshop ?dt
  when
    ?workshop:
      phase: ?phase
      total-mass: ?old-mass
      available-power: ?old-power
      drive-power: ?old-drive
      weapon-power: ?old-weapon
      cooling-power: ?old-cooling
      capacity:
        mass: ?mass
        power: ?power
        drive: ?drive
        weapon: ?weapon
        cooling: ?cooling
        drive-draw: ?drive-draw
        weapon-draw: ?weapon-draw
        cooling-draw: ?cooling-draw
  withdraw
    ?workshop:
      total-mass: ?old-mass
      available-power: ?old-power
      drive-power: ?old-drive
      weapon-power: ?old-weapon
      cooling-power: ?old-cooling
  include
    ?workshop:
      total-mass: ?mass
      available-power: ?power
      drive-power: ?drive
      weapon-power: ?weapon
      cooling-power: ?cooling


